{
  "name": "@school-kit/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "backfill-paystack-splits": "dotenv -e ../../.env -- tsx scripts/backfill-paystack-splits.ts",
    "backfill-invoice-arms": "dotenv -e ../../.env -- tsx scripts/backfill-invoice-arms.ts",
    "set-staff-mobile": "dotenv -e ../../.env -- tsx scripts/set-staff-mobile.ts",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@school-kit/ai": "workspace:^",
    "@school-kit/db": "workspace:*",
    "@school-kit/types": "workspace:*",
    "@sentry/nestjs": "^10.76.2",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "csv-parse": "^6.2.1",
    "exceljs": "4.4.0",
    "ioredis": "^5.11.1",
    "otplib": "^13.5.0",
    "pdfjs-dist": "4.10.38",
    "posthog-node": "5.55.1",
    "puppeteer": "^25.13.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.1",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@school-kit/config": "workspace:*",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.8"
  }
}
