{
  "name": "@school-kit/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "assets": "node scripts/generate-assets.mjs",
    "build": "echo 'apps/mobile has no bundler build step — turbo run build is a no-op here; real builds are eas build, see build:* scripts and docs/runbooks/mobile-eas-setup.md'",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform all",
    "build:web": "expo export --platform web",
    "eas-build-post-install": "pnpm --filter \"@school-kit/mobile^...\" build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/metro-runtime": "~57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@school-kit/types": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@school-kit/config": "workspace:*",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.7",
    "eas-cli": "^22.0.0",
    "eslint": "^9",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "expo": {
    "install": {
      "//": [
        "typescript: Expo SDK 57 wants TypeScript ~6.0.3; this workspace is on",
        "5.9.3 because the ENTIRE monorepo pins typescript ^5.6.3 (root, api,",
        "web, portal, db, types, ui, e2e). Moving to TS 6 is a repo-wide",
        "upgrade with a blast radius covering every workspace and both",
        "tsconfig presets — deliberately out of scope for Phase 6 slice 1,",
        "which is a mobile change. Excluded here so `expo-doctor` reports the",
        "project's real state (21/21) instead of a standing red that trains",
        "people to ignore it. Typecheck passes on 5.9.3 against SDK 57;",
        "verified 2026-08-15. Revisit when the repo upgrades TypeScript."
      ],
      "exclude": [
        "typescript"
      ]
    }
  }
}
