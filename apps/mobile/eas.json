{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://school-kit-api.fly.dev/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://app.schoolkit.ng"
      }
    },
    "smoke": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://bs-local.com:4000/api/v1",
        "SMOKE_CLEARTEXT": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://school-kit-api.fly.dev/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://app.schoolkit.ng"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
