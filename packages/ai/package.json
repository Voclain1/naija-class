{
  "name": "@school-kit/ai",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'lint placeholder'",
    "test": "echo 'test placeholder'",
    "eval": "tsx evals/run.ts",
    "eval:registers": "tsx evals/register-scans/run.ts",
    "clean": "rm -rf dist",
    "help-index": "tsx scripts/generate-help-index.ts"
  },
  "devDependencies": {
    "@school-kit/config": "workspace:*",
    "@types/node": "^22.20.5",
    "github-slugger": "2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  }
}
