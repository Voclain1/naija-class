  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  branches            Branch[]
  users               User[]
  invitations         Invitation[]
  passwordResetTokens PasswordResetToken[]

  guardianPasswordResetTokens GuardianPasswordResetToken[]

  admissionNumberCounters AdmissionNumberCounter[]
  reportExports           ReportExport[]
  previousAddresses       SchoolPreviousAddress[]

  @@map("schools")
}

// A school's earlier web addresses (docs/modules/school-addresses.md,
// 2026-10-22). When a school changes its address (schools.slug, the
// "<code>.schoolkit.ng" part and the school code students type), the old one
// moves here and keeps working forever: printed PIN cards, shared admission
// links, remembered sign-in codes and exam packs all resolve through it. An
// old code is never given to another school (unique here, and triggers keep it
// apart from every school's current code), so nobody can pose as a school at
// an address its families already know.
//
// Readable by everyone (codes are public, like schools.slug); written only
// under the school's own GUC. RLS in policies/school-addresses.sql.
model SchoolPreviousAddress {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  slug              String   @unique
  retiredAt         DateTime @default(now()) @map("retired_at")
  retiredBy         String?  @map("retired_by") // user id; null when SchoolKit changed it
  // False for changes made in the free window (first 30 days, or still
  // onboarding) and for changes made by SchoolKit; true when the change used
  // one of the school's yearly allowance.
  countsTowardLimit Boolean  @default(false) @map("counts_toward_limit")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, retiredAt])
  @@map("school_previous_addresses")
}

enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Branch {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("branches")
}

// ---------- Identity ----------

model User {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  email             String?   @unique
  phone             String?   @unique
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  passwordHash      String?   @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  // Platform super-admin flag (added for the internal, read-only cross-
  // tenant admin surface — see CLAUDE.md's SECURITY DEFINER inventory,
  // platform_admin_* functions). Granted ONLY via a direct DB UPDATE — no
  // self-serve UI, no invite flow. Checked fresh from the DB on every
  // platform-admin request (PlatformAdminGuard), never trusted from a
  // token/session payload, same discipline as `isActive` above.
  isPlatformAdmin   Boolean   @default(false) @map("is_platform_admin")
  emailVerified     Boolean   @default(false) @map("email_verified")
  phoneVerified     Boolean   @default(false) @map("phone_verified")
  lastLoginAt       DateTime? @map("last_login_at")
  // 2026-10-19 — an uploaded passport photo exists (storage key staff-photo).
  photoUploadedAt   DateTime? @map("photo_uploaded_at")
  totpPendingSecret String?   @map("totp_pending_secret")
  totpSecret        String?   @map("totp_secret")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")

  // First-login product tour (owner/admin shell). Null until the user
  // finishes or skips it; either action stamps "now" — there is no
  // separate "skipped" state, since the tour never reappears automatically
  // either way. A "Replay tour" affordance re-shows it without touching
  // this column (replay is a local UI action, not a state reset).
  tourCompletedAt DateTime? @map("tour_completed_at")

  // Phase 3 / Slice 12 — encrypted BVN (Bank Verification Number), staff/
  // payroll PII, not student/guardian data. bvnEncrypted is pgcrypto
  // ciphertext, only ever produced/consumed via the encrypt_bvn/decrypt_bvn
  // SECURITY DEFINER functions. bvnLast4 is plaintext (safe in isolation) for
  // masked display without invoking decryption. See CLAUDE.md "SECURITY
  // DEFINER functions — index" and docs/modules/phase-3.md §7.
  bvnEncrypted Bytes?  @map("bvn_encrypted")
  bvnLast4     String? @map("bvn_last4")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Phase 1 / Slice 3 — back-relation to ClassArm.classTeacherId (the form
  // teacher). Named relation to disambiguate from the slice-11 teacher-
  // subject assignment edge below — both are User-to-teaching relations and
  // Prisma needs explicit names once a model has more than one relation set.
  classTeacherArms ClassArm[] @relation("ClassTeacherArms")

  // Phase 1 / Slice 10 — 1:1 HR profile for users who hold the teacher role.
  // Optional because most users (owner, admin) never get one, and a teacher
  // exists as a User the moment they accept their invitation; the profile is
  // created explicitly by an admin afterwards (Q2 lifecycle, locked
  // 2026-05-30 — no auto-create on accept).
  teacherProfile TeacherProfile?

  // Phase 1 / Slice 11 — subject-teaching assignments (this user teaches a
  // subject in a class arm for a year/term). Distinct from classTeacherArms
  // above: a form teacher owns the arm's register; a subject teacher teaches
  // one subject to it. The named relation pairs with TeacherAssignment.teacher.
  teacherAssignments TeacherAssignment[] @relation("TeacherSubjectAssignments")

  timetableTeaching TimetableEntryTeacher[] // Phase 8 / CP3 — composite (school_id, id) FK target.

  deviceTokens DeviceToken[] // Notifications v1 (N2) — this staff member's phones.

  libraryLoans LibraryLoan[] // Phase 9 / CP6.1 — books this member of staff has borrowed.

  hostelHouseMasters HostelHouseMaster[] // Phase 9 / CP6b.1 — hostels this member of staff is house master of.

  @@unique([schoolId, id]) // Phase 8 / CP3 — composite FK target (§17 D29)
  @@index([schoolId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  schoolId    String?  @map("school_id") // null = system role (seeded)
  key         String // 'owner', 'admin', 'teacher', etc.
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("[]") // string[] of permission keys, or ["*"]
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  tokenHash  String            @unique @map("token_hash")
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  clientType SessionClientType @default(WEB) @map("client_type")
  deviceId   String?           @map("device_id")
  deviceName String?           @map("device_name")
  lastSeenAt DateTime          @default(now()) @map("last_seen_at")
  expiresAt  DateTime          @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, clientType])
  @@map("sessions")
}

enum SessionClientType {
  WEB
  MOBILE
}

model Invitation {
  id                  String    @id @default(uuid())
  schoolId            String    @map("school_id")
  email               String?
  phone               String?
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  roleKey             String    @map("role_key")
  tokenHash           String    @unique @map("token_hash")
  invitedBy           String    @map("invited_by")
  expiresAt           DateTime  @map("expires_at")
  acceptedAt          DateTime? @map("accepted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  // Kobo. A monthly salary typed on the invite form, moved into
  // staff_salaries when the person accepts (migration 20261112120000).
  pendingMonthlyGross Int?      @map("pending_monthly_gross")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("invitations")
}

// Phase 0 gap closed 2026-07-24 — forgot/reset password flow. Spec'd in
// docs/modules/phase-0.md (`POST /auth/forgot-password`, `POST /auth/
// reset-password`, `/forgot-password`, `/reset-password/[token]`) but never
// implemented; built now. Structurally mirrors Invitation (schoolId +
// unique tokenHash + expiresAt + a nullable "consumed" timestamp, resolved
// pre-tenant via a SECURITY DEFINER function — see the migration's own
// header comment) rather than reusing Invitation itself: this token targets
// an EXISTING User (hence the userId FK Invitation doesn't have), not a
// not-yet-created one, and carries none of Invitation's invite-time fields
// (email/phone/names/roleKey/invitedBy). `usedAt` (not `acceptedAt`) because
// "used" reads more accurately for a reset token than "accepted".
model PasswordResetToken {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @default(uuid())
  schoolId   String?  @map("school_id")
  userId     String?  @map("user_id")
  action     String // e.g. 'school.update', 'user.invite', 'academic-year.create'
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Composite PK required by PostgreSQL: all unique constraints on a
  // partitioned table must include every partition key column.
  // audit_logs is partitioned by created_at, so the PK is (id, created_at).
  // Nothing FK-references audit_logs.id, so this change is safe.
  // The PK keeps the name the partitioning migration gave it.
  @@id([id, createdAt], map: "audit_logs_new_pkey")
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ---------- Phase 1 / Slice 1 — Academic structure (year + term) ----------
//
// First Phase 1 slice. Two tables, both school-scoped, both under FORCE RLS.
// "Current year" / "current term" is modelled as an isCurrent flag enforced
// by partial unique indexes (added in the migration's raw SQL because
// Prisma's @@unique cannot express WHERE clauses). The service layer
// cascades setCurrentTerm → academic_year.is_current; that invariant is the
// only one the DB does not enforce, and the terms.service spec asserts it.

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  label     String // e.g. "2025/2026" — unique per school
  startDate DateTime @map("start_date") @db.Date // calendar dates, not moments — see CLAUDE.md
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  terms              Term[]
  enrollments        Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation.
  timetables         Timetable[] // Phase 8 / CP3 — composite (school_id, id) FK target.

  @@unique([schoolId, id]) // Phase 8 / CP3 — composite FK target (§17 D29)
  @@unique([schoolId, label])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  sequence       Int // 1 | 2 | 3 — unique within a year
  name           String // "First Term", "Second Term", "Third Term"
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments           Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments    TeacherAssignment[] // Phase 1 / Slice 11 back-relation (term-specific assignments).
  timetables            Timetable[] // Phase 8 / CP3 — composite (school_id, id) FK target.
  timetablePublications TimetablePublication[] // Phase 8 / CP4 — published snapshots (D45).
  examPapers            ExamPaper[] // Phase 8c / CP5c back-relation.
  subjectHides          SubjectHide[] // 2026-11-02

  @@unique([schoolId, id]) // Phase 8 / CP3 — composite FK target (§17 D29)
  @@unique([academicYearId, sequence])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
  @@map("terms")
}

// ---------- Phase 1 / Slice 2 — Class levels ----------
//
// Hybrid model: every new school is auto-seeded with the 14 standard Nigerian
// levels (KG 1/2, Primary 1–6, JSS 1–3, SSS 1–3) inside the signup
// transaction (see apps/api/src/modules/auth/auth.service.ts → signupOwner).
// Schools can then add custom levels, edit names, or toggle isActive.
//
// `code` is the stable per-school identifier (matching the seed) and backs
// the uniqueness constraint; `name` is the human-facing label and can be
// renamed freely. `orderIndex` drives sort order in the UI; duplicates are
// tolerated for schools that interleave custom levels (sort tie-breaks on
// name ASC). No partial unique index here — there is no "current level"
// concept; the current academic year/term carries that semantic.

model ClassLevel {
  id         String     @id @default(uuid())
  schoolId   String     @map("school_id")
  name       String // "KG 1", "Primary 4" — human-facing; renamable
  code       String // "kg1", "pri4" — stable per-school identifier (unique)
  stage      ClassStage // NURSERY | PRIMARY | JSS | SSS — coarse grouping
  orderIndex Int        @map("order_index") // sort order; seeded 1..14
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Phase 1 / Slice 3 back-relations.
  arms          ClassArm[]
  classSubjects ClassSubject[]
  lessonPlans   LessonPlan[] // Phase 5 / Slice 2 back-relation.
  questions     Question[] // Phase 8c / CP5b back-relation.
  examPapers    ExamPaper[] // Phase 8c / CP5c back-relation.

  libraryBookLevels     LibraryBookLevel[] // Phase 9 / CP6.1
  libraryResourceLevels LibraryResourceLevel[] // Phase 9 / CP6.3
  admissionApplications AdmissionApplication[] // Phase 9 / CP7.1

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, orderIndex])
  @@map("class_levels")
}

enum ClassStage {
  NURSERY
  KG // 2026-11-02: KG and Nursery teach different subjects
  PRIMARY
  JSS
  SSS
}

// ---------- Phase 1 / Slice 3 — Class arms, subjects, class-subjects ----------
//
// Three models that complete the academic skeleton. ClassArm is the section
// under a ClassLevel ("JSS 1A", "JSS 1B"); Subject is the school-wide subject
// catalog; ClassSubject is the explicit many-to-many between ClassLevel and
// Subject (curriculum lives at the level, not the arm — all arms of JSS 1
// take the same set of subjects). All three carry their own school_id for
// direct-RLS isolation, matching the slice 1+2 pattern.
//
// classTeacherId on ClassArm references users.id (not teacher_profiles.id —
// that table arrives in slice 10). The dropdown stays empty until teachers
// have accepted invitations; the UI surfaces an "Invite a teacher" CTA per
// the spec risk note (docs/modules/phase-1.md → Risks and gotchas).

model ClassArm {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  classLevelId   String   @map("class_level_id")
  name           String // "JSS 1A" — human-facing; renamable
  code           String // "jss1-a" — stable per-(school, level) identifier
  capacity       Int? // optional max headcount
  classTeacherId String?  @map("class_teacher_id") // FK → users.id (form teacher)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  classLevel            ClassLevel             @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classTeacher          User?                  @relation("ClassTeacherArms", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments    TeacherAssignment[] // Phase 1 / Slice 11 back-relation (subject teachers of this arm).
  timetables            Timetable[] // Phase 8 / CP3 — composite (school_id, id) FK target.
  timetablePublications TimetablePublication[] // Phase 8 / CP4 — published snapshots (D45).

  cbtSittingArms CbtSittingArm[] // Online exams (CBT1)
  cbtCandidates  CbtCandidate[]

  @@unique([schoolId, id]) // Phase 8 / CP3 — composite FK target (§17 D29)
  @@unique([schoolId, classLevelId, code])
  @@index([schoolId])
  @@index([classTeacherId])
  @@map("class_arms")
}

model Subject {
  id        String          @id @default(uuid())
  schoolId  String          @map("school_id")
  name      String // "Mathematics" — human-facing; renamable
  code      String // "math" — stable per-school identifier (unique)
  category  SubjectCategory @default(CORE)
  /// The stages this subject is taught in (2026-11-02,
  /// docs/modules/subjects-by-class.md). A class's subjects are the active
  /// subjects tagged with its stage; empty means not offered at any stage yet.
  stages    ClassStage[]    @default([])
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation.
  lessonPlans        LessonPlan[] // Phase 5 / Slice 2 back-relation.
  questions          Question[] // Phase 8c / CP5b back-relation.
  examPapers         ExamPaper[] // Phase 8c / CP5c back-relation.
  timetableEntries   TimetableEntry[] // Phase 8 / CP3 — composite (school_id, id) FK target.

  libraryBooks     LibraryBook[] // Phase 9 / CP6.1
  libraryResources LibraryResource[] // Phase 9 / CP6.3
  hides            SubjectHide[] // 2026-11-02

  @@unique([schoolId, id]) // Phase 8 / CP3 — composite FK target (§17 D29)
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

enum SubjectCategory {
  CORE
  ELECTIVE
  VOCATIONAL
}

// Explicit join between ClassLevel and Subject. Explicit (not Prisma's
// implicit m-n) because we need our own school_id column for direct-RLS and
// our own `isCore` payload (curriculum metadata: e.g. Maths is core in JSS
// but may be elective in some SSS streams). No updatedAt — link membership
// is binary; toggling isCore is a single UPDATE without history.

model ClassSubject {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  classLevelId String   @map("class_level_id")
  subjectId    String   @map("subject_id")
  isCore       Boolean  @default(true) @map("is_core")
  createdAt    DateTime @default(now()) @map("created_at")

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classLevelId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ---------- Phase 1 / Slice 4 — Students ----------
//
// First slice to model actual people. Student is the roster spine: CSV import
// (slices 6-8) and Enrollment (slice 9) both build on this table. The model is
// stripped of every relation that points at models that do not exist yet —
// StudentGuardian (slice 5), Enrollment (slice 9), MasteryRecord +
// AIInteractionLog (slice 12) — those back-relations are added by their own
// slices to keep this one purely additive.
//
// Class membership is intentionally NOT on Student. The spec locks per-term
// Enrollment as the only source of truth (docs/modules/phase-1.md → "Enrollment
// is per-TERM, not per-academic-year"); a denormalised currentClassArmId here
// would drift on every term boundary and break the join shape Phase 2 is built
// around.
//
// dateOfBirth uses @db.Date per CLAUDE.md's "calendar date vs moment" rule
// (also explicitly named in that rule). The spec text shows plain `DateTime`
// — that's a pre-convention oversight from before slice 1 locked the
// convention, reconciled in this slice's docs edit. Plain DateTime is kept
// for admittedAt/withdrawnAt/graduatedAt: those are events (when the
// transition happened), not calendar dates.
//
// admissionNumber is free-text required-unique-per-school (no auto-format,
// no school-configurable scheme in Phase 1 — deferred). The unique constraint
// is the ordinary @@unique form, not a partial index, since there's no
// "current" semantic on Student.

model Student {
  messageThreads  MessageThread[] // CP8.1
  id              String          @id @default(uuid())
  schoolId        String          @map("school_id")
  admissionNumber String          @map("admission_number") // free-text, unique per school
  firstName       String          @map("first_name")
  middleName      String?         @map("middle_name")
  lastName        String          @map("last_name")
  dateOfBirth     DateTime        @map("date_of_birth") @db.Date // calendar date — see CLAUDE.md
  gender          Gender
  photoUrl        String?         @map("photo_url") // string only; upload UI deferred (Phase 2/4)
  // 2026-10-19 — an uploaded passport photo exists (storage key student-photo).
  photoUploadedAt DateTime?       @map("photo_uploaded_at")
  address         String?
  phone           String?
  email           String?
  // blood_group and medical_notes moved into HealthProfile (Phase 9 / CP3.1,
  // docs/modules/phase-9.md §10 CP3-D4): health data is read by a narrower set
  // of people than the rest of the student record, and audited on every read.
  religion        String?
  stateOfOrigin   String?         @map("state_of_origin")
  nationality     String          @default("Nigerian")
  status          StudentStatus   @default(ACTIVE)

  // ---- Smart Student Import — extraction provenance (2026-08-20) --------
  // TRUE when this row's field values originated from a camera-captured
  // register transcribed by the model, rather than being typed by a human or
  // parsed from a CSV the school produced.
  //
  // Added at the same time as the feature, deliberately, on D15's reasoning:
  // "was this AI-drafted or human-written?" is a question you cannot
  // retrofit an answer to. Once a term of scanned intakes exists, no
  // migration can tell those rows apart from hand-typed ones.
  //
  // NOT a trust signal and nothing branches on it — every scanned row was
  // reviewed and confirmed by an admin before it was written (D4), so a
  // scanned row is exactly as authoritative as a typed one. It exists so
  // that if a systematic extraction defect is ever found (a prompt version
  // that mis-read a date format, say), the affected population is
  // identifiable instead of hypothetical.
  //
  // Non-nullable with a FALSE default rather than nullable: every existing
  // student was demonstrably not scanned, so there is no "unknown" state to
  // represent and a nullable column would invite one.
  aiExtracted Boolean @default(false) @map("ai_extracted")

  // ---- Phase 6 / Slice 3 — student portal auth (D18, D26) --------------
  // Credentials live on Student rather than a companion table, mirroring
  // Decision A of the guardian build (guardians carry their own auth
  // columns) and User itself, which blends profile and auth in one row.
  //
  // All nullable, so there is NO backfill: every pre-Phase-6 student is
  // correctly represented as "never activated, never logged in".
  //
  // Portal state is DERIVED from these two columns, not stored (D25) —
  // a third column would be a second, divergeable copy of something
  // audit_logs already records:
  //   never activated  -> activatedAt NULL, passwordHash NULL
  //   active           -> activatedAt set,  passwordHash set
  //   deactivated      -> activatedAt set,  passwordHash NULL
  //
  // Deliberately NOT added: an emailVerified equivalent. A guardian's
  // identifier is an email and needs verifying; a student's is an
  // admission number issued by the school. A column that is always false
  // invites someone to build a flow around it.
  passwordHash String?   @map("password_hash")
  activatedAt  DateTime? @map("activated_at") // event moment — first accept
  lastLoginAt  DateTime? @map("last_login_at") // event moment

  admittedAt  DateTime  @default(now()) @map("admitted_at") // event moment
  withdrawnAt DateTime? @map("withdrawn_at") // event moment
  graduatedAt DateTime? @map("graduated_at") // event moment
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Slice 5 adds the StudentGuardian back-relation; slice 9 adds Enrollment;
  // slice 12 adds the two AI-foundation back-relations (tables sit empty in
  // Phase 1 — shape owned by Phase 5).
  guardians         StudentGuardian[]
  enrollments       Enrollment[] // Phase 1 / Slice 9 back-relation.
  masteryRecords    MasteryRecord[] // Phase 1 / Slice 12 back-relation.
  aiInteractionLogs AIInteractionLog[] // Phase 1 / Slice 12 back-relation.
  parentSummaries   ParentSummary[] // Phase 5 / Slice 5 back-relation.
  sessions          StudentSession[] // Phase 6 / Slice 3.
  portalInvitations StudentPortalInvitation[] // Phase 6 / Slice 3.
  deviceTokens      DeviceToken[] // Phase 6 / Slice 5.

  cbtCandidates         CbtCandidate[] // Online exams (CBT1)
  healthProfile         HealthProfile? // Phase 9 / CP3.1
  vaccinations          HealthVaccination[] // Phase 9 / CP3.2
  sickbayVisits         SickbayVisit[] // Phase 9 / CP3.3
  assignmentSubmissions AssignmentSubmission[] // Phase 9 / CP4
  assignmentFiles       AssignmentSubmissionFile[] // Phase 9 / CP4.2
  transportAssignments  TransportAssignment[] // Phase 9 / CP5.2
  libraryLoans          LibraryLoan[] // Phase 9 / CP6.1
  hostelBeds            HostelBed[] // Phase 9 / CP6b.1
  hostelVisits          HostelVisit[] // Phase 9 / CP6b.2
  hostelExeats          HostelExeat[] // Phase 9 / CP6b.3
  admissionApplications AdmissionApplication[] // Phase 9 / CP7 (set when admitted)

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName]) // sorted roster scans
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Plans (2026-10-11, docs/modules/plans.md). The published plans on the
// marketing site; caps live in PLAN_STUDENT_CAPS (@school-kit/types).
enum SchoolPlan {
  FREE
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

// The school's own SMS sender name (docs/modules/school-identity.md slice 2).
enum SmsSenderStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  GRADUATED
  SUSPENDED
}

// ---------- Phase 6 / Slice 3 — student portal auth ----------
//
// A student is the THIRD authenticated principal (staff User, Guardian,
// Student). It is deliberately modelled on Guardian, not on User: a student
// has no role and no permissions (D17), because staff RBAC exists to answer
// "which of many things may this person touch?" and a student has exactly
// one answer — their own rows.

// Mirrors GuardianSession exactly, including the ABSENCE of a school_id
// column: tenancy is resolved by joining through students.school_id, the
// same shape guardian_sessions uses through guardians and `sessions` uses
// through users. Consistency with BOTH existing session tables beats saving
// a join — a third session table with a third tenancy shape would leave the
// next reader guessing which one is correct.
model StudentSession {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_sessions")
}

// Phase 6 / Slice 3 (D26) — the single-use token a GUARDIAN issues so their
// child can set a password.
//
// WHY A TOKEN AND NOT "the guardian types a password for the child":
// deactivation has to be a real revocation. If the child holds anything
// replayable — a link, a code, a screenshot of one — then an "off" switch
// that only clears the password and kills sessions is a FALSE SAFETY
// CONTROL: it tells a parent access is revoked when it is not. So the thing
// the child holds is single-use, and deactivation burns it.
//
// Differences from GuardianInvitation, each deliberate:
//   - revokedAt exists here as the mechanism DEACTIVATION uses, so it must be
//     storable. (GuardianInvitation had no revoke path at all until
//     2026-09-16; it now has the column too, for admin revoke/resend — the
//     difference is what stamps it, not whether it exists.)
//   - issuedBy is a GUARDIAN id, not a staff User id. A parent invites their
//     own child; school staff are not involved.
//   - No name/email/phone copies. Like GuardianInvitation (and unlike the
//     staff `invitations` table) the subject row already exists, so this
//     table carries only invitation-specific fields.
//
// At most ONE live token per student: issuing a new invitation revokes any
// outstanding one, enforced in the service rather than by a partial unique
// index, because "live" is a three-column predicate (accepted_at IS NULL AND
// revoked_at IS NULL AND expires_at > now()) and now() is not immutable.
enum StudentPortalInvitationPurpose {
  ACTIVATION
  PASSWORD_RESET
}

model StudentPortalInvitation {
  id         String                         @id @default(uuid())
  schoolId   String                         @map("school_id") // denormalised for direct RLS
  studentId  String                         @map("student_id")
  tokenHash  String                         @unique @map("token_hash")
  issuedBy   String                         @map("issued_by") // guardianId — plain scoping column
  purpose    StudentPortalInvitationPurpose @default(ACTIVATION)
  expiresAt  DateTime                       @map("expires_at")
  acceptedAt DateTime?                      @map("accepted_at") // stamped on use — single-use
  revokedAt  DateTime?                      @map("revoked_at") // stamped by deactivation (D26)
  createdAt  DateTime                       @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("student_portal_invitations")
}

// ---------- Phase 1 / Slice 5 — Guardians + student-guardian links ----------
//
// Guardian is a school-scoped person record (parent, sibling, NOK, etc.).
// Phase 1 is admin-managed: owners and admins create / edit / link / unlink.
// Parent AUTH and the parent-facing app are Phase 4 — guardians cannot log in
// yet, so there is no User row paired with a Guardian here.
//
// Two design choices worth flagging:
//
//   1. NO unique constraint on (school_id, phone) or (school_id, email). A
//      mother and father commonly share a household phone; a guardian with a
//      shared family inbox may legitimately appear against multiple students
//      under separate records (rare, but real). The (school_id, phone) index
//      backs the link-existing picker; uniqueness would block valid data.
//
//   2. isPrimary on StudentGuardian has no schema-level "only one per
//      student" rule — application enforces it (GuardiansService demotes
//      sibling links inside the same transaction). A partial unique index
//      would be the correct-by-construction guard, but it would also block
//      the demote-then-promote pattern unless wrapped in a DEFERRABLE
//      constraint, which Postgres only supports for UNIQUE on a regular
//      index, not a partial one. The service-layer rule is the only path.
//
// onDelete: Cascade on BOTH FKs of StudentGuardian — deleting a Student or
// a Guardian cleans up the links. Guardian deletion itself is gated by the
// service to refuse hard-delete while links exist, so the cascade is a
// belt-and-braces guard, not the primary unlink path.

model Guardian {
  messageThreads MessageThread[] // CP8.1
  id             String          @id @default(uuid())
  schoolId       String          @map("school_id")
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  relationship   Relationship
  phone          String // NOT globally unique — see header comment
  email          String?

  // Phase 4 / Slice 2 — portal auth (Decision A, docs/modules/phase-4.md §3/§4).
  // Guardian is extended directly rather than a companion table, mirroring how
  // User already blends profile + auth in one row. All four nullable except
  // emailVerified — every pre-Phase-4 guardian was never invited, never
  // logged in, which NULL/false both represent correctly with no backfill.
  passwordHash         String?   @map("password_hash")
  emailVerified        Boolean   @default(false) @map("email_verified")
  lastLoginAt          DateTime? @map("last_login_at")
  portalInvitedAt      DateTime? @map("portal_invited_at")
  // 2026-10-02 — the school's lever to switch a parent's portal access off.
  // NULL = enabled. A timestamp scoped to PORTAL access, not an is_active on
  // the guardian: the guardian stays a contact (absence SMS still goes to
  // them). passwordHash is left alone, so reactivating needs no re-invite.
  // Read by auth_resolve_guardian_session (portal_enabled) and excluded by the
  // login and password-reset lookups — see the migration header.
  portalDisabledAt     DateTime? @map("portal_disabled_at")
  // The parent's agreement to the privacy policy and terms, with the wording
  // version, when they accept the portal invitation or, for parents who
  // joined before 2026-10-25, the next time they sign in
  // (docs/modules/data-protection.md).
  portalConsentAt      DateTime? @map("portal_consent_at")
  portalConsentVersion String?   @map("portal_consent_version")

  occupation String?
  employer   String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  students           StudentGuardian[]
  sessions           GuardianSession[]
  invitations        GuardianInvitation[]
  passwordResets     GuardianPasswordResetToken[]
  deviceTokens       DeviceToken[] // Phase 6 / Slice 5.
  announcementEmails AnnouncementEmail[]
  eventRsvps         EventRsvp[]

  // Decision C (phase-4.md) — scoped per school, not global. A guardian with
  // children at two schools gets two separate portal accounts (intentional).
  // Postgres treats multiple NULLs as distinct, so uninvited guardians
  // (email IS NULL) never collide against this constraint. Confirmed clean
  // against local dev + Neon production data before adding (0 duplicate
  // (school_id, email) pairs in either — see phase-4.md slice 2 plan-first).
  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([schoolId, phone]) // backs the link-existing picker's phone search
  @@map("guardians")
}

// Phase 4 / Slice 2 — guardian portal session storage. Deliberately mirrors
// `Session` (staff) exactly, including the absence of a schoolId column —
// tenancy is resolved by joining through guardianId, same chicken-and-egg
// reasoning as staff sessions (see auth_resolve_guardian_session below). A
// parallel table, not a reuse of `Session`: Session.userId is a non-nullable
// FK to User, and widening it to cover guardians would drag the staff RBAC/
// permissions machinery into a user class that never needs it.
model GuardianSession {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  tokenHash  String   @unique @map("token_hash")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("guardian_sessions")
}

// Guardian portal password recovery. A PARALLEL table to PasswordResetToken,
// not a reuse of it — the same relationship GuardianSession has to Session
// and GuardianInvitation has to Invitation.
//
// Two independent reasons, either sufficient on its own:
//
//  1. STRUCTURAL. PasswordResetToken.userId is a non-null FK to users with
//     onDelete: Cascade. A guardian id cannot go in that column. Reusing the
//     table would mean making userId nullable, adding a nullable guardianId,
//     and enforcing "exactly one of these is set" in a CHECK constraint —
//     trading a hard database-level invariant on a SECURITY table for a
//     softer one, to save a table.
//
//  2. SECURITY. Separate tables make cross-principal token confusion
//     STRUCTURALLY IMPOSSIBLE rather than conventional: a staff reset token
//     presented to POST /portal/reset-password resolves to nothing, because
//     the guardian resolver reads only this table. A shared table would need
//     every caller to remember to check a principal-type column, which is
//     exactly the trade CLAUDE.md's 2026-08-16 SECURITY DEFINER review
//     refused for the session resolvers.
//
// Carries school_id directly (like guardian_invitations, unlike
// guardian_sessions) so its RLS policy is the flat one rather than a join
// through guardians — the forgot-password path already knows the school_id
// from the pre-tenant lookup, so there is nothing to gain from deriving it.
model GuardianPasswordResetToken {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  guardianId String    @map("guardian_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@map("guardian_password_reset_tokens")
}

// Phase 4 / Slice 2 — admin-initiated guardian portal invitations (D2). A
// parallel table to `Invitation`, not a reuse: unlike a staff invite (where
// the User doesn't exist yet), the Guardian row already exists before this
// flow starts — created earlier when the student was linked — so this table
// carries only the invitation-specific fields (token, expiry, acceptance),
// not redundant name/email/phone copies. schoolId is denormalised for direct
// RLS, same pattern as StudentGuardian; cleanup cascades through guardianId
// rather than a direct FK to School (Guardian itself has no FK to School
// either — consistent with existing convention, not a new gap).
model GuardianInvitation {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  guardianId String    @map("guardian_id")
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  // Added 2026-09-16. Stamped by an admin revoking a pending invitation, and
  // by a resend (which revokes the old token before issuing a new one) — so a
  // link a parent already holds stops working the moment it is replaced,
  // rather than two live links existing at once. Filtered in the resolver's
  // WHERE clause, which makes revocation structural rather than a check each
  // caller must remember (same treatment as StudentPortalInvitation.revokedAt).
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@map("guardian_invitations")
}

// Phase 4 / Slice 6 — Notifications (D3). Per-school channel toggles.
// pushEnabled is dark until the mobile phase — no code reads it yet.
// smsEnabled defaults false: Termii costs money per message, unlike email,
// so SMS is opt-in rather than opt-out. No `school School @relation(...)` —
// schoolId is a plain scoping column, same convention as GradingScheme and
// Guardian itself (neither declares a School relation either).
model NotificationPreference {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  smsEnabled   Boolean  @default(false) @map("sms_enabled")
  pushEnabled  Boolean  @default(false) @map("push_enabled")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([schoolId])
  @@map("notification_preferences")
}

// Phase 6 / Slice 5 (D34) — an Expo push token for one app install.
//
// WHY A TABLE AND NOT A COLUMN on Guardian/Student: one person legitimately
// has several devices (a parent's phone and tablet), and one device carries
// several installs over its life (reinstall issues a new token). Both are
// one-to-many, and a column would silently drop every device but the last.
//
// EXACTLY ONE OF guardianId/studentId IS SET. Enforced by a CHECK constraint
// in the migration rather than by convention: a row with neither is
// unroutable, and a row with both would deliver a child's notification to a
// parent's device or the reverse — the precise cross-principal leak the two
// separate session tables exist to prevent (see CLAUDE.md's SECURITY DEFINER
// cadence review on why those are not merged).
//
// The token is NOT a credential — it is an address Expo issues, and holding
// one lets you send TO a device, not read anything from it. So it is stored
// in plaintext, unlike every session token here, which are stored as hashes
// because they authenticate. Do not "fix" this by hashing it: a hash cannot
// be sent to.
//
// schoolId is a plain scoping column with no School relation — same
// convention as NotificationPreference above, GradingScheme and Guardian.
model DeviceToken {
  id            String         @id @default(uuid())
  schoolId      String         @map("school_id")
  principalType PrincipalType  @map("principal_type")
  guardianId    String?        @map("guardian_id")
  studentId     String?        @map("student_id")
  userId        String?        @map("user_id") // staff (notifications v1, N2)
  // Expo's token, e.g. "ExponentPushToken[xxxxxxxx]". Globally unique: the
  // same install re-registering must UPDATE its row (and can legitimately
  // move between principals on a shared handset), never accumulate copies.
  expoPushToken String         @unique @map("expo_push_token")
  platform      DevicePlatform
  // Touched on every re-registration, which the app does at each launch.
  // A token Expo has not invalidated but no app has claimed in months is the
  // signal for a future prune; nothing reads it yet.
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@index([studentId])
  @@index([userId])
  @@map("device_tokens")
}

enum PrincipalType {
  GUARDIAN
  STUDENT
  // Notifications v1 (N2): staff devices live on the same table as families'.
  // The token, platform, last-seen stamp and send path are identical, and a
  // second table would mean two places to revoke a device.
  STAFF

  @@map("principal_type")
}

enum DevicePlatform {
  ANDROID
  IOS

  @@map("device_platform")
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  AUNT
  GRANDPARENT
  SIBLING
  OTHER
}

model StudentGuardian {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id") // denormalised for direct RLS
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  canPickup  Boolean  @default(true) @map("can_pickup")
  createdAt  DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId]) // a guardian cannot link to the same student twice
  @@index([schoolId])
  @@index([guardianId]) // reverse lookup: a guardian's children
  @@map("student_guardians")
}

// ---------- Phase 1 / Slice 6 — CSV import bookkeeping ----------
//
// One row per import attempt. The row is the source of truth for the
// wizard UI; BullMQ's internal job state (waiting/active/failed) is
// implementation detail and NEVER reaches the API consumer. The state
// machine is:
//
//   PENDING ──mapping─▶ VALIDATING ──worker ok──▶ READY ──┐  (commit is slice 7+)
//      │                     │                              ▼
//      │ delete              │ retries exhausted        COMMITTING ─▶ COMPLETED
//      ▼                     ▼
//   (gone)                  FAILED  ◀─────────────────────  (worker fatal)
//
// `sourceFileUrl` is a storage path (driver-agnostic — R2 in prod,
// filesystem in dev) of the form `schools/<schoolId>/imports/<jobId>/source.csv`.
// The StorageService is responsible for constructing this path; the schema
// does not enforce its shape because the path is opaque to Postgres.
//
// `previewSnapshot` holds first 50 good + first 50 bad rows for the UI
// preview only — the full bad-rows download (and the slice-7 error report)
// re-stream the source CSV rather than store all bad rows in JSON, to
// avoid bloating this row for large mostly-bad uploads.
//
// `failedReason` is populated by the FailedJobEvent listener when BullMQ
// exhausts retries, or directly by the worker when it detects an
// unrecoverable error (missing source file, parser fatal, etc.). Surfaced
// to the admin on step 3 of the wizard.
//
// `createdBy` is the userId of the admin who initiated the upload; flows
// into job-data for the worker so audit rows (slice 7 commit) attribute
// to a real user without needing a request context.
//
// SECURITY DEFINER count stays at 4. Every import endpoint is post-
// authentication and post-tenant; the worker establishes tenant context
// from job.data.schoolId via withTenant() — see apps/api/src/common/queue/
// tenant-worker.ts for the wrapper that makes this invariant mechanical.
model ImportJob {
  id              String          @id @default(uuid())
  schoolId        String          @map("school_id")
  type            ImportJobType
  status          ImportJobStatus @default(PENDING)
  // Empty string for STUDENTS_SCAN jobs: the captured image is never
  // persisted (D3), so there is no object to point at. Deliberately NOT made
  // nullable — three import types rely on this being present, and widening
  // the column to null would push an `if (!url)` branch into every one of
  // them to serve the one type that never reads it.
  sourceFileUrl   String          @map("source_file_url")
  columnMapping   Json?           @map("column_mapping")
  totalRows       Int             @default(0) @map("total_rows")
  validRows       Int             @default(0) @map("valid_rows")
  invalidRows     Int             @default(0) @map("invalid_rows")
  committedRows   Int             @default(0) @map("committed_rows")
  // STUDENTS imports only: students created successfully but NOT enrolled,
  // because their class-arm cell was blank or the column wasn't mapped
  // (2026-08-09). Always 0 for GUARDIANS/TEACHERS.
  //
  // Not an error count — a school mid-admission legitimately has unplaced
  // students — but the admin needs to know, so the done screen reports it as
  // an aggregate. A real per-row warning tier was deliberately deferred; see
  // docs/modules/student-import-enrollment.md D7. When that tier lands, this
  // column stays: it is the cheap summary, not a substitute for the tier.
  notEnrolledRows Int             @default(0) @map("not_enrolled_rows")
  errorReportUrl  String?         @map("error_report_url")
  previewSnapshot Json?           @map("preview_snapshot")
  // STUDENTS_SCAN only (Smart Import beta, 2026-10-24): COUNTS of how the
  // reading went, never text. How long the page took to read, then at commit
  // how many cells the admin changed per field, rows removed, and their
  // optional rating. `scanReviewStatsSchema` in @school-kit/types.
  scanReview      Json?           @map("scan_review")
  failedReason    String?         @map("failed_reason")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("import_jobs")
}

enum ImportJobType {
  STUDENTS
  GUARDIANS
  TEACHERS
  // Camera-captured student register (Smart Student Import). A separate type
  // rather than a discriminator column on STUDENTS because the two differ in
  // LIFECYCLE, not just in provenance: a STUDENTS job has a source file in
  // storage and a mapping step, and a STUDENTS_SCAN job has neither — the
  // model already mapped the fields (that is the feature) and the image is
  // never persisted (D3). The validate worker dispatches on this enum, so
  // making it a type keeps "does this job have a source file?" answerable
  // from the row instead of from a second nullable column that could
  // disagree with it.
  STUDENTS_SCAN
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  READY
  COMMITTING
  COMPLETED
  FAILED
}

// ---------- Phase 1 / Slice 9 — Enrollment (per-term) ----------
//
// Per-term, not per-academic-year. One row per (school, student, term).
// Why per-term, locked at 2026-05-22 in Phase 1 planning (docs/modules/
// phase-1.md → "Enrollment is per-TERM, not per-academic-year"):
//   - Nigerian schools admit students mid-year. A second-term joiner
//     gets a second-term row and no first-term row — no fudging.
//   - Phase 2's term-scoped features (attendance, CA1/CA2/exam, report
//     cards) join cleanly to Enrollment without a "which arm were they
//     in this term" lookup table.
//   - Mid-year arm transfers manifest as the NEXT term's row in the
//     new arm; the old term's row stays as historical truth.
// Do NOT "simplify" this back to per-year — it breaks the join shape
// Phase 2 is designed around.
//
// academicYearId is denormalised from term.academicYearId for cheap
// "all students enrolled in 2025/2026" roster queries. The service
// layer resolves academicYearId from termId at write time; the API
// never accepts it from a request body. The columns must stay
// consistent — Phase 2 may add a CHECK constraint or trigger; Phase
// 1 keeps it as a service-layer invariant to ship.
//
// Status enum (six values; only ENROLLED + WITHDRAWN have workflows
// in slice 9, the others reachable via manual PATCH — see slice-9
// scope decision):
//   - ENROLLED       (default; created on enrol)
//   - WITHDRAWN      (admin withdrew; cascade from student.withdraw)
//   - GRADUATED      (admin graduated; cascade from student.graduate)
//   - TRANSFERRED    (back-fill / manual PATCH; Phase 2 workflow)
//   - PROMOTED       (back-fill / manual PATCH; Phase 2/3 promotion engine)
//   - REPEATED       (back-fill / manual PATCH; Phase 2/3 promotion engine)
//
// No graduatedAt column — derived from updatedAt for the rare case the
// Phase 2 transcript module needs an explicit moment. Captured in
// docs/deferred.md as a Phase-2-trigger.

model Enrollment {
  id                String           @id @default(uuid())
  schoolId          String           @map("school_id")
  studentId         String           @map("student_id")
  termId            String           @map("term_id")
  academicYearId    String           @map("academic_year_id") // denormalised from term; MUST equal term.academic_year_id
  classArmId        String           @map("class_arm_id")
  status            EnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  transferredAt     DateTime?        @map("transferred_at")
  withdrawnAt       DateTime?        @map("withdrawn_at")
  promotedFromArmId String?          @map("promoted_from_arm_id") // optional pointer to a previous term's arm (mid-year transfer or year promotion)
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classArm     ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, termId]) // one row per student per term
  @@index([schoolId])
  @@index([classArmId])
  @@index([schoolId, termId])
  @@index([schoolId, academicYearId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  PROMOTED
  REPEATED
  WITHDRAWN
  GRADUATED
}

// ---------- Staff (Phase 1 / Slice 10) ----------
//
// TeacherProfile is the HR record for a User who holds the teacher role.
// 1:1 with User (userId @unique). Created explicitly by an admin AFTER the
// teacher accepts their invitation (Q2 lifecycle, locked 2026-05-30):
//   - The invitation-accept path is untouched — no profile is auto-created.
//   - `POST /teacher-profiles { userId, staffNumber, ... }` materialises it
//     with a real, admin-entered staffNumber.
//   - The teacher CSV import (slice 10 cp2) creates Invitations only; it does
//     NOT import profile fields (deferred — the Invitation row can't carry
//     them per phase-1.md:478, and acceptance #7 only requires invite-create).
//
// `joinedAt` is the pinned spec shape: a plain DateTime @default(now()), i.e.
// the moment the profile row was created — NOT an admin-entered hire date.
// A real `hireDate DATE` is Phase 3 payroll territory (alongside BVN capture,
// deferred at phase-1.md:1234). Kept as joinedAt per the locked design.
//
// Two unique constraints (userId, and (schoolId, staffNumber)) — the service
// pre-checks both before insert so it can return precise 409 codes; under
// FORCE RLS the P2002 constraint name is stripped, so we cannot discriminate
// from the error alone (see the RLS-hides-constraint-name note in CLAUDE.md).
//
// onDelete: Cascade — deleting the User drops the profile. In practice users
// are soft-deleted (isActive=false), so this fires only on a real hard delete.
model TeacherProfile {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  userId         String   @unique @map("user_id") // 1:1 with User
  staffNumber    String   @map("staff_number") // unique per school; free-text in Phase 1
  qualifications String? // free-text in Phase 1; structured array in Phase 3 payroll
  specialty      String? // e.g. "Mathematics"
  nutNumber      String?  @map("nut_number") // Nigerian Union of Teachers number (optional)
  joinedAt       DateTime @default(now()) @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@map("teacher_profiles")
}

// ---------- Phase 1 / Slice 11 — TeacherAssignment ----------
//
// Records "teacher T teaches subject S in class arm A for year Y (optionally
// term-specific)". This is the data behind the teacher-scope filter that
// closes acceptance #9 — a teacher logging in sees only the arms + subjects
// they are assigned to (cp2), plus the arms where they are the form teacher
// (ClassArm.classTeacherId, slice 3/10) which the scope helper unions in.
//
// Shape (locked 2026-05-31): direct FKs to classArm + subject, NOT through
// ClassSubject. ClassSubject is (classLevel × subject) — curriculum at the
// LEVEL; a teacher teaches a specific ARM (JSS 1A, not "JSS 1" as a whole),
// so the assignment must reference the arm. academicYearId scopes the
// assignment to a year; termId is OPTIONAL — null means "the whole year",
// a set value means "this term only" (e.g. a relief teacher covering one
// term). Closest to candidate (c) in the plan, with year + optional-term
// scoping added.
//
// Co-teaching is ALLOWED by design (Q2, 2026-05-31): teacherId is part of
// the unique key, so two teachers can share the same (arm, subject, year,
// term). Supports lab/team teaching and mid-term relief. The unique only
// stops the SAME teacher being assigned twice to an identical tuple.
//
// CAVEAT — NULL term + the unique key: Postgres treats NULL as DISTINCT in a
// unique index, so two identical whole-year rows (termId = NULL) do NOT
// collide at the DB. The service therefore pre-checks for an existing
// identical active assignment (matching null term explicitly) and returns a
// clean 409 TEACHER_ALREADY_ASSIGNED; the P2002 catch is the backstop for
// the non-null race. See teacher-assignments.service.ts.
//
// Direct school_id column for the same cheap direct-RLS filter every Phase 1
// table uses — no join-through-parent EXISTS subquery. onDelete: Cascade on
// teacher/arm/subject/year (deleting any drops the assignment); SetNull on
// term so clearing a term-specific assignment's term degrades it to a
// whole-year row rather than vanishing.
//
// SECURITY DEFINER count stays at 4 — every endpoint is post-authentication
// and post-tenant; withTenant() covers all access.
model TeacherAssignment {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  teacherId      String   @map("teacher_id") // FK → users.id
  classArmId     String   @map("class_arm_id")
  subjectId      String   @map("subject_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id") // null = whole year; set = term-specific
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  teacher      User         @relation("TeacherSubjectAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  classArm     ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([schoolId, teacherId, classArmId, subjectId, academicYearId, termId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classArmId])
  @@index([schoolId, academicYearId])
  @@map("teacher_assignments")
}

// ---------- Phase 1 / Slice 12 — AI foundation (thin; semantics OWNED BY PHASE 5) ----------
//
// These two tables exist to lock in school_id + RLS + audit shape NOW so that
// when Phase 5 fills out the AI features we are NOT doing a live-data
// migration on a populated table. They sit EMPTY in Phase 1 — slice 12 is a
// hard gate against premature Phase-5 work, not a feature. Do not build
// against them in Phase 1.
//
// Deliberately omitted (Phase 5 owns these — adding them now pre-empts a
// decision the spec intentionally punts):
//   - MasteryRecord: NO score column (0-1 vs 0-100 vs letter is Phase 5), NO
//     time-decay field beyond updatedAt, NO source/origin column (tutor vs
//     assessment vs manual). status is free-text String now, an enum in
//     Phase 5; topicRef is a loose string so the grain (subject/topic/
//     objective) can be chosen later without a migration.
//   - AIInteractionLog: payload is an OPAQUE Json envelope whose structure is
//     Phase-5-owned. It MUST stay PII-free per CLAUDE.md AI hard rules (never
//     send student PII to the LLM; log opaque ids + class-level context only).
//     The inline-vs-R2 storage tradeoff (cost/PII/eval) is a Phase-5 decision
//     made when there is a real payload — not pre-built here.
//
// NAMING (resolved 2026-07-26, see docs/deferred.md): ARCHITECTURE.md §5/§7
// and CLAUDE.md's AI hard rules name the LLM-call log `AIGeneration`/
// `ai_generations` — a separate table from this one, not a drift to
// reconcile. This table (`AIInteractionLog`/`ai_interaction_logs`) is a
// session/interaction content record; `AIGeneration` (not yet built) is the
// per-call cost/compliance ledger the hard rule requires. Phase 5 builds
// `AIGeneration` fresh per the draft schema in docs/deferred.md — no rename
// or merge of this table.
//
// Both tables carry their OWN school_id (despite the studentId FK) → flat
// direct-column RLS, same cheap pattern as student_guardians (see
// docs/modules/phase-1.md "Note on student_guardians"). SECURITY DEFINER
// count stays at 4 — no endpoints, no pre-tenant access; the tables are only
// ever reached via withTenant once Phase 5 wires them up.

model MasteryRecord {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  studentId String   @map("student_id")
  topicRef  String   @map("topic_ref") // loose identifier; taxonomy owned by Phase 5
  status    String // free-text in Phase 1; enum in Phase 5
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, topicRef])
  @@index([schoolId])
  @@index([studentId])
  @@map("mastery_records")
}

model AIInteractionLog {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  studentId  String?  @map("student_id") // nullable: teacher-driven sessions exist too
  sessionRef String   @map("session_ref") // loose grouping identifier; shape owned by Phase 5
  payload    Json // raw envelope; structure owned by Phase 5; MUST stay PII-free
  createdAt  DateTime @default(now()) @map("created_at")

  student     Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  generations AIGeneration[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@map("ai_interaction_logs")
}

// ---------- Phase 5 / Slice 1 CP2 — AI cost + compliance ledger ----------
//
// `ai_generations` is the per-call cost/compliance ledger CLAUDE.md's AI hard
// rule mandates: "Every call to claudeClient.messages.create must log to the
// ai_generations table: model, prompt name + version, input/output tokens,
// latency, cost estimate, success/error."
//
// It is a DIFFERENT TABLE from AIInteractionLog, not a rename (resolved
// 2026-07-26 — see CLAUDE.md's AI hard-rules section and docs/deferred.md).
// AIInteractionLog is a session/interaction CONTENT record (loose `payload`
// JSON, nullable studentId, sessionRef grouping). This is a flat, typed,
// cheaply-aggregable row per underlying LLM call, shaped for the budget query.
// One tutor session (one AIInteractionLog group) spans many rows here, which
// is why interactionLogId is a nullable many-to-one back to it and not a 1:1.
//
// DELIBERATELY OMITTED: prompt text and completion text. They live in
// AIInteractionLog.payload. ARCHITECTURE.md §5 currently describes this table
// as logging "prompt, output" — that line is stale and is corrected as part of
// this phase; a cost ledger that holds conversation content would both bloat
// the aggregate query and duplicate the PII surface the AI hard rules exist to
// keep narrow.
//
// COST UNIT — costMicroUsd is integer MICRO-US-DOLLARS, not kobo. This is a
// deliberate, documented carve-out from CLAUDE.md's Money hard rule ("money is
// Int kobo"), locked in docs/modules/phase-5.md D2. The Money rule exists so
// that naira a school TRANSACTS never suffers float drift or display ambiguity
// — fees, invoices, payments, refunds, payroll. This column is vendor-cost
// telemetry: the school never sees it, no invoice references it, no
// FinanceService path touches it, and no audit row depends on it. Converting
// USD→kobo at write time would need an FX-rate source that does not exist in
// this repo, plus a rounding policy, and would make the stored value
// un-interpretable later (you cannot recover the USD figure without also
// storing the rate — at which point you have stored USD with extra steps and a
// permanent naira-devaluation artifact in the historical series). The rule's
// actual intent — integers, never Float — is fully preserved. Int max is
// ~2.1e9 µUSD ≈ $2,147 per row, three orders of magnitude above any single
// generation. If AI cost is ever billed back to schools, FX conversion happens
// at BILLING time with the rate recorded then, which is the only correct place
// for it anyway.
//
// pricedAtVersion tags which price table produced costMicroUsd, so a pricing
// change is re-derivable rather than silently mixing units across time.
model AIGeneration {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  // Nullable: not every call is session-scoped (a one-shot lesson-plan
  // generation has no conversation to group under). SetNull rather than
  // Cascade — the cost ledger must survive content deletion, since it is the
  // record that money was spent.
  interactionLogId String?  @map("interaction_log_id")
  // Nullable: system/cron-driven calls (weekly parent summaries) have no
  // acting user. Populated for user-initiated calls so the per-user daily
  // rate limit can count against it.
  userId           String?  @map("user_id")
  model            String
  promptName       String   @map("prompt_name")
  // Plain String, NOT an enum and NOT a FK to a prompt table. This is a
  // historical record: it must be able to hold "report-card-subject-comment@3"
  // forever, including after v3 is deleted from the registry in packages/ai.
  // Enum-ing it would mean a migration per prompt version. Compile-time safety
  // lives at the CALL SITE via the typed registry instead — see
  // docs/modules/phase-5.md D8.
  promptVersion    String   @map("prompt_version")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  latencyMs        Int      @map("latency_ms")
  costMicroUsd     Int      @map("cost_micro_usd")
  pricedAtVersion  String   @map("priced_at_version")
  success          Boolean
  // Redacted before write — no secrets, no PII, no raw prompt echo.
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  interactionLog AIInteractionLog? @relation(fields: [interactionLogId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, createdAt])
  // Serves the per-user daily rate-limit count in the reserve transaction.
  @@index([schoolId, userId, createdAt])
  @@map("ai_generations")
}

// Per-school monthly budget counter.
//
// WHY A COUNTER TABLE AND NOT `SUM(input_tokens + output_tokens)` OVER
// ai_generations — three independent reasons, any one of which is sufficient
// (docs/modules/phase-5.md D4):
//   1. It is a growing-table aggregate on the hot path of EVERY AI call, on a
//      database where ~2s authenticated latency is already normal.
//   2. It would couple the budget to retention: any future pruning of
//      ai_generations would silently reset every school's spend to zero.
//   3. It cannot express a RESERVATION, and a pre-call budget check is
//      fundamentally a reservation — the hard rule says the budget is
//      "enforced before the call, not after", but the true token count is only
//      known after.
//
// tokensReserved is the enforcement column (pessimistic: input estimate +
// max_tokens). tokensActual is the truth, written at settle. The two converge
// as calls settle; tokensReserved is always >= tokensActual.
//
// Carries its own school_id → flat direct-column RLS, the same cheap pattern as
// notification_preferences and the two Phase 1 AI tables. No SECURITY DEFINER
// function is needed (no pre-tenant access, every touch is inside withTenant),
// so the inventory count stays at 16.
model AIBudgetPeriod {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  // First day of the UTC month this row counts. @db.Date, not DateTime: this
  // is a calendar boundary, not a moment — same convention as academic-year /
  // term dates (CLAUDE.md "Prisma column types in raw SQL").
  periodStart    DateTime @map("period_start") @db.Date
  tokensReserved Int      @default(0) @map("tokens_reserved")
  tokensActual   Int      @default(0) @map("tokens_actual")
  costMicroUsd   Int      @default(0) @map("cost_micro_usd")
  callCount      Int      @default(0) @map("call_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, periodStart])
  @@index([schoolId])
  @@map("ai_budget_periods")
}

// ---------- Phase 7 / CP1 — Curriculum RAG ----------
//
// See docs/modules/phase-7.md. v1 grounds the EXISTING lesson-plan generator
// in a school's own scheme of work; the student tutor is a later slice.
//
// Two content tables (document + chunk) and one ledger (embedding calls).
// pgvector was enabled in the very first migration (20260514120000_init), so
// no extension work is needed here.

enum CurriculumDocumentStatus {
  PENDING // uploaded, not yet processed
  PROCESSING // chunking in flight
  AWAITING_REVIEW // parsed and chunked; waiting for a teacher to confirm the structure (CP5 / D28)
  EMBEDDING // teacher approved; vectors being generated
  READY // embedded, retrievable, and human-confirmed
  FAILED // see errorMessage
}

model CurriculumDocument {
  id           String @id @default(uuid())
  schoolId     String @map("school_id")
  // Plain scoping columns, not declared relations — same convention as
  // LessonPlan.classLevelId/subjectId, which these deliberately mirror since
  // retrieval is scoped by exactly the pair a lesson plan is generated for.
  subjectId    String @map("subject_id")
  classLevelId String @map("class_level_id")

  title      String
  // Storage key for the original upload — the source of truth a teacher can
  // re-download. Key kind: { kind: "curriculum-document"; documentId }.
  storageKey String @map("storage_key")
  // Content hash of the extracted text. Guards against re-embedding an
  // identical re-upload, which is the common case when a teacher re-sends a
  // file they already sent.
  checksum   String

  status       CurriculumDocumentStatus @default(PENDING)
  // Redacted failure reason when status = FAILED. Never carries raw document
  // text — a parse failure must not spill the document into an error column.
  errorMessage String?                  @map("error_message")
  chunkCount   Int                      @default(0) @map("chunk_count")

  uploadedBy String @map("uploaded_by")

  // The review gate (CP5 / D31). `reviewedAt` NULL is MEANINGFUL, not missing
  // data: it distinguishes "a human confirmed this structure through the gate"
  // from "this document predates the gate" (D34). Any analysis of chunker
  // quality must exclude NULL-reviewed rows rather than counting them as
  // zero-edit approvals, which would silently flatter the chunker.
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  // What the teacher CHANGED before approving — the first real measurement of
  // chunking quality on documents nobody on this project has seen. A document
  // approved with zero edits is evidence the chunker got it right; one with six
  // heading corrections is evidence it did not.
  headingEditCount    Int @default(0) @map("heading_edit_count")
  discardedChunkCount Int @default(0) @map("discarded_chunk_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chunks CurriculumChunk[]

  // Backs the COMPOSITE foreign key from curriculum_chunks. Not a uniqueness
  // rule anyone needs on its own — `id` is already the primary key — it exists
  // solely so the child can reference (id, school_id) as a pair. See the
  // relation on CurriculumChunk for why that matters.
  @@unique([id, schoolId])
  // The retrieval scope: chunks are searched within one school's subject +
  // class level, never across the whole tenant.
  @@index([schoolId, subjectId, classLevelId])
  @@index([schoolId, status])
  // Backs the duplicate-upload check: a re-sent file is refused with "already
  // uploaded" rather than paying to embed identical content twice. NOT unique —
  // the same scheme legitimately appears under two class levels, and a deleted
  // document must be re-uploadable.
  @@index([schoolId, checksum])
  @@map("curriculum_documents")
}

model CurriculumChunk {
  id         String @id @default(uuid())
  // Denormalised for a flat RLS check, same pattern as StudentPortalInvitation
  // and every other child table in this schema. A cross-tenant leak here would
  // put another school's curriculum inside a teacher's lesson plan, so the
  // policy is doing real work, not tidiness.
  schoolId   String @map("school_id")
  documentId String @map("document_id")

  // Position in the source document — stable ordering for display.
  ordinal    Int
  // Detected heading path, e.g. "Term 1 > Week 5 > Photosynthesis". This is
  // what makes a r…17417 tokens truncated…essed Publish. The student and guardian readers read
// ONLY this table — never timetables / timetable_entries — so editing a live
// timetable can never change what a family sees until it is republished.
// Withdraw DELETES the row: there is no "hidden" flag that a reader could forget
// to respect.
model TimetablePublication {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  classArmId  String   @map("class_arm_id")
  termId      String   @map("term_id")
  // The snapshot: periods (label, kind, times), school days, lessons (day,
  // period position, subject name, teacher display names). JSON on purpose —
  // it is a frozen document, not relational data anything joins against.
  grid        Json
  contentHash String   @map("content_hash") // sha256 of the canonical grid; "unpublished changes" compares against it
  publishedBy String   @map("published_by")
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  classArm ClassArm @relation(fields: [schoolId, classArmId], references: [schoolId, id], onDelete: Cascade)
  term     Term     @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, classArmId, termId])
  @@index([schoolId])
  @@map("timetable_publications")
}

model TimetableEntry {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  timetableId String   @map("timetable_id")
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt // ISO: 1 = Monday … 7 = Sunday
  bellSlotId  String   @map("bell_slot_id")
  subjectId   String   @map("subject_id")
  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  timetable Timetable               @relation(fields: [schoolId, timetableId], references: [schoolId, id], onDelete: Cascade)
  bellSlot  BellSlot                @relation(fields: [schoolId, bellSlotId], references: [schoolId, id], onDelete: Restrict)
  subject   Subject                 @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  teachers  TimetableEntryTeacher[]

  @@unique([schoolId, id])
  @@unique([timetableId, dayOfWeek, bellSlotId]) // one lesson per cell
  @@index([schoolId])
  @@index([schoolId, bellSlotId])
  @@map("timetable_entries")
}

model TimetableEntryTeacher {
  id        String @id @default(uuid())
  schoolId  String @map("school_id")
  entryId   String @map("entry_id")
  teacherId String @map("teacher_id")

  entry   TimetableEntry @relation(fields: [schoolId, entryId], references: [schoolId, id], onDelete: Cascade)
  teacher User           @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)

  @@unique([entryId, teacherId])
  @@index([schoolId])
  @@index([schoolId, teacherId])
  @@map("timetable_entry_teachers")
}

// Branded receipts (docs/modules/branded-receipts.md D3): one running receipt
// number per school per calendar year — RCP/2026/000123. Incremented by a
// single atomic upsert inside the payment's own transaction, so a payment that
// rolls back takes its number with it and a failed payment never burns one.
model ReceiptSequence {
  schoolId   String   @map("school_id")
  year       Int
  lastNumber Int      @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([schoolId, year])
  @@map("receipt_sequences")
}

// Notifications v1 (N6) — one row per (event, person), which is what makes
// "one notification per person per event" a property rather than a hope: the
// unique constraint refuses the second attempt, so a sibling fan-out, a retry
// and a double-fired cron all collapse to one message.
//
// It is also the answer to a school asking "did you tell this parent?".
model NotificationDelivery {
  id            String        @id @default(uuid())
  schoolId      String        @map("school_id")
  eventType     String        @map("event_type") // "results.released", "payment.recorded", …
  eventId       String        @map("event_id") // the term/payment/arm this was about
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") // guardian, student or user id
  channel       String // PUSH | SMS | EMAIL | NONE — what the rail chose
  sentAt        DateTime      @default(now()) @map("sent_at")

  @@unique([schoolId, eventType, eventId, principalType, principalId])
  @@index([schoolId, sentAt])
  @@map("notification_deliveries")
}

// Announcements (docs/modules/announcements.md). Deferred three times as its
// own feature (phase-4 D2, phase-8 D20/Q4) and built as one here.
enum AnnouncementAudience {
  EVERYONE
  PARENTS
  STAFF
  CLASS

  @@map("announcement_audience")
}

// ---------- Homework (docs/modules/the-school-day.md Part B) ----------
//
// B7: INFORMATION, not workflow. What to do and by when. Nothing is submitted,
// uploaded or marked here — submissions need per-student storage, a marking
// queue, late/resubmit states and an offline story for a child on one bar of
// signal, and each is a real design. Posting alone is what makes a student
// open the app on a Tuesday, which results (three times a year) never will.
//
// If submissions are ever built they are their own plan-first and their own
// table. This model must not quietly grow a `submittedAt`. (Phase 9 / CP4 did
// exactly that: AssignmentCollection and AssignmentSubmission below. This
// model gained only the relation field, no column.)
model Assignment {
  id         String @id @default(uuid())
  schoolId   String @map("school_id")
  classArmId String @map("class_arm_id")
  subjectId  String @map("subject_id")
  // The authoring teacher. Plain scoping column, not a declared relation —
  // same convention as LessonPlan.createdBy: homework outlives a staff
  // member's account as a record of what a class was set.
  createdBy  String @map("created_by")

  title        String
  instructions String?
  // @db.Date, not DateTime: "due Friday" is a calendar date with no
  // time-of-day, and a timestamp would reintroduce the "midnight in which
  // zone?" trap the DATE convention exists to avoid.
  dueDate      DateTime @map("due_date") @db.Date

  postedAt    DateTime  @default(now()) @map("posted_at")
  // B10: withdrawn, not deleted — a child who wrote it down deserves a record
  // that it existed and was cancelled. Same treatment as an announcement.
  withdrawnAt DateTime? @map("withdrawn_at")
  withdrawnBy String?   @map("withdrawn_by")

  // Phase 9 / CP4 — set when the teacher switches on "collect work".
  collection AssignmentCollection?

  // The family read is "this class, due on or after today", and the staff read
  // is "what I set, newest first".
  @@index([schoolId, classArmId, dueDate])
  @@index([schoolId, createdBy, postedAt])
  @@map("assignments")
}

// ---------- Behaviour records (docs/modules/the-school-day.md Part C) ----------
//
// C14: INTERNAL in v1. A form teacher and an admin write and read these; a
// parent does not see them. A behaviour note a parent can read changes what a
// teacher is willing to write, and "my child did not do that" needs a right of
// reply, a retention rule and an amendment path — none of which exist. Making
// it parent-visible later is a decision with a design; making it parent-visible
// by default now is how a school ends up in an argument it cannot win.
//
// C15: no AI anywhere near this. The hard rule bars auto-finalising; this goes
// further and keeps the model out entirely, because a machine-written judgement
// about a child's conduct is not something a teacher can meaningfully approve.
//
// C16: COMMENDATION as well as CONCERN. A system that records only what a child
// did wrong is one teachers stop using and parents rightly resent.
enum BehaviourKind {
  COMMENDATION
  CONCERN

  @@map("behaviour_kind")
}

model BehaviourRecord {
  id         String        @id @default(uuid())
  schoolId   String        @map("school_id")
  studentId  String        @map("student_id")
  kind       BehaviourKind
  note       String
  // The day it happened, which is not always the day it was written up: a
  // teacher records Friday's incident on Monday. @db.Date for the usual
  // reason — a calendar day has no time of day and no timezone.
  occurredOn DateTime      @map("occurred_on") @db.Date

  recordedBy  String    @map("recorded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Withdrawn, never deleted: a record that was wrong should read as withdrawn
  // rather than vanish, because "it was removed" is itself part of the history
  // when a parent meeting turns on what was written.
  withdrawnAt DateTime? @map("withdrawn_at")
  withdrawnBy String?   @map("withdrawn_by")

  // Phase 9 / CP2.1 (CP2-D1). Both null unless the school has points on and
  // the writer chose a category. `points` is COPIED from the category at the
  // time of writing, so changing a category's value later never rewrites a
  // past term.
  categoryId String?            @map("category_id")
  category   BehaviourCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  points     Int?

  // Phase 9 / CP2.2 (CP2-D2). Set when the record is one student's part of an
  // incident; the incident's own description is shared, the note is theirs.
  incidentId String?            @map("incident_id")
  incident   BehaviourIncident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId, occurredOn])
  @@index([incidentId])
  @@map("behaviour_records")
}

// Phase 9 / CP2.2 — an incident groups the CONCERN records of several
// students (docs/modules/phase-9.md §9 CP2-D2). Withdrawn, never deleted;
// withdrawing it withdraws its records.
model BehaviourIncident {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  // DATE, as on the record: the day it happened.
  occurredOn  DateTime  @map("occurred_on") @db.Date
  place       String
  description String
  recordedBy  String    @map("recorded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  withdrawnBy String?   @map("withdrawn_by")

  records   BehaviourRecord[]
  witnesses BehaviourIncidentWitness[]

  @@index([schoolId, occurredOn])
  @@map("behaviour_incidents")
}

// A member of staff who saw it. Chosen from the staff list, never typed.
model BehaviourIncidentWitness {
  incidentId String            @map("incident_id")
  userId     String            @map("user_id")
  schoolId   String            @map("school_id")
  incident   BehaviourIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, userId])
  @@map("behaviour_incident_witnesses")
}

// Phase 9 / CP2.1 — a school's behaviour categories (docs/modules/phase-9.md
// §9 CP2-D1), for example "Helping others +2" or "Late to class −1".
// Deactivated, never deleted: records point at them.
model BehaviourCategory {
  id        String        @id @default(uuid())
  schoolId  String        @map("school_id")
  name      String
  kind      BehaviourKind
  // −10…−1 for a concern, 1…10 for a commendation (CHECK in the migration).
  points    Int
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  records BehaviourRecord[]

  @@unique([schoolId, name])
  @@map("behaviour_categories")
}

// ---------- Phase 9 / CP2.3 — discipline (docs/modules/phase-9.md §9 CP2-D3) ----------
//
// A teacher PROPOSES, an owner or admin DECIDES, and anyone with the right may
// WITHDRAW. Never deleted. The reason is internal text: it never reaches a
// parent, the audit log, a push or an SMS (CP2-D4, CP2-D6).
enum DisciplineActionType {
  WARNING
  DETENTION
  SUSPENSION
  EXCLUSION

  @@map("discipline_action_type")
}

enum DisciplineActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("discipline_action_status")
}

model DisciplineAction {
  id         String                 @id @default(uuid())
  schoolId   String                 @map("school_id")
  studentId  String                 @map("student_id")
  // Optional links to what it is about.
  recordId   String?                @map("record_id")
  incidentId String?                @map("incident_id")
  type       DisciplineActionType
  // DATE: a detention's day; a suspension's first and last day; an
  // exclusion's first day. CHECKs in the migration keep them consistent with
  // the type. A warning has neither.
  startOn    DateTime?              @map("start_on") @db.Date
  endOn      DateTime?              @map("end_on") @db.Date
  reason     String
  status     DisciplineActionStatus @default(PROPOSED)

  proposedBy     String    @map("proposed_by")
  proposedAt     DateTime  @default(now()) @map("proposed_at")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  decisionReason String?   @map("decision_reason")
  withdrawnBy    String?   @map("withdrawn_by")
  withdrawnAt    DateTime? @map("withdrawn_at")

  notices DisciplineNotice[]

  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@map("discipline_actions")
}

enum DisciplineNoticeKind {
  SENT
  WITHDRAWN

  @@map("discipline_notice_kind")
}

// One row per guardian per action per kind, UNIQUE, so a retry or a second
// click can never notify a parent twice (CP2-D4).
model DisciplineNotice {
  id         String               @id @default(uuid())
  schoolId   String               @map("school_id")
  actionId   String               @map("action_id")
  guardianId String               @map("guardian_id")
  kind       DisciplineNoticeKind
  // "PUSH", "SMS" or "NONE" (no live app and no usable phone).
  channel    String
  sentAt     DateTime             @default(now()) @map("sent_at")
  action     DisciplineAction     @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([actionId, guardianId, kind])
  @@map("discipline_notices")
}

model Announcement {
  id             String               @id @default(uuid())
  schoolId       String               @map("school_id")
  title          String
  body           String
  audience       AnnouncementAudience
  classArmId     String?              @map("class_arm_id") // set only when audience = CLASS
  // A4: skips quiet hours and wakes phones. Audited on every send.
  urgent         Boolean              @default(false)
  createdBy      String               @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  // A2: an announcement is sent once and never silently reworded. It can be
  // withdrawn — it stops appearing and says so — and a correction is a new
  // announcement. There is deliberately no updatedAt and no edit path.
  withdrawnAt    DateTime?            @map("withdrawn_at")
  withdrawnBy    String?              @map("withdrawn_by")
  // Phase 9 / CP8.3: also emailed to the families (not for STAFF).
  emailFamilies  Boolean              @default(false) @map("email_families")
  // Families in the audience with no address when the email was prepared.
  emailNoAddress Int                  @default(0) @map("email_no_address")
  // 2026-10-22: also shown on the school's public website (Everyone or
  // Parents only; CHECK in SQL). Withdrawn ones never show.
  showOnWebsite  Boolean              @default(false) @map("show_on_website")

  reads  AnnouncementRead[]
  emails AnnouncementEmail[]

  @@index([schoolId, createdAt])
  @@map("announcements")
}

// A5: read state is per person and stays in the app. No read receipts go back
// to the school — "37 parents have not read this" turns into chasing parents
// over a notification setting, which is a support burden, not a feature.
model AnnouncementRead {
  announcementId String        @map("announcement_id")
  principalType  PrincipalType @map("principal_type")
  principalId    String        @map("principal_id") // guardian, student or user id
  readAt         DateTime      @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, principalType, principalId])
  @@map("announcement_reads")
}

// Opening the website from the app, already signed in
// (docs/modules/web-handoff-signin.md).
//
// A separate table from password_reset_tokens on purpose (H-data): separate
// tables make cross-purpose token confusion structurally impossible, which is
// the same rule CLAUDE.md's SECURITY DEFINER review applied to the session
// resolvers and guardian password reset already followed. A reset token
// presented to the handoff exchange resolves to nothing, because this
// resolver reads only this table.
model WebHandoffToken {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  userId    String    @map("user_id")
  // The session that asked for it (H1): if that session is gone by the time
  // the browser exchanges, so is this token.
  sessionId String    @map("session_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdIp String?   @map("created_ip")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@index([userId])
  @@map("web_handoff_tokens")
}

// Phase 8c / CP6b — Result Checker (docs/modules/phase-8.md §21).

enum ResultAccessMode {
  FREE // families read the released card in the portal and app
  PIN // the card opens only after a result PIN is redeemed (D11, D17)

  @@map("result_access_mode")
}

enum ResultUnlockVia {
  CHECKER
  GUARDIAN
  STUDENT

  @@map("result_unlock_via")
}

// A batch of PINs, generated together for one term (D15) and sold offline by
// the school (D9, D10). The plaintext PINs leave the server once, in the
// response that creates them (D16).
model ResultPinBatch {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  academicYearId String    @map("academic_year_id")
  termId         String    @map("term_id")
  // Per-school running number; serials are "B<number>-<index>".
  number         Int
  size           Int
  maxUses        Int       @map("max_uses")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  voidedAt       DateTime? @map("voided_at")
  voidedBy       String?   @map("voided_by")

  pins ResultPin[]

  @@unique([schoolId, number])
  @@index([schoolId, termId])
  @@map("result_pin_batches")
}

// One card. Stored only as an HMAC (D56); unbound until its first successful
// redemption (D10), after which it opens only that student's result.
model ResultPin {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  batchId        String    @map("batch_id")
  serial         String
  pinHash        String    @map("pin_hash")
  uses           Int       @default(0)
  boundStudentId String?   @map("bound_student_id")
  boundAt        DateTime? @map("bound_at")
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  batch ResultPinBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([schoolId, pinHash])
  @@unique([schoolId, serial])
  @@index([batchId])
  @@map("result_pins")
}

// The record D17's "everywhere" reads: once a student's term is unlocked by
// any route, every surface shows it.
model ResultUnlock {
  id        String          @id @default(uuid())
  schoolId  String          @map("school_id")
  studentId String          @map("student_id")
  termId    String          @map("term_id")
  pinId     String          @map("pin_id")
  via       ResultUnlockVia
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([schoolId, studentId, termId])
  @@map("result_unlocks")
}

// ---------------------------------------------------------------------------
// Phase 8c / CP5b — the question bank (docs/modules/phase-8.md §22.2).
//
// A school's own exam questions, per subject and class level, written by hand
// or drafted by AI. CP5c composes exam papers from APPROVED questions.
//
// THE LIFECYCLE IS THE POINT:
//   DRAFT    — editable in place, discardable (hard delete). Every AI-drafted
//              question starts here (D62 + the AI hard rule: no AI output is
//              final without a person approving it).
//   APPROVED — the subject teacher or an admin signed it off. NEVER edited in
//              place: an edit makes a new DRAFT that `supersedes` it, and the
//              old one is retired only when that revision is approved. So a
//              paper set from a question keeps the exact wording it was set
//              with, and the bank never has a gap while a revision is pending.
//   RETIRED  — terminal. Kept, never deleted, because a paper may cite it.
//
// `topic` is free text, as lesson plans' is (phase-5.md D13): no syllabus tree.
// ---------------------------------------------------------------------------
enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  THEORY
}

enum QuestionStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum QuestionSource {
  MANUAL
  AI
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id           String             @id @default(uuid())
  schoolId     String             @map("school_id")
  subjectId    String             @map("subject_id")
  classLevelId String             @map("class_level_id")
  topic        String
  type         QuestionType
  difficulty   QuestionDifficulty @default(MEDIUM)
  text         String
  marks        Int
  // The expected answer / marking guide. Required for short-answer and theory
  // (enforced in the service, where the message can say why); for multiple
  // choice it is an optional note on why the key is right.
  answerGuide  String?            @map("answer_guide")
  status       QuestionStatus     @default(DRAFT)
  source       QuestionSource     @default(MANUAL)
  // Plain scoping columns, not relations — the LessonPlan.createdBy convention:
  // a question outlives a staff member's account.
  createdBy    String             @map("created_by")
  approvedBy   String?            @map("approved_by")
  approvedAt   DateTime?          @map("approved_at")
  retiredAt    DateTime?          @map("retired_at")
  // The approved question this draft revises. Retired when this is approved.
  supersedesId String?            @map("supersedes_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classLevel ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  supersedes Question?        @relation("QuestionRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions  Question[]       @relation("QuestionRevision")
  paperItems ExamPaperItem[] // Phase 8c / CP5c — papers that set this question.
  options    QuestionOption[]

  @@index([schoolId])
  @@index([schoolId, subjectId, classLevelId, status])
  @@map("questions")
}

// The choices of a multiple-choice question, in display order (A, B, C, D).
// Carries school_id so its RLS policy is the cheap direct-column check.
model QuestionOption {
  id         String  @id @default(uuid())
  schoolId   String  @map("school_id")
  questionId String  @map("question_id")
  orderIndex Int     @map("order_index")
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
  @@index([schoolId])
  @@map("question_options")
}

// ---------------------------------------------------------------------------
// Phase 8c / CP5c — exam papers (docs/modules/phase-8.md §22.3).
//
// A paper is sections of APPROVED questions from the bank. A DRAFT is edited
// freely; FINAL is frozen for good, so what was printed and what is stored
// never disagree. A FINAL paper is changed only by duplicating it.
//
// Items POINT at questions rather than copying them, and that is safe because
// of CP5b's rule: an approved question is never edited in place (an edit makes
// a new row) and is retired, never deleted. The wording a FINAL paper
// references is the wording it was set with, for as long as the paper exists.
//
// Total marks are not stored: they are the sum of the questions' marks.
// ---------------------------------------------------------------------------
enum ExamPaperStatus {
  DRAFT
  FINAL
}

model ExamPaper {
  id               String          @id @default(uuid())
  schoolId         String          @map("school_id")
  subjectId        String          @map("subject_id")
  classLevelId     String          @map("class_level_id")
  termId           String          @map("term_id")
  // Optional: the gradebook column this paper's marks go into (usually
  // "Exam"). A FINAL paper's total then pre-fills that column's "Out of".
  componentId      String?         @map("component_id")
  title            String
  durationMinutes  Int             @map("duration_minutes")
  instructions     String?
  // Versions A–D to print, each with its own option order and marking scheme.
  versionCount     Int             @default(1) @map("version_count")
  status           ExamPaperStatus @default(DRAFT)
  createdBy        String          @map("created_by")
  finalisedBy      String?         @map("finalised_by")
  finalisedAt      DateTime?       @map("finalised_at")
  duplicatedFromId String?         @map("duplicated_from_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classLevel  ClassLevel         @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  term        Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  component   GradingComponent?  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  sections    ExamPaperSection[]
  items       ExamPaperItem[]
  cbtSittings CbtSitting[] // Online exams (CBT1) — sittings of this paper.

  @@index([schoolId])
  @@index([schoolId, subjectId, classLevelId, termId])
  @@map("exam_papers")
}

model ExamPaperSection {
  id           String  @id @default(uuid())
  schoolId     String  @map("school_id")
  paperId      String  @map("paper_id")
  orderIndex   Int     @map("order_index")
  title        String
  instructions String?

  paper ExamPaper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  items ExamPaperItem[]

  @@unique([paperId, orderIndex])
  @@index([schoolId])
  @@map("exam_paper_sections")
}

model ExamPaperItem {
  id         String @id @default(uuid())
  schoolId   String @map("school_id")
  paperId    String @map("paper_id")
  sectionId  String @map("section_id")
  questionId String @map("question_id")
  orderIndex Int    @map("order_index")

  paper    ExamPaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  section  ExamPaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // A question appears once per paper.
  @@unique([paperId, questionId])
  @@unique([sectionId, orderIndex])
  @@index([schoolId])
  @@index([questionId])
  @@map("exam_paper_items")
}

// ---------------------------------------------------------------------------
// Online exams (CBT) — docs/modules/cbt.md. CBT1: sittings, their arms, and
// the candidate list frozen at publish.
//
// A SITTING schedules one FINAL exam paper for one or more class arms (D1).
// Publishing snapshots the candidates and builds the encrypted exam pack
// (D2, D3). Two codes: `accessCode` lets a lab machine download the pack;
// `unlockCode` decrypts it at the start. Neither the pack nor any code ever
// carries the answer key (D4) — marking happens on the server.
// ---------------------------------------------------------------------------

enum CbtSittingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model CbtSitting {
  id              String           @id @default(uuid())
  schoolId        String           @map("school_id")
  paperId         String           @map("paper_id")
  title           String
  // The moment the exam may start, and the latest moment a student may begin.
  startsAt        DateTime         @map("starts_at")
  windowEndsAt    DateTime         @map("window_ends_at")
  durationMinutes Int              @map("duration_minutes")
  status          CbtSittingStatus @default(DRAFT)
  // 6 characters, unique within the school; with the school's slug it
  // downloads the pack. Reveals nothing on its own — the pack is encrypted.
  accessCode      String           @map("access_code")
  // 12 characters. The pack's key is derived from it (PBKDF2). Shown only to
  // cbt.manage holders, on the invigilator sheet; every view is audited.
  unlockCode      String           @map("unlock_code")
  // The encrypted pack envelope (JSON: KDF params, IV, ciphertext), built at
  // publish; NULL while DRAFT.
  pack            Json?
  packBuiltAt     DateTime?        @map("pack_built_at")
  createdBy       String           @map("created_by")
  publishedBy     String?          @map("published_by")
  publishedAt     DateTime?        @map("published_at")
  closedBy        String?          @map("closed_by")
  closedAt        DateTime?        @map("closed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  paper      ExamPaper       @relation(fields: [paperId], references: [id], onDelete: Restrict)
  arms       CbtSittingArm[]
  candidates CbtCandidate[]
  attempts   CbtAttempt[]

  @@unique([schoolId, accessCode])
  @@index([schoolId])
  @@index([paperId])
  @@map("cbt_sittings")
}

model CbtSittingArm {
  sittingId  String @map("sitting_id")
  classArmId String @map("class_arm_id")
  schoolId   String @map("school_id")

  sitting  CbtSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  classArm ClassArm   @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@id([sittingId, classArmId])
  @@index([schoolId])
  @@map("cbt_sitting_arms")
}

// Frozen at publish (D2): who may sit, in which arm, and which version.
model CbtCandidate {
  id         String @id @default(uuid())
  schoolId   String @map("school_id")
  sittingId  String @map("sitting_id")
  studentId  String @map("student_id")
  classArmId String @map("class_arm_id")
  version    String // "A" | "B" | "C" | "D"
  // CBT3: the mark for the questions sat on paper, typed in by the teacher.
  theoryMark Int?   @map("theory_mark")

  sitting  CbtSitting   @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classArm ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  attempts CbtAttempt[]

  @@unique([sittingId, studentId])
  @@index([schoolId])
  @@map("cbt_candidates")
}

// Online exams (CBT2) — one row per (candidate, lab machine). The machine sends
// a snapshot of the whole attempt each time; the highest `seq` wins, so repeats
// and late batches change nothing (docs/modules/cbt.md D5, D6).
model CbtAttempt {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  sittingId       String    @map("sitting_id")
  candidateId     String    @map("candidate_id")
  // A random id the machine makes for itself the first time it opens the app.
  deviceId        String    @map("device_id")
  seq             Int
  // { examPaperItemId: questionOptionId } — checked against the frozen paper.
  answers         Json      @default("{}")
  answeredCount   Int       @default(0) @map("answered_count")
  // The MACHINE's clock: what the student lived.
  startedAt       DateTime  @map("started_at")
  submittedAt     DateTime? @map("submitted_at")
  extraMinutes    Int       @default(0) @map("extra_minutes")
  focusLosses     Int       @default(0) @map("focus_losses")
  // CBT3: the attempt that counts, when a student sat on more than one
  // computer (D5). At most one per candidate (partial unique index).
  chosen          Boolean   @default(false)
  // The SERVER's clock: when it reached us.
  firstReceivedAt DateTime  @default(now()) @map("first_received_at")
  lastReceivedAt  DateTime  @default(now()) @map("last_received_at")

  sitting   CbtSitting   @relation(fields: [sittingId], references: [id], onDelete: Cascade)
  candidate CbtCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@unique([candidateId, deviceId])
  @@index([sittingId])
  @@index([schoolId])
  @@map("cbt_attempts")
}

// Admission numbers assigned by SchoolKit (docs/modules/admission-numbers.md).
enum AdmissionNumberMode {
  MANUAL
  AUTO
}

enum AdmissionNumberOrder {
  SCHOOL
  CLASS
  RANDOM
}

// One running count per scope: the year and/or class code the format shows,
// or "" for one count for ever. Taken with an upsert in the same transaction
// as the student insert. FORCE RLS on school_id.
model AdmissionNumberCounter {
  schoolId  String   @map("school_id")
  scope     String
  lastValue Int      @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, scope])
  @@map("admission_number_counters")
}

// Phase 9 / CP1 — a PDF copy of a report, made by the render worker
// (docs/modules/phase-9.md §8 CP1-D3). The API writes the finished HTML here,
// the worker prints it to PDF, stores the file and clears `html`, so the
// report's rows sit in this table only for the seconds between the two. A
// daily clean-up deletes rows and files older than 24 hours.
model ReportExport {
  id          String             @id @default(uuid())
  schoolId    String             @map("school_id")
  requestedBy String             @map("requested_by")
  report      String
  termId      String?            @map("term_id")
  status      ReportExportStatus @default(PENDING)
  filename    String
  html        String?
  storagePath String?            @map("storage_path")
  createdAt   DateTime           @default(now()) @map("created_at")
  finishedAt  DateTime?          @map("finished_at")
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("report_exports")
}

enum ReportExportStatus {
  PENDING
  GENERATED
  FAILED
}

// ---------- Phase 9 / CP3.1 — health profile (docs/modules/phase-9.md §10) ----------
//
// One per student. Read by owner, admin, the health officer and the child's
// guardians; every read is audited and the text never goes into the audit log.
// A teacher of the child sees ONLY `teacherNote`, which the health officer
// writes for that purpose (CP3-D2). No AI anywhere near it.
model HealthProfile {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  studentId      String   @unique @map("student_id")
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergies      String?
  conditions     String?
  medication     String?
  gpClinic       String?  @map("gp_clinic")
  emergencyNotes String?  @map("emergency_notes")
  bloodGroup     String?  @map("blood_group")
  // The ONE field a teacher of the child sees ("For teachers").
  teacherNote    String?  @map("teacher_note")
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("health_profiles")
}

// ---------- Phase 9 / CP3.2 — vaccinations (docs/modules/phase-9.md §10) ----------
//
// Read by the same people as the profile. The optional document (a card photo
// or a PDF) is a private object at schools/<school>/health/<id>.<ext>, read
// only through a short-lived signed URL. Withdrawn, never deleted.
model HealthVaccination {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  studentId    String    @map("student_id")
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  // DATE: the day it was given, a calendar day with no time of day.
  givenOn      DateTime  @map("given_on") @db.Date
  // Set when a document is attached: its real type, read from its bytes.
  documentExt  String?   @map("document_ext")
  documentSize Int?      @map("document_size")
  recordedBy   String    @map("recorded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  withdrawnAt  DateTime? @map("withdrawn_at")
  withdrawnBy  String?   @map("withdrawn_by")

  @@index([schoolId, studentId])
  @@map("health_vaccinations")
}

// Phase 9 / CP3.3 — the sickbay log (docs/modules/phase-9.md §10 CP3-D5).
// Read and written by owner, admin and the Health officer (sickbay.manage);
// never by a teacher. Withdrawn, never deleted.
model SickbayVisit {
  id              String              @id @default(uuid())
  schoolId        String              @map("school_id")
  studentId       String              @map("student_id")
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visitedAt       DateTime            @map("visited_at")
  complaint       String
  actionTaken     String?             @map("action_taken")
  sentHome        Boolean             @default(false) @map("sent_home")
  // The parent sees the complaint, action and medicine only when this is set.
  shareWithParent Boolean             @default(false) @map("share_with_parent")
  recordedBy      String              @map("recorded_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  withdrawnAt     DateTime?           @map("withdrawn_at")
  withdrawnBy     String?             @map("withdrawn_by")
  medications     SickbayMedication[]
  notices         SickbayNotice[]

  @@index([schoolId, visitedAt])
  @@index([schoolId, studentId])
  @@map("sickbay_visits")
}

model SickbayMedication {
  id        String       @id @default(uuid())
  schoolId  String       @map("school_id")
  visitId   String       @map("visit_id")
  visit     SickbayVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name      String
  dose      String
  givenAt   DateTime     @map("given_at")
  givenBy   String       @map("given_by")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([visitId])
  @@map("sickbay_medications")
}

// Once per guardian per visit (CP3-D6).
model SickbayNotice {
  id         String       @id @default(uuid())
  schoolId   String       @map("school_id")
  visitId    String       @map("visit_id")
  visit      SickbayVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  guardianId String       @map("guardian_id")
  // "PUSH", "SMS" or "NONE".
  channel    String
  sentAt     DateTime     @default(now()) @map("sent_at")

  @@unique([visitId, guardianId])
  @@map("sickbay_notices")
}

// Phase 9 / CP4 — assignments: submitted work and marking
// (docs/modules/phase-9.md §11). "Collect work" switched on for one homework
// item. Read and marked by owner, admin and the class's teachers
// (assignment.read / assignment.mark); never the bursar.
model AssignmentCollection {
  id           String                     @id @default(uuid())
  schoolId     String                     @map("school_id")
  assignmentId String                     @unique @map("assignment_id")
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  totalMarks   Int                        @map("total_marks")
  // Off once the teacher clicks "Stop accepting work".
  accepting    Boolean                    @default(true)
  // CP4b: what a good answer includes. Staff only; sent to the AI drafter.
  markingGuide String?                    @map("marking_guide")
  createdBy    String                     @map("created_by")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @default(now()) @updatedAt @map("updated_at")
  submissions  AssignmentSubmission[]
  files        AssignmentSubmissionFile[]
  questions    AssignmentQuestion[]

  @@map("assignment_collections")
}

// One row per student per attempt. A submitted attempt is final; a return
// opens the next attempt and this one is kept as it was.
model AssignmentSubmission {
  id                String                     @id @default(uuid())
  schoolId          String                     @map("school_id")
  collectionId      String                     @map("collection_id")
  collection        AssignmentCollection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  studentId         String                     @map("student_id")
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt           Int
  // Null when the attempt is files alone (CP4.2).
  body              String?
  // Q7's paste indicator, as reported by the student's own device. Shown to
  // the teacher only; never to the student or parents, never in a mark.
  typedChars        Int                        @default(0) @map("typed_chars")
  pastedChars       Int                        @default(0) @map("pasted_chars")
  submittedAt       DateTime                   @default(now()) @map("submitted_at")
  // After the due date's school day (Lagos), worked out by the server.
  late              Boolean                    @default(false)
  mark              Int?
  feedback          String?
  markedBy          String?                    @map("marked_by")
  markedAt          DateTime?                  @map("marked_at")
  // The student and parents see the mark and feedback only once released.
  releasedAt        DateTime?                  @map("released_at")
  returnedBy        String?                    @map("returned_by")
  returnedAt        DateTime?                  @map("returned_at")
  returnNote        String?                    @map("return_note")
  files             AssignmentSubmissionFile[]
  // CP4.3: the answers to the questions, keyed by question id (multiple
  // choice: the option's index; fill-in: the text), and the mark the server
  // worked out from them. The teacher gives the real mark.
  answers           Json?
  autoMark          Int?                       @map("auto_mark")
  // CP4b: the saved mark started from an AI draft (the teacher saved it).
  feedbackAiDrafted Boolean                    @default(false) @map("feedback_ai_drafted")
  feedbackDraft     AssignmentFeedbackDraft?

  @@unique([collectionId, studentId, attempt])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

// Phase 9 / CP4.2 — a photo or PDF answer (Q8). STAGED while submissionId is
// null (the student is getting ready to hand in); attached, and final, once
// the attempt is handed in. Type from the file's own bytes (F1).
model AssignmentSubmissionFile {
  id           String                @id @default(uuid())
  schoolId     String                @map("school_id")
  collectionId String                @map("collection_id")
  collection   AssignmentCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  studentId    String                @map("student_id")
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionId String?               @map("submission_id")
  submission   AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ext          String
  size         Int
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([collectionId, studentId])
  @@index([submissionId])
  @@map("assignment_submission_files")
}

// Phase 9 / CP4.3 — a question on collected work, marked automatically
// (CP4-D6). Fixed once anyone has handed in.
enum AssignmentQuestionType {
  MULTIPLE_CHOICE
  FILL_IN
}

model AssignmentQuestion {
  id               String                 @id @default(uuid())
  schoolId         String                 @map("school_id")
  collectionId     String                 @map("collection_id")
  collection       AssignmentCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  orderIndex       Int                    @map("order_index")
  type             AssignmentQuestionType
  text             String
  marks            Int
  // Multiple choice: the options' text in order, and which one is right.
  options          Json?
  correctIndex     Int?                   @map("correct_index")
  // Fill-in: every accepted answer, as the teacher typed them.
  acceptedAnswers  Json?                  @map("accepted_answers")
  // The question-bank question this was copied from. A plain column: the copy
  // stands on its own and the bank question may later be retired.
  sourceQuestionId String?                @map("source_question_id")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@unique([collectionId, orderIndex])
  @@map("assignment_questions")
}

// Phase 9 / CP4b — an AI draft of a mark and feedback, for staff only. Never a
// mark: the teacher's own "Save mark" writes that (docs/modules/phase-9.md §12).
enum AssignmentFeedbackDraftStatus {
  PENDING
  READY
  FAILED
}

model AssignmentFeedbackDraft {
  id            String                        @id @default(uuid())
  schoolId      String                        @map("school_id")
  submissionId  String                        @unique @map("submission_id")
  submission    AssignmentSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status        AssignmentFeedbackDraftStatus @default(PENDING)
  mark          Int?
  feedback      String?
  // One line for the teacher on why that mark; the student never sees it.
  reason        String?
  // Why it failed, in words a teacher can read.
  failure       String?
  promptVersion String                        @map("prompt_version")
  requestedBy   String                        @map("requested_by")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @default(now()) @updatedAt @map("updated_at")

  @@map("assignment_feedback_drafts")
}

// ---------- Phase 9 / CP5.2 — Transport ----------
//
// docs/modules/phase-9.md §13 CP5-D7/D8. Vehicles, drivers, routes with ordered
// stops, and each student's place on one route and stop per term. A place
// raises a TRANSPORT student charge at the route's fee, through
// StudentChargeService only (source "transport", the assignment's id). A
// route takes no more children in a term than its vehicle has seats.

model TransportVehicle {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  plate       String // normalised upper case, unique per school
  description String?
  seats       Int
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  routes      TransportRoute[]

  @@unique([schoolId, plate])
  @@map("transport_vehicles")
}

model TransportDriver {
  id            String           @id @default(uuid())
  schoolId      String           @map("school_id")
  name          String
  phone         String
  licenceNumber String?          @map("licence_number")
  licenceExpiry DateTime?        @map("licence_expiry") @db.Date
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  routes        TransportRoute[]

  @@index([schoolId])
  @@map("transport_drivers")
}

model TransportRoute {
  id          String                @id @default(uuid())
  schoolId    String                @map("school_id")
  name        String
  vehicleId   String?               @map("vehicle_id")
  driverId    String?               @map("driver_id")
  // Per term, in kobo. 0 = free: no charge is raised.
  fee         Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  vehicle     TransportVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver      TransportDriver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  stops       TransportStop[]
  assignments TransportAssignment[]

  @@unique([schoolId, name])
  @@map("transport_routes")
}

model TransportStop {
  id           String                @id @default(uuid())
  schoolId     String                @map("school_id")
  routeId      String                @map("route_id")
  name         String
  position     Int
  // Minutes since midnight, school wall-clock time (CLAUDE.md time-of-day rule).
  pickupMinute Int?                  @map("pickup_minute")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  route        TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments  TransportAssignment[]

  @@index([routeId, position])
  @@map("transport_stops")
}

model TransportAssignment {
  id        String         @id @default(uuid())
  schoolId  String         @map("school_id")
  studentId String         @map("student_id")
  termId    String         @map("term_id")
  routeId   String         @map("route_id")
  stopId    String         @map("stop_id")
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop      TransportStop  @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId])
  @@index([schoolId, routeId, termId])
  @@map("transport_assignments")
}

// ─── Phase 9 / CP6 — the library ────────────────────────────────────────────
// A book, its physical copies (accession number unique in the school) and
// loans to a student OR a member of staff. One open loan per copy, by a partial
// unique index in the migration (library_loans_open_copy_key). Fines are
// student charges (F2), never written here. docs/modules/phase-9.md §14.

enum LibraryCopyStatus {
  AVAILABLE
  ON_LOAN
  LOST
  WITHDRAWN
}

model LibrarySettings {
  id            String   @id @default(uuid())
  schoolId      String   @unique @map("school_id")
  loanDays      Int      @default(14) @map("loan_days")
  studentLimit  Int      @default(2) @map("student_limit")
  staffLimit    Int      @default(5) @map("staff_limit")
  renewalLimit  Int      @default(2) @map("renewal_limit")
  nextAccession Int      @default(1) @map("next_accession")
  finesEnabled  Boolean  @default(false) @map("fines_enabled") // CP6.2
  finePerDay    Int      @default(0) @map("fine_per_day") // kobo
  fineGraceDays Int      @default(0) @map("fine_grace_days")
  fineCap       Int?     @map("fine_cap") // kobo; null: no cap
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("library_settings")
}

model LibraryBook {
  id               String             @id @default(uuid())
  schoolId         String             @map("school_id")
  title            String
  authors          String?
  isbn             String?
  publisher        String?
  publishedYear    Int?               @map("published_year")
  subjectId        String?            @map("subject_id")
  shelfLocation    String?            @map("shelf_location")
  replacementPrice Int?               @map("replacement_price") // kobo
  referenceOnly    Boolean            @default(false) @map("reference_only")
  createdBy        String?            @map("created_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  subject          Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  levels           LibraryBookLevel[]
  copies           LibraryCopy[]

  @@index([schoolId, title])
  @@map("library_books")
}

model LibraryBookLevel {
  schoolId     String      @map("school_id")
  bookId       String      @map("book_id")
  classLevelId String      @map("class_level_id")
  book         LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel  @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@id([bookId, classLevelId])
  @@index([schoolId])
  @@map("library_book_levels")
}

model LibraryCopy {
  id              String            @id @default(uuid())
  schoolId        String            @map("school_id")
  bookId          String            @map("book_id")
  accessionNumber String            @map("accession_number") // upper case
  status          LibraryCopyStatus @default(AVAILABLE)
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  book            LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans           LibraryLoan[]

  @@unique([schoolId, accessionNumber])
  @@index([bookId])
  @@map("library_copies")
}

model LibraryLoan {
  id               String      @id @default(uuid())
  schoolId         String      @map("school_id")
  copyId           String      @map("copy_id")
  studentId        String?     @map("student_id") // exactly one of studentId, userId
  userId           String?     @map("user_id")
  issuedAt         DateTime    @default(now()) @map("issued_at")
  dueOn            DateTime    @map("due_on") @db.Date
  renewals         Int         @default(0)
  returnedAt       DateTime?   @map("returned_at")
  lostAt           DateTime?   @map("lost_at") // CP6.2; a lost loan is closed
  foundAt          DateTime?   @map("found_at")
  fineAmount       Int?        @map("fine_amount") // kobo: the fine, or the replacement price
  fineWaivedReason String?     @map("fine_waived_reason")
  fineWaivedBy     String?     @map("fine_waived_by")
  issuedBy         String?     @map("issued_by")
  returnedBy       String?     @map("returned_by")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  copy             LibraryCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  student          Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, returnedAt])
  @@index([studentId])
  @@index([userId])
  @@map("library_loans")
}

// Phase 9 / CP6.3 — digital resources: a PDF (F1, private) or an https link
// for one subject and some class levels, read by students in those levels.
enum LibraryResourceKind {
  FILE
  LINK
}

model LibraryResource {
  id          String                 @id @default(uuid())
  schoolId    String                 @map("school_id")
  title       String
  description String?
  subjectId   String                 @map("subject_id")
  kind        LibraryResourceKind
  url         String? // LINK only, https
  fileExt     String?                @map("file_ext") // FILE only: "pdf"
  fileSize    Int?                   @map("file_size")
  addedBy     String                 @map("added_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  levels      LibraryResourceLevel[]

  @@index([schoolId, subjectId])
  @@map("library_resources")
}

model LibraryResourceLevel {
  schoolId     String          @map("school_id")
  resourceId   String          @map("resource_id")
  classLevelId String          @map("class_level_id")
  resource     LibraryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@id([resourceId, classLevelId])
  @@index([schoolId, classLevelId])
  @@map("library_resource_levels")
}

// ─── Phase 9 / CP6b — hostels and boarding ──────────────────────────────────
// A hostel is for boys or girls, with house masters and a fee per term that
// stands until changed. A student holds one bed a term (that makes them a
// boarder); a bed holds one student a term. The HOSTEL charge is raised through
// StudentChargeService only. docs/modules/phase-9.md §15.

enum HostelGender {
  BOYS
  GIRLS
}

model Hostel {
  id           String              @id @default(uuid())
  schoolId     String              @map("school_id")
  name         String
  forGender    HostelGender        @map("for_gender")
  fee          Int                 @default(0) // kobo per term; 0 is none
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  houseMasters HostelHouseMaster[]
  rooms        HostelRoom[]
  beds         HostelBed[]
  visits       HostelVisit[]
  exeats       HostelExeat[]

  @@unique([schoolId, name])
  @@map("hostels")
}

model HostelHouseMaster {
  schoolId  String   @map("school_id")
  hostelId  String   @map("hostel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([hostelId, userId])
  @@index([schoolId, userId])
  @@map("hostel_house_masters")
}

model HostelRoom {
  id        String      @id @default(uuid())
  schoolId  String      @map("school_id")
  hostelId  String      @map("hostel_id")
  name      String
  beds      Int
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  hostel    Hostel      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocated HostelBed[]

  @@unique([hostelId, name])
  @@index([schoolId])
  @@map("hostel_rooms")
}

model HostelBed {
  id        String     @id @default(uuid())
  schoolId  String     @map("school_id")
  studentId String     @map("student_id")
  termId    String     @map("term_id")
  hostelId  String     @map("hostel_id")
  roomId    String     @map("room_id")
  bedNumber Int        @map("bed_number")
  createdBy String?    @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel    Hostel     @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  room      HostelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId])
  @@unique([roomId, termId, bedNumber])
  @@index([schoolId, hostelId, termId])
  @@map("hostel_beds")
}

// Phase 9 / CP6b.2 — the visitor log (§15 CP6b-D5). House master and admin
// only; parents do not see it (owner, §15.8).
model HostelVisit {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  hostelId     String    @map("hostel_id")
  studentId    String    @map("student_id")
  visitorName  String    @map("visitor_name")
  relationship String
  phone        String?
  arrivedAt    DateTime  @map("arrived_at")
  leftAt       DateTime? @map("left_at")
  loggedBy     String    @map("logged_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  hostel       Hostel    @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, hostelId, arrivedAt])
  @@index([schoolId, studentId])
  @@map("hostel_visits")
}

enum HostelExeatStatus {
  REQUESTED
  APPROVED
  REFUSED
  OUT
  BACK
  CANCELLED
}

// Phase 9 / CP6b.3 — a boarder's leave out (§15 CP6b-D6). Asked by a parent or
// entered by the school (exactly one of the two requester columns); decided by
// the house master; left and back logged on the day.
model HostelExeat {
  id                    String            @id @default(uuid())
  schoolId              String            @map("school_id")
  hostelId              String            @map("hostel_id")
  studentId             String            @map("student_id")
  outAt                 DateTime          @map("out_at")
  backBy                DateTime          @map("back_by")
  reason                String
  collectorName         String            @map("collector_name")
  collectorRelationship String            @map("collector_relationship")
  collectorPhone        String            @map("collector_phone")
  status                HostelExeatStatus @default(REQUESTED)
  requestedByGuardianId String?           @map("requested_by_guardian_id")
  requestedByUserId     String?           @map("requested_by_user_id")
  decidedBy             String?           @map("decided_by")
  decidedAt             DateTime?         @map("decided_at")
  decisionNote          String?           @map("decision_note")
  leftAt                DateTime?         @map("left_at")
  collectedBy           String?           @map("collected_by")
  backAt                DateTime?         @map("back_at")
  cancelledAt           DateTime?         @map("cancelled_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  hostel                Hostel            @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  student               Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, hostelId, status])
  @@index([schoolId, studentId])
  @@map("hostel_exeats")
}

// ---------- Phase 9 / CP7 — online admission applications (§16, §16.8) ----------

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  OFFERED
  OFFER_ACCEPTED
  ADMITTED
  REJECTED
  WITHDRAWN
}

// One row per school, written on first save. Until then the defaults apply,
// and applications are OPEN (owner, §16.8).
model AdmissionSettings {
  id                  String   @id @default(uuid())
  schoolId            String   @unique @map("school_id")
  enabled             Boolean  @default(true)
  intro               String?
  smsAlerts           Boolean  @default(true) @map("sms_alerts")
  notifyEmail         String?  @map("notify_email")
  offerLetter         String?  @map("offer_letter")
  form                Json     @default("{}")
  closedClassLevelIds Json     @default("[]") @map("closed_class_level_ids")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("admission_settings")
}

model AdmissionApplication {
  id                   String              @id @default(uuid())
  schoolId             String              @map("school_id")
  reference            String
  classLevelId         String              @map("class_level_id")
  childFirstName       String              @map("child_first_name")
  childLastName        String              @map("child_last_name")
  dateOfBirth          DateTime            @map("date_of_birth") @db.Date
  gender               Gender
  guardianFirstName    String              @map("guardian_first_name")
  guardianLastName     String              @map("guardian_last_name")
  guardianRelationship Relationship        @map("guardian_relationship")
  guardianPhone        String              @map("guardian_phone")
  guardianEmail        String              @map("guardian_email")
  answers              Json                @default("{}")
  status               AdmissionStatus     @default(SUBMITTED)
  statusChangedAt      DateTime            @default(now()) @map("status_changed_at")
  consentAt            DateTime            @map("consent_at")
  consentVersion       String              @map("consent_version")
  trackingTokenHash    String              @unique @map("tracking_token_hash")
  studentId            String?             @map("student_id")
  /// CP7.2: ENTRANCE_EXAM, INTERVIEW, ONLINE or OTHER, with its time and note.
  assessmentKind       String?             @map("assessment_kind")
  assessmentAt         DateTime?           @map("assessment_at")
  assessmentNote       String?             @map("assessment_note")
  /// The offer letter the family saw, in full.
  offerLetter          String?             @map("offer_letter")
  offeredAt            DateTime?           @map("offered_at")
  acceptedAt           DateTime?           @map("accepted_at")
  /// Who recorded the acceptance; NULL means the family accepted online.
  acceptedByUserId     String?             @map("accepted_by_user_id")
  decisionNote         String?             @map("decision_note")
  admittedAt           DateTime?           @map("admitted_at")
  admittedByUserId     String?             @map("admitted_by_user_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  classLevel           ClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  student              Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  documents            AdmissionDocument[]

  @@unique([schoolId, reference])
  @@index([schoolId, status])
  @@index([schoolId, guardianEmail])
  @@map("admission_applications")
}

model AdmissionDocument {
  id            String               @id @default(uuid())
  schoolId      String               @map("school_id")
  applicationId String               @map("application_id")
  slot          String
  label         String
  ext           String
  sizeBytes     Int                  @map("size_bytes")
  createdAt     DateTime             @default(now()) @map("created_at")
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, slot])
  @@map("admission_documents")
}

model AdmissionReferenceCounter {
  schoolId String @map("school_id")
  year     Int
  next     Int    @default(1)

  @@id([schoolId, year])
  @@map("admission_reference_counters")
}

model AdmissionSmsCounter {
  schoolId String   @map("school_id")
  day      DateTime @db.Date
  sent     Int      @default(0)

  @@id([schoolId, day])
  @@map("admission_sms_counters")
}

// ─── Phase 9 / CP8.1 — private messaging (docs/modules/phase-9.md §17.8) ──
// A parent writes to ONE recipient about one child or in general; only that
// recipient, anyone it is passed to and anyone who has written in it see it.

enum MessageRecipient {
  CLASS_TEACHER
  BURSAR
  PRINCIPAL
  HEAD_TEACHER
  ADMIN
  OFFICE
}

model MessageThread {
  id              String           @id @default(uuid())
  schoolId        String           @map("school_id")
  guardianId      String           @map("guardian_id")
  studentId       String?          @map("student_id")
  recipient       MessageRecipient
  /// The class teacher addressed, for CLASS_TEACHER only, fixed at the start.
  recipientUserId String?          @map("recipient_user_id")
  subject         String
  status          String           @default("OPEN")
  /// NULL: the guardian started it; otherwise the office member who did.
  startedByUserId String?          @map("started_by_user_id")
  lastMessageAt   DateTime         @default(now()) @map("last_message_at")
  lastMessageBy   String           @map("last_message_by")
  handledByUserId String?          @map("handled_by_user_id")
  closedAt        DateTime?        @map("closed_at")
  closedByUserId  String?          @map("closed_by_user_id")
  /// CP8.2: a report, a staff flag or a safeguarding word. Opens the
  /// conversation to owner and admins and keeps it until cleared.
  flaggedAt       DateTime?        @map("flagged_at")
  flagReason      String?          @map("flag_reason")
  flagNote        String?          @map("flag_note")
  flaggedByKind   String?          @map("flagged_by_kind")
  flaggedById     String?          @map("flagged_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  guardian        Guardian         @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  messages        Message[]
  passes          MessagePass[]
  reads           MessageRead[]

  @@index([schoolId, status, lastMessageAt])
  @@index([schoolId, guardianId])
  @@index([schoolId, recipient])
  @@index([recipientUserId])
  @@index([schoolId, flaggedAt])
  @@map("message_threads")
}

model MessagePass {
  id              String           @id @default(uuid())
  schoolId        String           @map("school_id")
  threadId        String           @map("thread_id")
  recipient       MessageRecipient
  recipientUserId String?          @map("recipient_user_id")
  passedByUserId  String           @map("passed_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  thread          MessageThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([schoolId, recipient])
  @@map("message_passes")
}

model Message {
  id                String            @id @default(uuid())
  schoolId          String            @map("school_id")
  threadId          String            @map("thread_id")
  authorKind        String            @map("author_kind")
  guardianId        String?           @map("guardian_id")
  userId            String?           @map("user_id")
  /// For a staff message, the recipient the writer answered as.
  asRecipient       MessageRecipient? @map("as_recipient")
  body              String
  /// CP8.2: the text matched a safeguarding word.
  safeguardingMatch Boolean           @default(false) @map("safeguarding_match")
  createdAt         DateTime          @default(now()) @map("created_at")
  thread            MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  images            MessageImage[]

  @@index([threadId, createdAt])
  @@index([schoolId, guardianId, createdAt])
  @@map("messages")
}

model MessageRead {
  schoolId   String        @map("school_id")
  threadId   String        @map("thread_id")
  readerKind String        @map("reader_kind")
  readerId   String        @map("reader_id")
  lastReadAt DateTime      @map("last_read_at")
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, readerKind, readerId])
  @@map("message_reads")
}

model MessageSmsCounter {
  schoolId String   @map("school_id")
  day      DateTime @db.Date
  sent     Int      @default(0)

  @@id([schoolId, day])
  @@map("message_sms_counters")
}

/// CP8.2: an image on a message. Staged (no message) until the message is sent.
model MessageImage {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  messageId    String?  @map("message_id")
  uploaderKind String   @map("uploader_kind")
  uploaderId   String   @map("uploader_id")
  ext          String
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([schoolId, uploaderKind, uploaderId])
  @@map("message_images")
}

// Phase 9 / CP8.3 — one announcement email to one address
// (docs/modules/phase-9.md §17.11). Claimed once (QUEUED → SENDING), so a
// retried job never sends twice. Webhook events move SENT to DELIVERED,
// BOUNCED or COMPLAINED.
model AnnouncementEmail {
  id             String       @id @default(uuid())
  schoolId       String       @map("school_id")
  announcementId String       @map("announcement_id")
  guardianId     String?      @map("guardian_id")
  email          String
  status         String
  skipReason     String?      @map("skip_reason")
  providerId     String?      @unique @map("provider_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  sentAt         DateTime?    @map("sent_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  guardian       Guardian?    @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@unique([announcementId, email])
  @@index([schoolId, announcementId, status])
  @@map("announcement_emails")
}

// An address that gets no more announcement emails (ANNOUNCEMENTS: it
// unsubscribed) or no non-essential email at all (ALL: a hard bounce or a
// complaint), from one school.
model EmailSuppression {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  email     String
  reason    String
  scope     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([schoolId, email, scope])
  @@map("email_suppressions")
}

// Announcement emails a school has sent in a Lagos day, against its plan's limit.
model AnnouncementEmailCounter {
  schoolId String   @map("school_id")
  day      DateTime @db.Date
  sent     Int      @default(0)

  @@id([schoolId, day])
  @@map("announcement_email_counters")
}

// Phase 9 / CP10.1 — one parent's answer to an event (docs/modules/phase-9.md §19.2).
model EventRsvp {
  id         String      @id @default(uuid())
  schoolId   String      @map("school_id")
  eventId    String      @map("event_id")
  guardianId String      @map("guardian_id")
  answer     String
  attending  Int?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")
  event      SchoolEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guardian   Guardian    @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([eventId, guardianId])
  @@index([schoolId, eventId])
  @@map("event_rsvps")
}

// ---------- ID cards (2026-10-19, docs/modules/id-cards-and-store.md §3) ----------

enum IdCardHolderKind {
  STUDENT
  STAFF
}

enum IdCardStatus {
  ACTIVE
  CANCELLED
  REPLACED
}

// One row per card issued. Reissuing marks the old row REPLACED. Plain FKs.
model IdCard {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  holderKind     IdCardHolderKind @map("holder_kind")
  studentId      String?          @map("student_id")
  userId         String?          @map("user_id")
  academicYearId String           @map("academic_year_id")
  cardNumber     String           @map("card_number")
  status         IdCardStatus     @default(ACTIVE)
  issuedBy       String           @map("issued_by")
  issuedAt       DateTime         @default(now()) @map("issued_at")
  endedAt        DateTime?        @map("ended_at")
  endedBy        String?          @map("ended_by")
  endReason      String?          @map("end_reason")
  replacedById   String?          @map("replaced_by_id")

  @@unique([schoolId, cardNumber])
  @@index([schoolId, academicYearId])
  @@index([studentId])
  @@index([userId])
  @@map("id_cards")
}

// ---------- The Store and fixed assets (2026-10-19, docs/modules/id-cards-and-store.md §4) ----------

enum StoreCategory {
  UNIFORM
  TEXTBOOK
  STATIONERY
  LABORATORY
  SPORTS
  ICT
  CLEANING
  KITCHEN
  OTHER
}

enum StoreMovementKind {
  RECEIVE
  ISSUE
  SELL
  RETURN
  WRITE_OFF
  ADJUST
}

enum StoreStockTakeStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

enum FixedAssetCategory {
  ICT
  FURNITURE
  LABORATORY
  SPORTS
  AUDIO_VISUAL
  VEHICLE
  KITCHEN
  BUILDING
  OTHER
}

enum FixedAssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  BROKEN
}

enum FixedAssetStatus {
  IN_USE
  IN_STORE
  UNDER_REPAIR
  DISPOSED
}

enum FixedAssetEventKind {
  ADDED
  MOVED
  ASSIGNED
  CONDITION
  STATUS
  EDITED
}

// What the store holds. Stock is kept per variant (a size, or one unnamed).
// The code is unique per school ignoring case (an expression index in SQL).
model StoreItem {
  id           String        @id @default(uuid())
  schoolId     String        @map("school_id")
  name         String
  code         String?
  category     StoreCategory
  unit         String        @default("piece")
  reorderLevel Int           @default(0) @map("reorder_level")
  sellPrice    Int?          @map("sell_price") // kobo
  notes        String?
  isActive     Boolean       @default(true) @map("is_active")
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  variants   StoreItemVariant[]
  movements  StoreMovement[]
  packItems  StorePackItem[]
  orderLines StoreOrderLine[]

  @@unique([schoolId, id])
  @@map("store_items")
}

model StoreItemVariant {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  itemId    String   @map("item_id")
  label     String?
  sellPrice Int?     @map("sell_price") // kobo, overrides the item's
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  item          StoreItem            @relation(fields: [schoolId, itemId], references: [schoolId, id], onDelete: Cascade)
  movements     StoreMovement[]
  stockTakeRows StoreStockTakeLine[]
  orderLines    StoreOrderLine[]

  @@unique([schoolId, id])
  @@map("store_item_variants")
}

// The ledger: append-only (a trigger refuses UPDATE and DELETE).
model StoreMovement {
  id              String            @id @default(uuid())
  schoolId        String            @map("school_id")
  variantId       String            @map("variant_id")
  itemId          String            @map("item_id")
  kind            StoreMovementKind
  quantity        Int // signed: + in, - out
  unitCost        Int?              @map("unit_cost") // kobo
  unitPrice       Int?              @map("unit_price") // kobo
  studentId       String?           @map("student_id")
  userId          String?           @map("user_id")
  department      String?
  supplier        String?
  reference       String?
  reason          String?
  studentChargeId String?           @map("student_charge_id")
  stockTakeId     String?           @map("stock_take_id")
  // Store orders (2026-11-11): the order line this hand-over belongs to.
  orderLineId     String?           @map("order_line_id")
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")

  variant   StoreItemVariant @relation(fields: [schoolId, variantId], references: [schoolId, id])
  item      StoreItem        @relation(fields: [schoolId, itemId], references: [schoolId, id])
  orderLine StoreOrderLine?  @relation(fields: [schoolId, orderLineId], references: [schoolId, id])

  @@index([variantId])
  @@index([orderLineId])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@map("store_movements")
}

model StoreStockTake {
  id          String               @id @default(uuid())
  schoolId    String               @map("school_id")
  status      StoreStockTakeStatus @default(OPEN)
  note        String?
  createdBy   String               @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  submittedBy String?              @map("submitted_by")
  submittedAt DateTime?            @map("submitted_at")
  decidedBy   String?              @map("decided_by")
  decidedAt   DateTime?            @map("decided_at")

  lines StoreStockTakeLine[]

  @@unique([schoolId, id])
  @@map("store_stock_takes")
}

model StoreStockTakeLine {
  id          String @id @default(uuid())
  schoolId    String @map("school_id")
  stockTakeId String @map("stock_take_id")
  variantId   String @map("variant_id")
  expected    Int?
  counted     Int?

  stockTake StoreStockTake   @relation(fields: [schoolId, stockTakeId], references: [schoolId, id], onDelete: Cascade)
  variant   StoreItemVariant @relation(fields: [schoolId, variantId], references: [schoolId, id], onDelete: Cascade)

  @@unique([stockTakeId, variantId])
  @@map("store_stock_take_lines")
}

model FixedAsset {
  id               String              @id @default(uuid())
  schoolId         String              @map("school_id")
  tag              String
  name             String
  category         FixedAssetCategory
  location         String?
  assignedToUserId String?             @map("assigned_to_user_id")
  assignedToText   String?             @map("assigned_to_text")
  condition        FixedAssetCondition @default(GOOD)
  status           FixedAssetStatus    @default(IN_USE)
  serialNumber     String?             @map("serial_number")
  supplier         String?
  purchaseDate     DateTime?           @map("purchase_date") @db.Date
  purchaseCost     Int?                @map("purchase_cost") // kobo
  notes            String?
  disposedAt       DateTime?           @map("disposed_at") @db.Date
  disposalReason   String?             @map("disposal_reason")
  createdBy        String              @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  events FixedAssetEvent[]

  @@unique([schoolId, id])
  @@map("fixed_assets")
}

model FixedAssetEvent {
  id        String              @id @default(uuid())
  schoolId  String              @map("school_id")
  assetId   String              @map("asset_id")
  kind      FixedAssetEventKind
  fromValue String?             @map("from_value")
  toValue   String?             @map("to_value")
  note      String?
  createdBy String              @map("created_by")
  createdAt DateTime            @default(now()) @map("created_at")

  asset FixedAsset @relation(fields: [schoolId, assetId], references: [schoolId, id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("fixed_asset_events")
}

// ─── The school's public website (2026-10-22, docs/modules/school-website.md)

// One row per school: the page details as the editor last saved them (draft)
// and as families see them (published). Both are the checked shape of
// websiteDetailsSchema in @school-kit/types.
model SchoolWebsite {
  id          String    @id @default(uuid())
  schoolId    String    @unique @map("school_id")
  draft       Json      @default("{}")
  published   Json?
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  @@map("school_websites")
}

enum WebsitePostStatus {
  DRAFT
  PUBLISHED

  @@map("website_post_status")
}

// News posts: public only, never sent to phones (announcements do that).
model SchoolWebsitePost {
  id             String            @id @default(uuid())
  schoolId       String            @map("school_id")
  title          String
  body           String
  status         WebsitePostStatus @default(DRAFT)
  publishedAt    DateTime?         @map("published_at")
  createdBy      String            @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  // SchoolKit's take-down: hidden, and the school cannot republish it.
  takenDownAt    DateTime?         @map("taken_down_at")
  takenDownBy    String?           @map("taken_down_by")
  takeDownReason String?           @map("take_down_reason")

  photos SchoolWebsitePhoto[]

  @@index([schoolId, status, publishedAt])
  @@map("school_website_posts")
}

model SchoolWebsiteAlbum {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  photos SchoolWebsitePhoto[]

  @@index([schoolId])
  @@map("school_website_albums")
}

enum WebsitePhotoKind {
  COVER
  POST
  GALLERY
  LEADER

  @@map("website_photo_kind")
}

// Every photo on the website. Two JPEGs in storage (large, thumb). The
// uploader's "This photo shows no pupils" tick is recorded with who gave it
// (W4: no pupils on public pages); there is no photo without one.
model SchoolWebsitePhoto {
  id                  String           @id @default(uuid())
  schoolId            String           @map("school_id")
  kind                WebsitePhotoKind
  postId              String?          @map("post_id")
  albumId             String?          @map("album_id")
  caption             String?
  position            Int              @default(0)
  noPupilsConfirmedBy String           @map("no_pupils_confirmed_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  takenDownAt         DateTime?        @map("taken_down_at")
  takenDownBy         String?          @map("taken_down_by")
  takeDownReason      String?          @map("take_down_reason")

  post  SchoolWebsitePost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  album SchoolWebsiteAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([schoolId, kind])
  @@index([postId])
  @@map("school_website_photos")
}

// "Report this photo" from the public page. Read by SchoolKit's operator.
model SchoolWebsiteReport {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  photoId    String?   @map("photo_id")
  postId     String?   @map("post_id")
  reason     String
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")
  // TAKEN_DOWN or DISMISSED.
  resolution String?

  @@index([schoolId, resolvedAt])
  @@map("school_website_reports")
}

// A request, from the app, to delete a person's account (2026-10-24). The app
// stores need one; deleting is the school's call, because the school holds
// the records, so this only tells the school. One open request per person.
model AccountDeletionRequest {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  // STAFF, GUARDIAN or STUDENT (CHECK in the migration).
  principal   String
  // users.id, guardians.id or students.id, by `principal`.
  subjectId   String    @map("subject_id")
  requestedAt DateTime  @default(now()) @map("requested_at")
  handledAt   DateTime? @map("handled_at")
  handledBy   String?   @map("handled_by")

  @@index([schoolId, handledAt])
  @@map("account_deletion_requests")
}

// A school's request for a setup call with the SchoolKit team (2026-10-26,
// docs/modules/onboarding-call.md). Booked from the page shown after the setup
// wizard; the team confirms the time on WhatsApp and marks it done in the
// platform admin.
model OnboardingCallBooking {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  bookedBy     String    @map("booked_by")
  // The day, Lagos time, and the start as minutes since midnight (CLAUDE.md:
  // time of day is an Int, never @db.Time).
  callDate     DateTime  @map("call_date") @db.Date
  startMinute  Int       @map("start_minute")
  contactName  String    @map("contact_name")
  contactPhone String    @map("contact_phone")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  doneAt       DateTime? @map("done_at")

  @@index([schoolId, createdAt])
  @@map("onboarding_call_bookings")
}

// Getting started (2026-10-30, docs/modules/activation.md): a setup reminder
// sent to a school's owner, at most one of each kind. status is Resend's
// (SENT, then DELIVERED, BOUNCED or COMPLAINED; FAILED when the send itself
// failed). Clicks are counted by the API's own redirect. stageAtSend (1-6) is
// the school's stage when it went, to show whether it moved on afterwards.
model ActivationEmail {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  kind           String
  toEmail        String    @map("to_email")
  providerId     String?   @map("provider_id")
  stageAtSend    Int       @map("stage_at_send")
  status         String    @default("SENT")
  sentAt         DateTime  @default(now()) @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  firstClickedAt DateTime? @map("first_clicked_at")
  clickCount     Int       @default(0) @map("click_count")

  @@unique([schoolId, kind])
  @@index([schoolId, providerId])
  @@map("activation_emails")
}

// Subjects by class (2026-11-02, docs/modules/subjects-by-class.md): a subject
// hidden from results. While a hide applies, the subject shows on no report
// card, broadsheet, portal or result checker and counts in no total, average
// or position; scores are kept. scope: ARM (class_arm_id), LEVEL
// (class_level_id) or SCHOOL. until: TERM (term_id only), YEAR (the term's
// academic year) or INDEFINITE. Unhiding stamps unhidden_at; rows are kept
// for the record.
model SubjectHide {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  subjectId      String    @map("subject_id")
  scope          String // ARM | LEVEL | SCHOOL
  classArmId     String?   @map("class_arm_id")
  classLevelId   String?   @map("class_level_id")
  until          String // TERM | YEAR | INDEFINITE
  termId         String    @map("term_id")
  academicYearId String    @map("academic_year_id")
  hiddenBy       String    @map("hidden_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  unhiddenAt     DateTime? @map("unhidden_at")
  unhiddenBy     String?   @map("unhidden_by")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([schoolId, unhiddenAt])
  @@index([subjectId])
  @@map("subject_hides")
}

// Operational invoice proposals. No conversation transcript or model text.
// Plain school/user references follow Invoice's immutable audit convention.
model AssistantBillingRun {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  requestedBy String    @map("requested_by")
  approvedBy  String?   @map("approved_by")
  status      String    @default("PENDING")
  payload     Json
  previewHash String    @map("preview_hash")
  result      Json?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  approvedAt  DateTime? @map("approved_at")

  @@index([schoolId, createdAt(sort: Desc)])
  @@map("assistant_billing_runs")
}

// Server-owned workflow proposals (2026-11-09, docs/modules/student-intake-proposals.md).
// A prepared, reviewed batch of operational work, confirmed by a person and
// executed once. Kind-tagged so later workflows reuse it; the first kind is
// "student-intake". `payload` holds the operational rows only while they are
// needed (until completion or expiry) and is then cleared; `summary`, `result`
// and the fingerprints are metadata. No model text or chat lives here.
model WorkflowProposal {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  kind            String
  requestedBy     String    @map("requested_by")
  confirmedBy     String?   @map("confirmed_by")
  status          String    @default("PENDING")
  clientRequestId String    @map("client_request_id")
  requestHash     String    @map("request_hash")
  previewHash     String    @map("preview_hash")
  payload         Json?
  summary         Json
  result          Json?
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  confirmedAt     DateTime? @map("confirmed_at")
  dataClearedAt   DateTime? @map("data_cleared_at")

  @@unique([schoolId, kind, requestedBy, clientRequestId], map: "workflow_proposals_client_request_key")
  @@index([schoolId, kind, createdAt(sort: Desc)])
  @@map("workflow_proposals")
}

// Durable fee reminder campaigns (2026-11-09, docs/modules/reminder-campaigns.md).
// Created by confirming a reviewed workflow proposal; its sends are an outbox
// holding ids and states only, never contact details, text or amounts.
model ReminderCampaign {
  id                  String                 @id @default(uuid())
  schoolId            String                 @map("school_id")
  proposalId          String                 @unique @map("proposal_id")
  termId              String                 @map("term_id")
  requestedBy         String                 @map("requested_by")
  confirmedBy         String                 @map("confirmed_by")
  status              String                 @default("RUNNING")
  haltReason          String?                @map("halt_reason")
  templateVersion     String                 @map("template_version")
  includePaymentPlans Boolean                @map("include_payment_plans")
  overdueOnly         Boolean                @map("overdue_only")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @default(now()) @map("updated_at")
  haltedAt            DateTime?              @map("halted_at")
  completedAt         DateTime?              @map("completed_at")
  sends               ReminderCampaignSend[]

  @@index([schoolId, status])
  @@map("reminder_campaigns")
}

model ReminderCampaignSend {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  campaignId  String           @map("campaign_id")
  studentId   String           @map("student_id")
  guardianId  String           @map("guardian_id")
  channel     String
  channelUsed String?          @map("channel_used")
  status      String           @default("PENDING")
  reason      String?
  claimToken  String?          @map("claim_token")
  claimedAt   DateTime?        @map("claimed_at")
  finishedAt  DateTime?        @map("finished_at")
  providerRef String?          @map("provider_ref")
  createdAt   DateTime         @default(now()) @map("created_at")
  campaign    ReminderCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, studentId, channel, guardianId], map: "reminder_campaign_sends_slot_key")
  @@index([schoolId, campaignId, status])
  @@map("reminder_campaign_sends")
}

// ---------- Store orders (2026-11-11, docs/modules/store-orders.md) ----------
//
// One buyer, many lines, one total. Students are billed on the fees invoice
// (charges) or on a store invoice of their own; staff and walk-in buyers pay at
// the counter. Stock leaves at hand-over, as a SELL movement tied to the line.

enum StoreOrderBuyer {
  STUDENT
  STAFF
  WALK_IN
}

enum StoreOrderBilling {
  FEES_INVOICE
  STORE_INVOICE
  COUNTER
}

enum StoreOrderStatus {
  ACTIVE
  CANCELLED
}

model StorePack {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items  StorePackItem[]
  orders StoreOrder[]

  @@unique([schoolId, id])
  @@map("store_packs")
}

model StorePackItem {
  id       String @id @default(uuid())
  schoolId String @map("school_id")
  packId   String @map("pack_id")
  itemId   String @map("item_id")
  quantity Int

  pack StorePack @relation(fields: [schoolId, packId], references: [schoolId, id], onDelete: Cascade)
  item StoreItem @relation(fields: [schoolId, itemId], references: [schoolId, id], onDelete: Cascade)

  @@map("store_pack_items")
}

model StoreOrder {
  id               String            @id @default(uuid())
  schoolId         String            @map("school_id")
  number           Int
  buyer            StoreOrderBuyer
  studentId        String?           @map("student_id")
  userId           String?           @map("user_id")
  buyerName        String?           @map("buyer_name")
  billing          StoreOrderBilling
  status           StoreOrderStatus  @default(ACTIVE)
  total            Int // kobo
  termId           String?           @map("term_id")
  invoiceId        String?           @map("invoice_id")
  counterMethod    PaymentMethod?    @map("counter_method")
  counterReference String?           @map("counter_reference")
  packId           String?           @map("pack_id")
  classSaleId      String?           @map("class_sale_id")
  note             String?
  idempotencyKey   String?           @map("idempotency_key")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  cancelledBy      String?           @map("cancelled_by")
  cancelledAt      DateTime?         @map("cancelled_at")
  cancelReason     String?           @map("cancel_reason")

  pack  StorePack?       @relation(fields: [schoolId, packId], references: [schoolId, id])
  lines StoreOrderLine[]

  @@unique([schoolId, id])
  @@unique([schoolId, number])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@index([classSaleId])
  @@map("store_orders")
}

model StoreOrderLine {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  orderId   String   @map("order_id")
  itemId    String   @map("item_id")
  variantId String   @map("variant_id")
  quantity  Int
  unitPrice Int      @map("unit_price") // kobo
  amount    Int // kobo
  collected Int      @default(0)
  chargeId  String?  @map("charge_id")
  createdAt DateTime @default(now()) @map("created_at")

  order     StoreOrder       @relation(fields: [schoolId, orderId], references: [schoolId, id])
  item      StoreItem        @relation(fields: [schoolId, itemId], references: [schoolId, id])
  variant   StoreItemVariant @relation(fields: [schoolId, variantId], references: [schoolId, id])
  movements StoreMovement[]

  @@unique([schoolId, id])
  @@index([orderId])
  @@index([variantId])
  @@map("store_order_lines")
}
