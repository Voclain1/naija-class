// School Kit — Prisma schema (Phase 0)
//
// Models below mirror docs/modules/phase-0.md verbatim. Tenancy is enforced at
// the Postgres layer via RLS (see packages/db/prisma/policies/phase-0.sql) and
// at the application layer via withTenant() (see src/tenant-client.ts).

generator client {
  provider        = "prisma-client-js"
  // Generated client lives inside this package, gitignored. Sits as a
  // sibling of src/ so that compiled dist/*.js can require it via the same
  // relative path source uses (../generated/client).
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
  // native   → local dev (Windows / macOS picks the right target automatically)
  // debian-openssl-3.0.x → Fly.io / Docker on Debian 12 (Bookworm) with OpenSSL 3
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Migrations run as the privileged DB owner (school_kit). The runtime client
  // uses `url` and connects as `app_user`, which cannot bypass RLS.
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

// ---------- Tenancy ----------

model School {
  id                       String       @id @default(uuid())
  name                     String
  slug                     String       @unique // for subdomains: <slug>.schoolkit.ng
  motto                    String?
  logoUrl                  String?      @map("logo_url")
  address                  String?
  phone                    String?
  email                    String?
  primaryColor             String?      @map("primary_color")
  status                   SchoolStatus @default(ONBOARDING)
  onboardingStep           Int          @default(0) @map("onboarding_step")
  ndprConsent              Boolean      @default(false) @map("ndpr_consent")
  ndprConsentAt            DateTime?    @map("ndpr_consent_at")
  // Opt-in to subject-period attendance (Phase 2 / Slice 8). Default false:
  // the subject-attendance surface 404s until a school turns it on.
  subjectAttendanceEnabled Boolean      @default(false) @map("subject_attendance_enabled")
  // Paystack subaccount routing (compressed plan-first, 2026-07-31).
  //
  // CORRECTED 2026-08-15: this comment used to say the school "creates its
  // own subaccount in its own Paystack dashboard". It cannot — Paystack
  // subaccounts belong to the integration that created them, and the API
  // holds one platform-wide PAYSTACK_SECRET_KEY, so such a code always fails
  // the save-time verification. Setup is assisted: the school submits banking
  // details via PaystackSetupRequest (below), the operator creates the
  // subaccount on SchoolKit's integration, and the school pastes the returned
  // code here. See docs/modules/paystack-assisted-setup.md.
  //
  // paystackPaymentsEnabled defaults false (manual-only:
  // CASH/POS/BANK_TRANSFER) for every school, including existing ones, and
  // can only be flipped true once paystackSubaccountCode is set (enforced
  // in SchoolsService.patchMe, not at the schema level). Split model is 0%
  // platform cut — 100% of every Paystack transaction goes to the school's
  // subaccount; SchoolKit's revenue is subscription-only. See
  // apps/api/src/common/paystack/paystack.service.ts for why no
  // transaction_charge/bearer split math is needed given that decision.
  paystackSubaccountCode   String?      @map("paystack_subaccount_code")
  // Payment Requests ignore transaction-style subaccount routing. Assisted
  // setup therefore creates one verified percentage:100 Transaction Split
  // per school and stores its code here for every durable invoice link.
  paystackSplitCode        String?      @map("paystack_split_code")
  paystackPaymentsEnabled  Boolean      @default(false) @map("paystack_payments_enabled")
  // Staff mobile is deliberately enabled one school at a time. Shipping the
  // binary or API must never silently expose a new staff credential surface.
  staffMobileEnabled       Boolean      @default(false) @map("staff_mobile_enabled")
  // Onboarding-nudge email (2026-08-08): stamped once, the first (and only,
  // v1) time OnboardingNudgeService emails a school's owner that finished
  // the 5-step wizard but never came back to add an academic year or
  // students — see that service's own header comment for the full trigger
  // rule. Same "stamp once, no separate skipped state" shape as
  // User.tourCompletedAt: set unconditionally after the send attempt
  // (success or logged failure) so a Resend outage doesn't cause a resend
  // storm once it clears.
  onboardingNudgeSentAt    DateTime?    @map("onboarding_nudge_sent_at")
  // Early-access marker (2026-08-09). Nullable stamp, NO enforcement logic
  // anywhere — deliberately just the flag, set by hand from the platform-admin
  // school list. Exists now because the platform has no concept of a plan,
  // tier, or subscription at all (grep confirms: zero product code), while
  // SchoolKit's revenue model is subscription-only (see paystackSubaccount-
  // Code's note — the Paystack split is 0% platform cut). When paid tiers
  // eventually ship, "who was here early and should be grandfathered" has to
  // be answerable, and the only alternative discriminator is created_at —
  // which cannot tell a genuine pilot school from a smoke-test artifact or a
  // provisioning test, and cannot express "I promised THIS school free access
  // on a call" for a school that signs up later.
  //
  // Shape matches onboardingNudgeSentAt / ndprConsentAt: a timestamp, not a
  // boolean (the extra information is free) and not an enum (naming the tiers
  // before they are decided just buys a migration later).
  earlyAccessGrantedAt     DateTime?    @map("early_access_granted_at")
  // Phase 5 / Slice 1 CP2 — AI cost controls. Two deliberately separate knobs:
  //
  //   aiEnabled              per-school kill switch. Flipping it false stops
  //                          every AI feature for that school WITHOUT a deploy
  //                          — the point is that a runaway cost or a bad prompt
  //                          can be stopped in seconds from platform-admin.
  //                          The platform-wide equivalent is the AI_ENABLED
  //                          env var (see AiGenerationService); BOTH gates
  //                          must be open for a school to generate anything.
  //
  //                          Defaults FALSE as of 2026-08-14. It shipped
  //                          DEFAULT true (Slice 1 CP2) reasoning that "AI is
  //                          a headline feature, and a school that never opts
  //                          in would otherwise silently never see it." Both
  //                          halves inverted: the rollout is deliberately one
  //                          school at a time, so default-true would enable
  //                          every school the instant AI_ENABLED flips; and
  //                          "never opts in" stopped being a dead end when
  //                          PATCH /platform-admin/schools/:schoolId/ai made
  //                          enabling one audited click. Do not flip it back
  //                          without also deciding what replaces the
  //                          one-at-a-time rollout — see migration
  //                          20260814120000 and docs/modules/phase-5.md D16.
  //
  //   aiMonthlyTokenBudget   per-school monthly cap, in TOKENS not cost.
  //                          Nullable = "use the platform default constant"
  //                          (DEFAULT_MONTHLY_TOKEN_BUDGET), so the common case
  //                          needs no per-school row edit and the default can be
  //                          re-tuned in one place. Enforced in tokens rather
  //                          than money on purpose: tokens are ground truth from
  //                          the API response, whereas cost is derived from a
  //                          price table that changes underneath us — see
  //                          docs/modules/phase-5.md D3.
  //
  // Same flat per-school-toggle shape as subjectAttendanceEnabled /
  // paystackPaymentsEnabled above. Deliberately NOT a plan/tier/subscription
  // concept — none exists anywhere in the product code (see
  // earlyAccessGrantedAt's note directly above), and inventing one to hold an
  // AI budget would be the tail wagging the dog.
  aiEnabled                Boolean      @default(false) @map("ai_enabled")
  aiMonthlyTokenBudget     Int?         @map("ai_monthly_token_budget")

  //   parentSummaryEnabled   Phase 5 / Slice 5. Weekly AI progress summaries
  //                          sent to guardians. Defaults FALSE, and — since
  //                          2026-08-14 — so does aiEnabled above. They are
  //                          NOT one rule with one reason, and the original
  //                          D16 warning ("do not make it consistent with
  //                          aiEnabled's default-true") is preserved in
  //                          substance here: whoever revisits either default
  //                          must revisit it on its OWN grounds.
  //                            aiEnabled is false because ENABLEMENT is an
  //                          operator rollout decision — one school at a time,
  //                          from platform-admin, so a platform-wide flip
  //                          can't reach everyone at once.
  //                            parentSummaryEnabled is false because of who
  //                          READS the output. Every other AI feature produces
  //                          a draft a teacher sees before anyone else does;
  //                          this one reaches a parent with nobody in between,
  //                          so the school opts in deliberately having seen
  //                          what it writes, rather than discovering it after
  //                          a parent has already read one.
  //                            Consequence worth stating: turning aiEnabled on
  //                          for a school does NOT start sending parent
  //                          summaries. That still needs this second, separate
  //                          opt-in, by the school itself.
  parentSummaryEnabled Boolean  @default(false) @map("parent_summary_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  users               User[]
  invitations         Invitation[]
  passwordResetTokens PasswordResetToken[]

  guardianPasswordResetTokens GuardianPasswordResetToken[]

  @@map("schools")
}

enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Branch {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("branches")
}

// ---------- Identity ----------

model User {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  email             String?   @unique
  phone             String?   @unique
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  passwordHash      String?   @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  // Platform super-admin flag (added for the internal, read-only cross-
  // tenant admin surface — see CLAUDE.md's SECURITY DEFINER inventory,
  // platform_admin_* functions). Granted ONLY via a direct DB UPDATE — no
  // self-serve UI, no invite flow. Checked fresh from the DB on every
  // platform-admin request (PlatformAdminGuard), never trusted from a
  // token/session payload, same discipline as `isActive` above.
  isPlatformAdmin   Boolean   @default(false) @map("is_platform_admin")
  emailVerified     Boolean   @default(false) @map("email_verified")
  phoneVerified     Boolean   @default(false) @map("phone_verified")
  lastLoginAt       DateTime? @map("last_login_at")
  totpPendingSecret String?   @map("totp_pending_secret")
  totpSecret        String?   @map("totp_secret")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")

  // First-login product tour (owner/admin shell). Null until the user
  // finishes or skips it; either action stamps "now" — there is no
  // separate "skipped" state, since the tour never reappears automatically
  // either way. A "Replay tour" affordance re-shows it without touching
  // this column (replay is a local UI action, not a state reset).
  tourCompletedAt DateTime? @map("tour_completed_at")

  // Phase 3 / Slice 12 — encrypted BVN (Bank Verification Number), staff/
  // payroll PII, not student/guardian data. bvnEncrypted is pgcrypto
  // ciphertext, only ever produced/consumed via the encrypt_bvn/decrypt_bvn
  // SECURITY DEFINER functions. bvnLast4 is plaintext (safe in isolation) for
  // masked display without invoking decryption. See CLAUDE.md "SECURITY
  // DEFINER functions — index" and docs/modules/phase-3.md §7.
  bvnEncrypted Bytes?  @map("bvn_encrypted")
  bvnLast4     String? @map("bvn_last4")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Phase 1 / Slice 3 — back-relation to ClassArm.classTeacherId (the form
  // teacher). Named relation to disambiguate from the slice-11 teacher-
  // subject assignment edge below — both are User-to-teaching relations and
  // Prisma needs explicit names once a model has more than one relation set.
  classTeacherArms ClassArm[] @relation("ClassTeacherArms")

  // Phase 1 / Slice 10 — 1:1 HR profile for users who hold the teacher role.
  // Optional because most users (owner, admin) never get one, and a teacher
  // exists as a User the moment they accept their invitation; the profile is
  // created explicitly by an admin afterwards (Q2 lifecycle, locked
  // 2026-05-30 — no auto-create on accept).
  teacherProfile TeacherProfile?

  // Phase 1 / Slice 11 — subject-teaching assignments (this user teaches a
  // subject in a class arm for a year/term). Distinct from classTeacherArms
  // above: a form teacher owns the arm's register; a subject teacher teaches
  // one subject to it. The named relation pairs with TeacherAssignment.teacher.
  teacherAssignments TeacherAssignment[] @relation("TeacherSubjectAssignments")

  @@index([schoolId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  schoolId    String?  @map("school_id") // null = system role (seeded)
  key         String // 'owner', 'admin', 'teacher', etc.
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("[]") // string[] of permission keys, or ["*"]
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@unique([schoolId, key])
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  clientType SessionClientType @default(WEB) @map("client_type")
  deviceId   String?  @map("device_id")
  deviceName String?  @map("device_name")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, clientType])
  @@map("sessions")
}

enum SessionClientType {
  WEB
  MOBILE
}

model Invitation {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  email      String?
  phone      String?
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  roleKey    String    @map("role_key")
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("invitations")
}

// Phase 0 gap closed 2026-07-24 — forgot/reset password flow. Spec'd in
// docs/modules/phase-0.md (`POST /auth/forgot-password`, `POST /auth/
// reset-password`, `/forgot-password`, `/reset-password/[token]`) but never
// implemented; built now. Structurally mirrors Invitation (schoolId +
// unique tokenHash + expiresAt + a nullable "consumed" timestamp, resolved
// pre-tenant via a SECURITY DEFINER function — see the migration's own
// header comment) rather than reusing Invitation itself: this token targets
// an EXISTING User (hence the userId FK Invitation doesn't have), not a
// not-yet-created one, and carries none of Invitation's invite-time fields
// (email/phone/names/roleKey/invitedBy). `usedAt` (not `acceptedAt`) because
// "used" reads more accurately for a reset token than "accepted".
model PasswordResetToken {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @default(uuid())
  schoolId   String?  @map("school_id")
  userId     String?  @map("user_id")
  action     String // e.g. 'school.update', 'user.invite', 'academic-year.create'
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Composite PK required by PostgreSQL: all unique constraints on a
  // partitioned table must include every partition key column.
  // audit_logs is partitioned by created_at, so the PK is (id, created_at).
  // Nothing FK-references audit_logs.id, so this change is safe.
  @@id([id, createdAt])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ---------- Phase 1 / Slice 1 — Academic structure (year + term) ----------
//
// First Phase 1 slice. Two tables, both school-scoped, both under FORCE RLS.
// "Current year" / "current term" is modelled as an isCurrent flag enforced
// by partial unique indexes (added in the migration's raw SQL because
// Prisma's @@unique cannot express WHERE clauses). The service layer
// cascades setCurrentTerm → academic_year.is_current; that invariant is the
// only one the DB does not enforce, and the terms.service spec asserts it.

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  label     String // e.g. "2025/2026" — unique per school
  startDate DateTime @map("start_date") @db.Date // calendar dates, not moments — see CLAUDE.md
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  terms              Term[]
  enrollments        Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation.

  @@unique([schoolId, label])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  sequence       Int // 1 | 2 | 3 — unique within a year
  name           String // "First Term", "Second Term", "Third Term"
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation (term-specific assignments).

  @@unique([academicYearId, sequence])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
  @@map("terms")
}

// ---------- Phase 1 / Slice 2 — Class levels ----------
//
// Hybrid model: every new school is auto-seeded with the 14 standard Nigerian
// levels (KG 1/2, Primary 1–6, JSS 1–3, SSS 1–3) inside the signup
// transaction (see apps/api/src/modules/auth/auth.service.ts → signupOwner).
// Schools can then add custom levels, edit names, or toggle isActive.
//
// `code` is the stable per-school identifier (matching the seed) and backs
// the uniqueness constraint; `name` is the human-facing label and can be
// renamed freely. `orderIndex` drives sort order in the UI; duplicates are
// tolerated for schools that interleave custom levels (sort tie-breaks on
// name ASC). No partial unique index here — there is no "current level"
// concept; the current academic year/term carries that semantic.

model ClassLevel {
  id         String     @id @default(uuid())
  schoolId   String     @map("school_id")
  name       String // "KG 1", "Primary 4" — human-facing; renamable
  code       String // "kg1", "pri4" — stable per-school identifier (unique)
  stage      ClassStage // NURSERY | PRIMARY | JSS | SSS — coarse grouping
  orderIndex Int        @map("order_index") // sort order; seeded 1..14
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Phase 1 / Slice 3 back-relations.
  arms          ClassArm[]
  classSubjects ClassSubject[]
  lessonPlans   LessonPlan[] // Phase 5 / Slice 2 back-relation.

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, orderIndex])
  @@map("class_levels")
}

enum ClassStage {
  NURSERY
  PRIMARY
  JSS
  SSS
}

// ---------- Phase 1 / Slice 3 — Class arms, subjects, class-subjects ----------
//
// Three models that complete the academic skeleton. ClassArm is the section
// under a ClassLevel ("JSS 1A", "JSS 1B"); Subject is the school-wide subject
// catalog; ClassSubject is the explicit many-to-many between ClassLevel and
// Subject (curriculum lives at the level, not the arm — all arms of JSS 1
// take the same set of subjects). All three carry their own school_id for
// direct-RLS isolation, matching the slice 1+2 pattern.
//
// classTeacherId on ClassArm references users.id (not teacher_profiles.id —
// that table arrives in slice 10). The dropdown stays empty until teachers
// have accepted invitations; the UI surfaces an "Invite a teacher" CTA per
// the spec risk note (docs/modules/phase-1.md → Risks and gotchas).

model ClassArm {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  classLevelId   String   @map("class_level_id")
  name           String // "JSS 1A" — human-facing; renamable
  code           String // "jss1-a" — stable per-(school, level) identifier
  capacity       Int? // optional max headcount
  classTeacherId String?  @map("class_teacher_id") // FK → users.id (form teacher)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  classLevel         ClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classTeacher       User?               @relation("ClassTeacherArms", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[] // Phase 1 / Slice 9 back-relation.
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation (subject teachers of this arm).

  @@unique([schoolId, classLevelId, code])
  @@index([schoolId])
  @@index([classTeacherId])
  @@map("class_arms")
}

model Subject {
  id        String          @id @default(uuid())
  schoolId  String          @map("school_id")
  name      String // "Mathematics" — human-facing; renamable
  code      String // "math" — stable per-school identifier (unique)
  category  SubjectCategory @default(CORE)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[] // Phase 1 / Slice 11 back-relation.
  lessonPlans        LessonPlan[] // Phase 5 / Slice 2 back-relation.

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

enum SubjectCategory {
  CORE
  ELECTIVE
  VOCATIONAL
}

// Explicit join between ClassLevel and Subject. Explicit (not Prisma's
// implicit m-n) because we need our own school_id column for direct-RLS and
// our own `isCore` payload (curriculum metadata: e.g. Maths is core in JSS
// but may be elective in some SSS streams). No updatedAt — link membership
// is binary; toggling isCore is a single UPDATE without history.

model ClassSubject {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  classLevelId String   @map("class_level_id")
  subjectId    String   @map("subject_id")
  isCore       Boolean  @default(true) @map("is_core")
  createdAt    DateTime @default(now()) @map("created_at")

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classLevelId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ---------- Phase 1 / Slice 4 — Students ----------
//
// First slice to model actual people. Student is the roster spine: CSV import
// (slices 6-8) and Enrollment (slice 9) both build on this table. The model is
// stripped of every relation that points at models that do not exist yet —
// StudentGuardian (slice 5), Enrollment (slice 9), MasteryRecord +
// AIInteractionLog (slice 12) — those back-relations are added by their own
// slices to keep this one purely additive.
//
// Class membership is intentionally NOT on Student. The spec locks per-term
// Enrollment as the only source of truth (docs/modules/phase-1.md → "Enrollment
// is per-TERM, not per-academic-year"); a denormalised currentClassArmId here
// would drift on every term boundary and break the join shape Phase 2 is built
// around.
//
// dateOfBirth uses @db.Date per CLAUDE.md's "calendar date vs moment" rule
// (also explicitly named in that rule). The spec text shows plain `DateTime`
// — that's a pre-convention oversight from before slice 1 locked the
// convention, reconciled in this slice's docs edit. Plain DateTime is kept
// for admittedAt/withdrawnAt/graduatedAt: those are events (when the
// transition happened), not calendar dates.
//
// admissionNumber is free-text required-unique-per-school (no auto-format,
// no school-configurable scheme in Phase 1 — deferred). The unique constraint
// is the ordinary @@unique form, not a partial index, since there's no
// "current" semantic on Student.

model Student {
  id              String        @id @default(uuid())
  schoolId        String        @map("school_id")
  admissionNumber String        @map("admission_number") // free-text, unique per school
  firstName       String        @map("first_name")
  middleName      String?       @map("middle_name")
  lastName        String        @map("last_name")
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date // calendar date — see CLAUDE.md
  gender          Gender
  photoUrl        String?       @map("photo_url") // string only; upload UI deferred (Phase 2/4)
  address         String?
  phone           String?
  email           String?
  bloodGroup      String?       @map("blood_group")
  medicalNotes    String?       @map("medical_notes")
  religion        String?
  stateOfOrigin   String?       @map("state_of_origin")
  nationality     String        @default("Nigerian")
  status          StudentStatus @default(ACTIVE)

  // ---- Smart Student Import — extraction provenance (2026-08-20) --------
  // TRUE when this row's field values originated from a camera-captured
  // register transcribed by the model, rather than being typed by a human or
  // parsed from a CSV the school produced.
  //
  // Added at the same time as the feature, deliberately, on D15's reasoning:
  // "was this AI-drafted or human-written?" is a question you cannot
  // retrofit an answer to. Once a term of scanned intakes exists, no
  // migration can tell those rows apart from hand-typed ones.
  //
  // NOT a trust signal and nothing branches on it — every scanned row was
  // reviewed and confirmed by an admin before it was written (D4), so a
  // scanned row is exactly as authoritative as a typed one. It exists so
  // that if a systematic extraction defect is ever found (a prompt version
  // that mis-read a date format, say), the affected population is
  // identifiable instead of hypothetical.
  //
  // Non-nullable with a FALSE default rather than nullable: every existing
  // student was demonstrably not scanned, so there is no "unknown" state to
  // represent and a nullable column would invite one.
  aiExtracted     Boolean       @default(false) @map("ai_extracted")

  // ---- Phase 6 / Slice 3 — student portal auth (D18, D26) --------------
  // Credentials live on Student rather than a companion table, mirroring
  // Decision A of the guardian build (guardians carry their own auth
  // columns) and User itself, which blends profile and auth in one row.
  //
  // All nullable, so there is NO backfill: every pre-Phase-6 student is
  // correctly represented as "never activated, never logged in".
  //
  // Portal state is DERIVED from these two columns, not stored (D25) —
  // a third column would be a second, divergeable copy of something
  // audit_logs already records:
  //   never activated  -> activatedAt NULL, passwordHash NULL
  //   active           -> activatedAt set,  passwordHash set
  //   deactivated      -> activatedAt set,  passwordHash NULL
  //
  // Deliberately NOT added: an emailVerified equivalent. A guardian's
  // identifier is an email and needs verifying; a student's is an
  // admission number issued by the school. A column that is always false
  // invites someone to build a flow around it.
  passwordHash String?   @map("password_hash")
  activatedAt  DateTime? @map("activated_at") // event moment — first accept
  lastLoginAt  DateTime? @map("last_login_at") // event moment

  admittedAt  DateTime  @default(now()) @map("admitted_at") // event moment
  withdrawnAt DateTime? @map("withdrawn_at") // event moment
  graduatedAt DateTime? @map("graduated_at") // event moment
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Slice 5 adds the StudentGuardian back-relation; slice 9 adds Enrollment;
  // slice 12 adds the two AI-foundation back-relations (tables sit empty in
  // Phase 1 — shape owned by Phase 5).
  guardians         StudentGuardian[]
  enrollments       Enrollment[] // Phase 1 / Slice 9 back-relation.
  masteryRecords    MasteryRecord[] // Phase 1 / Slice 12 back-relation.
  aiInteractionLogs AIInteractionLog[] // Phase 1 / Slice 12 back-relation.
  parentSummaries   ParentSummary[] // Phase 5 / Slice 5 back-relation.
  sessions          StudentSession[] // Phase 6 / Slice 3.
  portalInvitations StudentPortalInvitation[] // Phase 6 / Slice 3.
  deviceTokens      DeviceToken[] // Phase 6 / Slice 5.

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName]) // sorted roster scans
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  GRADUATED
  SUSPENDED
}

// ---------- Phase 6 / Slice 3 — student portal auth ----------
//
// A student is the THIRD authenticated principal (staff User, Guardian,
// Student). It is deliberately modelled on Guardian, not on User: a student
// has no role and no permissions (D17), because staff RBAC exists to answer
// "which of many things may this person touch?" and a student has exactly
// one answer — their own rows.

// Mirrors GuardianSession exactly, including the ABSENCE of a school_id
// column: tenancy is resolved by joining through students.school_id, the
// same shape guardian_sessions uses through guardians and `sessions` uses
// through users. Consistency with BOTH existing session tables beats saving
// a join — a third session table with a third tenancy shape would leave the
// next reader guessing which one is correct.
model StudentSession {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_sessions")
}

// Phase 6 / Slice 3 (D26) — the single-use token a GUARDIAN issues so their
// child can set a password.
//
// WHY A TOKEN AND NOT "the guardian types a password for the child":
// deactivation has to be a real revocation. If the child holds anything
// replayable — a link, a code, a screenshot of one — then an "off" switch
// that only clears the password and kills sessions is a FALSE SAFETY
// CONTROL: it tells a parent access is revoked when it is not. So the thing
// the child holds is single-use, and deactivation burns it.
//
// Differences from GuardianInvitation, each deliberate:
//   - revokedAt exists. GuardianInvitation has no revoke path; here it is
//     the mechanism deactivation uses, so it must be storable.
//   - issuedBy is a GUARDIAN id, not a staff User id. A parent invites their
//     own child; school staff are not involved.
//   - No name/email/phone copies. Like GuardianInvitation (and unlike the
//     staff `invitations` table) the subject row already exists, so this
//     table carries only invitation-specific fields.
//
// At most ONE live token per student: issuing a new invitation revokes any
// outstanding one, enforced in the service rather than by a partial unique
// index, because "live" is a three-column predicate (accepted_at IS NULL AND
// revoked_at IS NULL AND expires_at > now()) and now() is not immutable.
model StudentPortalInvitation {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id") // denormalised for direct RLS
  studentId  String    @map("student_id")
  tokenHash  String    @unique @map("token_hash")
  issuedBy   String    @map("issued_by") // guardianId — plain scoping column
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at") // stamped on use — single-use
  revokedAt  DateTime? @map("revoked_at") // stamped by deactivation (D26)
  createdAt  DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("student_portal_invitations")
}

// ---------- Phase 1 / Slice 5 — Guardians + student-guardian links ----------
//
// Guardian is a school-scoped person record (parent, sibling, NOK, etc.).
// Phase 1 is admin-managed: owners and admins create / edit / link / unlink.
// Parent AUTH and the parent-facing app are Phase 4 — guardians cannot log in
// yet, so there is no User row paired with a Guardian here.
//
// Two design choices worth flagging:
//
//   1. NO unique constraint on (school_id, phone) or (school_id, email). A
//      mother and father commonly share a household phone; a guardian with a
//      shared family inbox may legitimately appear against multiple students
//      under separate records (rare, but real). The (school_id, phone) index
//      backs the link-existing picker; uniqueness would block valid data.
//
//   2. isPrimary on StudentGuardian has no schema-level "only one per
//      student" rule — application enforces it (GuardiansService demotes
//      sibling links inside the same transaction). A partial unique index
//      would be the correct-by-construction guard, but it would also block
//      the demote-then-promote pattern unless wrapped in a DEFERRABLE
//      constraint, which Postgres only supports for UNIQUE on a regular
//      index, not a partial one. The service-layer rule is the only path.
//
// onDelete: Cascade on BOTH FKs of StudentGuardian — deleting a Student or
// a Guardian cleans up the links. Guardian deletion itself is gated by the
// service to refuse hard-delete while links exist, so the cascade is a
// belt-and-braces guard, not the primary unlink path.

model Guardian {
  id           String       @id @default(uuid())
  schoolId     String       @map("school_id")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  relationship Relationship
  phone        String // NOT globally unique — see header comment
  email        String?

  // Phase 4 / Slice 2 — portal auth (Decision A, docs/modules/phase-4.md §3/§4).
  // Guardian is extended directly rather than a companion table, mirroring how
  // User already blends profile + auth in one row. All four nullable except
  // emailVerified — every pre-Phase-4 guardian was never invited, never
  // logged in, which NULL/false both represent correctly with no backfill.
  passwordHash    String?   @map("password_hash")
  emailVerified   Boolean   @default(false) @map("email_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  portalInvitedAt DateTime? @map("portal_invited_at")

  occupation String?
  employer   String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  students       StudentGuardian[]
  sessions       GuardianSession[]
  invitations    GuardianInvitation[]
  passwordResets GuardianPasswordResetToken[]
  deviceTokens   DeviceToken[] // Phase 6 / Slice 5.

  // Decision C (phase-4.md) — scoped per school, not global. A guardian with
  // children at two schools gets two separate portal accounts (intentional).
  // Postgres treats multiple NULLs as distinct, so uninvited guardians
  // (email IS NULL) never collide against this constraint. Confirmed clean
  // against local dev + Neon production data before adding (0 duplicate
  // (school_id, email) pairs in either — see phase-4.md slice 2 plan-first).
  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([schoolId, phone]) // backs the link-existing picker's phone search
  @@map("guardians")
}

// Phase 4 / Slice 2 — guardian portal session storage. Deliberately mirrors
// `Session` (staff) exactly, including the absence of a schoolId column —
// tenancy is resolved by joining through guardianId, same chicken-and-egg
// reasoning as staff sessions (see auth_resolve_guardian_session below). A
// parallel table, not a reuse of `Session`: Session.userId is a non-nullable
// FK to User, and widening it to cover guardians would drag the staff RBAC/
// permissions machinery into a user class that never needs it.
model GuardianSession {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  tokenHash  String   @unique @map("token_hash")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("guardian_sessions")
}

// Guardian portal password recovery. A PARALLEL table to PasswordResetToken,
// not a reuse of it — the same relationship GuardianSession has to Session
// and GuardianInvitation has to Invitation.
//
// Two independent reasons, either sufficient on its own:
//
//  1. STRUCTURAL. PasswordResetToken.userId is a non-null FK to users with
//     onDelete: Cascade. A guardian id cannot go in that column. Reusing the
//     table would mean making userId nullable, adding a nullable guardianId,
//     and enforcing "exactly one of these is set" in a CHECK constraint —
//     trading a hard database-level invariant on a SECURITY table for a
//     softer one, to save a table.
//
//  2. SECURITY. Separate tables make cross-principal token confusion
//     STRUCTURALLY IMPOSSIBLE rather than conventional: a staff reset token
//     presented to POST /portal/reset-password resolves to nothing, because
//     the guardian resolver reads only this table. A shared table would need
//     every caller to remember to check a principal-type column, which is
//     exactly the trade CLAUDE.md's 2026-08-16 SECURITY DEFINER review
//     refused for the session resolvers.
//
// Carries school_id directly (like guardian_invitations, unlike
// guardian_sessions) so its RLS policy is the flat one rather than a join
// through guardians — the forgot-password path already knows the school_id
// from the pre-tenant lookup, so there is nothing to gain from deriving it.
model GuardianPasswordResetToken {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  guardianId String    @map("guardian_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@map("guardian_password_reset_tokens")
}

// Phase 4 / Slice 2 — admin-initiated guardian portal invitations (D2). A
// parallel table to `Invitation`, not a reuse: unlike a staff invite (where
// the User doesn't exist yet), the Guardian row already exists before this
// flow starts — created earlier when the student was linked — so this table
// carries only the invitation-specific fields (token, expiry, acceptance),
// not redundant name/email/phone copies. schoolId is denormalised for direct
// RLS, same pattern as StudentGuardian; cleanup cascades through guardianId
// rather than a direct FK to School (Guardian itself has no FK to School
// either — consistent with existing convention, not a new gap).
model GuardianInvitation {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  guardianId String    @map("guardian_id")
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@map("guardian_invitations")
}

// Phase 4 / Slice 6 — Notifications (D3). Per-school channel toggles.
// pushEnabled is dark until the mobile phase — no code reads it yet.
// smsEnabled defaults false: Termii costs money per message, unlike email,
// so SMS is opt-in rather than opt-out. No `school School @relation(...)` —
// schoolId is a plain scoping column, same convention as GradingScheme and
// Guardian itself (neither declares a School relation either).
model NotificationPreference {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  smsEnabled   Boolean  @default(false) @map("sms_enabled")
  pushEnabled  Boolean  @default(false) @map("push_enabled")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([schoolId])
  @@map("notification_preferences")
}

// Phase 6 / Slice 5 (D34) — an Expo push token for one app install.
//
// WHY A TABLE AND NOT A COLUMN on Guardian/Student: one person legitimately
// has several devices (a parent's phone and tablet), and one device carries
// several installs over its life (reinstall issues a new token). Both are
// one-to-many, and a column would silently drop every device but the last.
//
// EXACTLY ONE OF guardianId/studentId IS SET. Enforced by a CHECK constraint
// in the migration rather than by convention: a row with neither is
// unroutable, and a row with both would deliver a child's notification to a
// parent's device or the reverse — the precise cross-principal leak the two
// separate session tables exist to prevent (see CLAUDE.md's SECURITY DEFINER
// cadence review on why those are not merged).
//
// The token is NOT a credential — it is an address Expo issues, and holding
// one lets you send TO a device, not read anything from it. So it is stored
// in plaintext, unlike every session token here, which are stored as hashes
// because they authenticate. Do not "fix" this by hashing it: a hash cannot
// be sent to.
//
// schoolId is a plain scoping column with no School relation — same
// convention as NotificationPreference above, GradingScheme and Guardian.
model DeviceToken {
  id            String         @id @default(uuid())
  schoolId      String         @map("school_id")
  principalType PrincipalType  @map("principal_type")
  guardianId    String?        @map("guardian_id")
  studentId     String?        @map("student_id")
  // Expo's token, e.g. "ExponentPushToken[xxxxxxxx]". Globally unique: the
  // same install re-registering must UPDATE its row (and can legitimately
  // move between principals on a shared handset), never accumulate copies.
  expoPushToken String         @unique @map("expo_push_token")
  platform      DevicePlatform
  // Touched on every re-registration, which the app does at each launch.
  // A token Expo has not invalidated but no app has claimed in months is the
  // signal for a future prune; nothing reads it yet.
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guardianId])
  @@index([studentId])
  @@map("device_tokens")
}

enum PrincipalType {
  GUARDIAN
  STUDENT

  @@map("principal_type")
}

enum DevicePlatform {
  ANDROID
  IOS

  @@map("device_platform")
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  AUNT
  GRANDPARENT
  SIBLING
  OTHER
}

model StudentGuardian {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id") // denormalised for direct RLS
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  canPickup  Boolean  @default(true) @map("can_pickup")
  createdAt  DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId]) // a guardian cannot link to the same student twice
  @@index([schoolId])
  @@index([guardianId]) // reverse lookup: a guardian's children
  @@map("student_guardians")
}

// ---------- Phase 1 / Slice 6 — CSV import bookkeeping ----------
//
// One row per import attempt. The row is the source of truth for the
// wizard UI; BullMQ's internal job state (waiting/active/failed) is
// implementation detail and NEVER reaches the API consumer. The state
// machine is:
//
//   PENDING ──mapping─▶ VALIDATING ──worker ok──▶ READY ──┐  (commit is slice 7+)
//      │                     │                              ▼
//      │ delete              │ retries exhausted        COMMITTING ─▶ COMPLETED
//      ▼                     ▼
//   (gone)                  FAILED  ◀─────────────────────  (worker fatal)
//
// `sourceFileUrl` is a storage path (driver-agnostic — R2 in prod,
// filesystem in dev) of the form `schools/<schoolId>/imports/<jobId>/source.csv`.
// The StorageService is responsible for constructing this path; the schema
// does not enforce its shape because the path is opaque to Postgres.
//
// `previewSnapshot` holds first 50 good + first 50 bad rows for the UI
// preview only — the full bad-rows download (and the slice-7 error report)
// re-stream the source CSV rather than store all bad rows in JSON, to
// avoid bloating this row for large mostly-bad uploads.
//
// `failedReason` is populated by the FailedJobEvent listener when BullMQ
// exhausts retries, or directly by the worker when it detects an
// unrecoverable error (missing source file, parser fatal, etc.). Surfaced
// to the admin on step 3 of the wizard.
//
// `createdBy` is the userId of the admin who initiated the upload; flows
// into job-data for the worker so audit rows (slice 7 commit) attribute
// to a real user without needing a request context.
//
// SECURITY DEFINER count stays at 4. Every import endpoint is post-
// authentication and post-tenant; the worker establishes tenant context
// from job.data.schoolId via withTenant() — see apps/api/src/common/queue/
// tenant-worker.ts for the wrapper that makes this invariant mechanical.
model ImportJob {
  id              String          @id @default(uuid())
  schoolId        String          @map("school_id")
  type            ImportJobType
  status          ImportJobStatus @default(PENDING)
  // Empty string for STUDENTS_SCAN jobs: the captured image is never
  // persisted (D3), so there is no object to point at. Deliberately NOT made
  // nullable — three import types rely on this being present, and widening
  // the column to null would push an `if (!url)` branch into every one of
  // them to serve the one type that never reads it.
  sourceFileUrl   String          @map("source_file_url")
  columnMapping   Json?           @map("column_mapping")
  totalRows       Int             @default(0) @map("total_rows")
  validRows       Int             @default(0) @map("valid_rows")
  invalidRows     Int             @default(0) @map("invalid_rows")
  committedRows   Int             @default(0) @map("committed_rows")
  // STUDENTS imports only: students created successfully but NOT enrolled,
  // because their class-arm cell was blank or the column wasn't mapped
  // (2026-08-09). Always 0 for GUARDIANS/TEACHERS.
  //
  // Not an error count — a school mid-admission legitimately has unplaced
  // students — but the admin needs to know, so the done screen reports it as
  // an aggregate. A real per-row warning tier was deliberately deferred; see
  // docs/modules/student-import-enrollment.md D7. When that tier lands, this
  // column stays: it is the cheap summary, not a substitute for the tier.
  notEnrolledRows Int             @default(0) @map("not_enrolled_rows")
  errorReportUrl  String?         @map("error_report_url")
  previewSnapshot Json?           @map("preview_snapshot")
  failedReason    String?         @map("failed_reason")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("import_jobs")
}

enum ImportJobType {
  STUDENTS
  GUARDIANS
  TEACHERS
  // Camera-captured student register (Smart Student Import). A separate type
  // rather than a discriminator column on STUDENTS because the two differ in
  // LIFECYCLE, not just in provenance: a STUDENTS job has a source file in
  // storage and a mapping step, and a STUDENTS_SCAN job has neither — the
  // model already mapped the fields (that is the feature) and the image is
  // never persisted (D3). The validate worker dispatches on this enum, so
  // making it a type keeps "does this job have a source file?" answerable
  // from the row instead of from a second nullable column that could
  // disagree with it.
  STUDENTS_SCAN
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  READY
  COMMITTING
  COMPLETED
  FAILED
}

// ---------- Phase 1 / Slice 9 — Enrollment (per-term) ----------
//
// Per-term, not per-academic-year. One row per (school, student, term).
// Why per-term, locked at 2026-05-22 in Phase 1 planning (docs/modules/
// phase-1.md → "Enrollment is per-TERM, not per-academic-year"):
//   - Nigerian schools admit students mid-year. A second-term joiner
//     gets a second-term row and no first-term row — no fudging.
//   - Phase 2's term-scoped features (attendance, CA1/CA2/exam, report
//     cards) join cleanly to Enrollment without a "which arm were they
//     in this term" lookup table.
//   - Mid-year arm transfers manifest as the NEXT term's row in the
//     new arm; the old term's row stays as historical truth.
// Do NOT "simplify" this back to per-year — it breaks the join shape
// Phase 2 is designed around.
//
// academicYearId is denormalised from term.academicYearId for cheap
// "all students enrolled in 2025/2026" roster queries. The service
// layer resolves academicYearId from termId at write time; the API
// never accepts it from a request body. The columns must stay
// consistent — Phase 2 may add a CHECK constraint or trigger; Phase
// 1 keeps it as a service-layer invariant to ship.
//
// Status enum (six values; only ENROLLED + WITHDRAWN have workflows
// in slice 9, the others reachable via manual PATCH — see slice-9
// scope decision):
//   - ENROLLED       (default; created on enrol)
//   - WITHDRAWN      (admin withdrew; cascade from student.withdraw)
//   - GRADUATED      (admin graduated; cascade from student.graduate)
//   - TRANSFERRED    (back-fill / manual PATCH; Phase 2 workflow)
//   - PROMOTED       (back-fill / manual PATCH; Phase 2/3 promotion engine)
//   - REPEATED       (back-fill / manual PATCH; Phase 2/3 promotion engine)
//
// No graduatedAt column — derived from updatedAt for the rare case the
// Phase 2 transcript module needs an explicit moment. Captured in
// docs/deferred.md as a Phase-2-trigger.

model Enrollment {
  id                String           @id @default(uuid())
  schoolId          String           @map("school_id")
  studentId         String           @map("student_id")
  termId            String           @map("term_id")
  academicYearId    String           @map("academic_year_id") // denormalised from term; MUST equal term.academic_year_id
  classArmId        String           @map("class_arm_id")
  status            EnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  transferredAt     DateTime?        @map("transferred_at")
  withdrawnAt       DateTime?        @map("withdrawn_at")
  promotedFromArmId String?          @map("promoted_from_arm_id") // optional pointer to a previous term's arm (mid-year transfer or year promotion)
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classArm     ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, termId]) // one row per student per term
  @@index([schoolId])
  @@index([classArmId])
  @@index([schoolId, termId])
  @@index([schoolId, academicYearId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  PROMOTED
  REPEATED
  WITHDRAWN
  GRADUATED
}

// ---------- Staff (Phase 1 / Slice 10) ----------
//
// TeacherProfile is the HR record for a User who holds the teacher role.
// 1:1 with User (userId @unique). Created explicitly by an admin AFTER the
// teacher accepts their invitation (Q2 lifecycle, locked 2026-05-30):
//   - The invitation-accept path is untouched — no profile is auto-created.
//   - `POST /teacher-profiles { userId, staffNumber, ... }` materialises it
//     with a real, admin-entered staffNumber.
//   - The teacher CSV import (slice 10 cp2) creates Invitations only; it does
//     NOT import profile fields (deferred — the Invitation row can't carry
//     them per phase-1.md:478, and acceptance #7 only requires invite-create).
//
// `joinedAt` is the pinned spec shape: a plain DateTime @default(now()), i.e.
// the moment the profile row was created — NOT an admin-entered hire date.
// A real `hireDate DATE` is Phase 3 payroll territory (alongside BVN capture,
// deferred at phase-1.md:1234). Kept as joinedAt per the locked design.
//
// Two unique constraints (userId, and (schoolId, staffNumber)) — the service
// pre-checks both before insert so it can return precise 409 codes; under
// FORCE RLS the P2002 constraint name is stripped, so we cannot discriminate
// from the error alone (see the RLS-hides-constraint-name note in CLAUDE.md).
//
// onDelete: Cascade — deleting the User drops the profile. In practice users
// are soft-deleted (isActive=false), so this fires only on a real hard delete.
model TeacherProfile {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  userId         String   @unique @map("user_id") // 1:1 with User
  staffNumber    String   @map("staff_number") // unique per school; free-text in Phase 1
  qualifications String? // free-text in Phase 1; structured array in Phase 3 payroll
  specialty      String? // e.g. "Mathematics"
  nutNumber      String?  @map("nut_number") // Nigerian Union of Teachers number (optional)
  joinedAt       DateTime @default(now()) @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@map("teacher_profiles")
}

// ---------- Phase 1 / Slice 11 — TeacherAssignment ----------
//
// Records "teacher T teaches subject S in class arm A for year Y (optionally
// term-specific)". This is the data behind the teacher-scope filter that
// closes acceptance #9 — a teacher logging in sees only the arms + subjects
// they are assigned to (cp2), plus the arms where they are the form teacher
// (ClassArm.classTeacherId, slice 3/10) which the scope helper unions in.
//
// Shape (locked 2026-05-31): direct FKs to classArm + subject, NOT through
// ClassSubject. ClassSubject is (classLevel × subject) — curriculum at the
// LEVEL; a teacher teaches a specific ARM (JSS 1A, not "JSS 1" as a whole),
// so the assignment must reference the arm. academicYearId scopes the
// assignment to a year; termId is OPTIONAL — null means "the whole year",
// a set value means "this term only" (e.g. a relief teacher covering one
// term). Closest to candidate (c) in the plan, with year + optional-term
// scoping added.
//
// Co-teaching is ALLOWED by design (Q2, 2026-05-31): teacherId is part of
// the unique key, so two teachers can share the same (arm, subject, year,
// term). Supports lab/team teaching and mid-term relief. The unique only
// stops the SAME teacher being assigned twice to an identical tuple.
//
// CAVEAT — NULL term + the unique key: Postgres treats NULL as DISTINCT in a
// unique index, so two identical whole-year rows (termId = NULL) do NOT
// collide at the DB. The service therefore pre-checks for an existing
// identical active assignment (matching null term explicitly) and returns a
// clean 409 TEACHER_ALREADY_ASSIGNED; the P2002 catch is the backstop for
// the non-null race. See teacher-assignments.service.ts.
//
// Direct school_id column for the same cheap direct-RLS filter every Phase 1
// table uses — no join-through-parent EXISTS subquery. onDelete: Cascade on
// teacher/arm/subject/year (deleting any drops the assignment); SetNull on
// term so clearing a term-specific assignment's term degrades it to a
// whole-year row rather than vanishing.
//
// SECURITY DEFINER count stays at 4 — every endpoint is post-authentication
// and post-tenant; withTenant() covers all access.
model TeacherAssignment {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  teacherId      String   @map("teacher_id") // FK → users.id
  classArmId     String   @map("class_arm_id")
  subjectId      String   @map("subject_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id") // null = whole year; set = term-specific
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  teacher      User         @relation("TeacherSubjectAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  classArm     ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([schoolId, teacherId, classArmId, subjectId, academicYearId, termId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classArmId])
  @@index([schoolId, academicYearId])
  @@map("teacher_assignments")
}

// ---------- Phase 1 / Slice 12 — AI foundation (thin; semantics OWNED BY PHASE 5) ----------
//
// These two tables exist to lock in school_id + RLS + audit shape NOW so that
// when Phase 5 fills out the AI features we are NOT doing a live-data
// migration on a populated table. They sit EMPTY in Phase 1 — slice 12 is a
// hard gate against premature Phase-5 work, not a feature. Do not build
// against them in Phase 1.
//
// Deliberately omitted (Phase 5 owns these — adding them now pre-empts a
// decision the spec intentionally punts):
//   - MasteryRecord: NO score column (0-1 vs 0-100 vs letter is Phase 5), NO
//     time-decay field beyond updatedAt, NO source/origin column (tutor vs
//     assessment vs manual). status is free-text String now, an enum in
//     Phase 5; topicRef is a loose string so the grain (subject/topic/
//     objective) can be chosen later without a migration.
//   - AIInteractionLog: payload is an OPAQUE Json envelope whose structure is
//     Phase-5-owned. It MUST stay PII-free per CLAUDE.md AI hard rules (never
//     send student PII to the LLM; log opaque ids + class-level context only).
//     The inline-vs-R2 storage tradeoff (cost/PII/eval) is a Phase-5 decision
//     made when there is a real payload — not pre-built here.
//
// NAMING (resolved 2026-07-26, see docs/deferred.md): ARCHITECTURE.md §5/§7
// and CLAUDE.md's AI hard rules name the LLM-call log `AIGeneration`/
// `ai_generations` — a separate table from this one, not a drift to
// reconcile. This table (`AIInteractionLog`/`ai_interaction_logs`) is a
// session/interaction content record; `AIGeneration` (not yet built) is the
// per-call cost/compliance ledger the hard rule requires. Phase 5 builds
// `AIGeneration` fresh per the draft schema in docs/deferred.md — no rename
// or merge of this table.
//
// Both tables carry their OWN school_id (despite the studentId FK) → flat
// direct-column RLS, same cheap pattern as student_guardians (see
// docs/modules/phase-1.md "Note on student_guardians"). SECURITY DEFINER
// count stays at 4 — no endpoints, no pre-tenant access; the tables are only
// ever reached via withTenant once Phase 5 wires them up.

model MasteryRecord {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  studentId String   @map("student_id")
  topicRef  String   @map("topic_ref") // loose identifier; taxonomy owned by Phase 5
  status    String // free-text in Phase 1; enum in Phase 5
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, topicRef])
  @@index([schoolId])
  @@index([studentId])
  @@map("mastery_records")
}

model AIInteractionLog {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  studentId  String?  @map("student_id") // nullable: teacher-driven sessions exist too
  sessionRef String   @map("session_ref") // loose grouping identifier; shape owned by Phase 5
  payload    Json // raw envelope; structure owned by Phase 5; MUST stay PII-free
  createdAt  DateTime @default(now()) @map("created_at")

  student     Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  generations AIGeneration[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@map("ai_interaction_logs")
}

// ---------- Phase 5 / Slice 1 CP2 — AI cost + compliance ledger ----------
//
// `ai_generations` is the per-call cost/compliance ledger CLAUDE.md's AI hard
// rule mandates: "Every call to claudeClient.messages.create must log to the
// ai_generations table: model, prompt name + version, input/output tokens,
// latency, cost estimate, success/error."
//
// It is a DIFFERENT TABLE from AIInteractionLog, not a rename (resolved
// 2026-07-26 — see CLAUDE.md's AI hard-rules section and docs/deferred.md).
// AIInteractionLog is a session/interaction CONTENT record (loose `payload`
// JSON, nullable studentId, sessionRef grouping). This is a flat, typed,
// cheaply-aggregable row per underlying LLM call, shaped for the budget query.
// One tutor session (one AIInteractionLog group) spans many rows here, which
// is why interactionLogId is a nullable many-to-one back to it and not a 1:1.
//
// DELIBERATELY OMITTED: prompt text and completion text. They live in
// AIInteractionLog.payload. ARCHITECTURE.md §5 currently describes this table
// as logging "prompt, output" — that line is stale and is corrected as part of
// this phase; a cost ledger that holds conversation content would both bloat
// the aggregate query and duplicate the PII surface the AI hard rules exist to
// keep narrow.
//
// COST UNIT — costMicroUsd is integer MICRO-US-DOLLARS, not kobo. This is a
// deliberate, documented carve-out from CLAUDE.md's Money hard rule ("money is
// Int kobo"), locked in docs/modules/phase-5.md D2. The Money rule exists so
// that naira a school TRANSACTS never suffers float drift or display ambiguity
// — fees, invoices, payments, refunds, payroll. This column is vendor-cost
// telemetry: the school never sees it, no invoice references it, no
// FinanceService path touches it, and no audit row depends on it. Converting
// USD→kobo at write time would need an FX-rate source that does not exist in
// this repo, plus a rounding policy, and would make the stored value
// un-interpretable later (you cannot recover the USD figure without also
// storing the rate — at which point you have stored USD with extra steps and a
// permanent naira-devaluation artifact in the historical series). The rule's
// actual intent — integers, never Float — is fully preserved. Int max is
// ~2.1e9 µUSD ≈ $2,147 per row, three orders of magnitude above any single
// generation. If AI cost is ever billed back to schools, FX conversion happens
// at BILLING time with the rate recorded then, which is the only correct place
// for it anyway.
//
// pricedAtVersion tags which price table produced costMicroUsd, so a pricing
// change is re-derivable rather than silently mixing units across time.
model AIGeneration {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  // Nullable: not every call is session-scoped (a one-shot lesson-plan
  // generation has no conversation to group under). SetNull rather than
  // Cascade — the cost ledger must survive content deletion, since it is the
  // record that money was spent.
  interactionLogId String?  @map("interaction_log_id")
  // Nullable: system/cron-driven calls (weekly parent summaries) have no
  // acting user. Populated for user-initiated calls so the per-user daily
  // rate limit can count against it.
  userId           String?  @map("user_id")
  model            String
  promptName       String   @map("prompt_name")
  // Plain String, NOT an enum and NOT a FK to a prompt table. This is a
  // historical record: it must be able to hold "report-card-subject-comment@3"
  // forever, including after v3 is deleted from the registry in packages/ai.
  // Enum-ing it would mean a migration per prompt version. Compile-time safety
  // lives at the CALL SITE via the typed registry instead — see
  // docs/modules/phase-5.md D8.
  promptVersion    String   @map("prompt_version")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  latencyMs        Int      @map("latency_ms")
  costMicroUsd     Int      @map("cost_micro_usd")
  pricedAtVersion  String   @map("priced_at_version")
  success          Boolean
  // Redacted before write — no secrets, no PII, no raw prompt echo.
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  interactionLog AIInteractionLog? @relation(fields: [interactionLogId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, createdAt])
  // Serves the per-user daily rate-limit count in the reserve transaction.
  @@index([schoolId, userId, createdAt])
  @@map("ai_generations")
}

// Per-school monthly budget counter.
//
// WHY A COUNTER TABLE AND NOT `SUM(input_tokens + output_tokens)` OVER
// ai_generations — three independent reasons, any one of which is sufficient
// (docs/modules/phase-5.md D4):
//   1. It is a growing-table aggregate on the hot path of EVERY AI call, on a
//      database where ~2s authenticated latency is already normal.
//   2. It would couple the budget to retention: any future pruning of
//      ai_generations would silently reset every school's spend to zero.
//   3. It cannot express a RESERVATION, and a pre-call budget check is
//      fundamentally a reservation — the hard rule says the budget is
//      "enforced before the call, not after", but the true token count is only
//      known after.
//
// tokensReserved is the enforcement column (pessimistic: input estimate +
// max_tokens). tokensActual is the truth, written at settle. The two converge
// as calls settle; tokensReserved is always >= tokensActual.
//
// Carries its own school_id → flat direct-column RLS, the same cheap pattern as
// notification_preferences and the two Phase 1 AI tables. No SECURITY DEFINER
// function is needed (no pre-tenant access, every touch is inside withTenant),
// so the inventory count stays at 16.
model AIBudgetPeriod {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  // First day of the UTC month this row counts. @db.Date, not DateTime: this
  // is a calendar boundary, not a moment — same convention as academic-year /
  // term dates (CLAUDE.md "Prisma column types in raw SQL").
  periodStart    DateTime @map("period_start") @db.Date
  tokensReserved Int      @default(0) @map("tokens_reserved")
  tokensActual   Int      @default(0) @map("tokens_actual")
  costMicroUsd   Int      @default(0) @map("cost_micro_usd")
  callCount      Int      @default(0) @map("call_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, periodStart])
  @@index([schoolId])
  @@map("ai_budget_periods")
}

// ---------- Phase 5 / Slice 2 — Lesson plan generator ----------
//
// The first AI FEATURE, and deliberately the first one: it is the only one of
// ARCHITECTURE.md §7's five that has ZERO dependency on data a school has
// already entered. A school can use it on its first day, before a single
// assessment score exists — which is why it leads (phase-5.md slice order).
//
// TOPIC IS FREE TEXT. There is no Topic table, no syllabus tree, no taxonomy
// (phase-5.md D13). A teacher types "Photosynthesis" the same way they type it
// into Word today. Inventing a canonical Nigerian curriculum topic tree is a
// data model PLUS a content-sourcing problem PLUS an admin UI, and it would
// retroactively define the meaning of MasteryRecord.topicRef — which carries a
// live @@unique constraint. That work happens only when something needs stable
// topic IDENTITY: RAG, mastery tracking, or a question bank. All deferred.
//
// The five content columns mirror ARCHITECTURE.md §7's specified output shape
// ("intro, main content, activities, assessment, homework"). They are separate
// columns rather than one JSON blob for two reasons: the teacher edits and
// regenerates them INDIVIDUALLY (a JSON blob makes a per-section update a
// read-modify-write race between two open tabs), and a per-section NOT NULL
// story is clearer than validating blob shape at the service layer.
//
// quiz is nullable and separate: quiz mode is an optional second generation
// against the same lesson plan, and its output is structured TEXT, not a
// Question bank. A real question bank with per-option rows is CBT territory
// (see docs/deferred.md's CBT capability assessment) and is not this slice.
enum LessonPlanStatus {
  // Generated (or hand-started) and still the teacher's working copy.
  DRAFT
  // Teacher has accepted it. Not an approval GATE in the report-card sense —
  // a lesson plan is the teacher's own working document, not a student-facing
  // record, so CLAUDE.md's teacher-approval hard rule (grades, report
  // comments, behaviour) does not apply. This is a "done editing" marker.
  ACCEPTED
}

model LessonPlan {
  id           String @id @default(uuid())
  schoolId     String @map("school_id")
  // The authoring teacher. Plain scoping column, not a declared relation —
  // same convention as AIGeneration.userId; a lesson plan outlives a staff
  // member's account for record-keeping.
  createdBy    String @map("created_by")
  classLevelId String @map("class_level_id")
  subjectId    String @map("subject_id")

  // Free text. Deliberately NOT a FK — see the header note above.
  topic           String
  objectives      String?
  durationMinutes Int?    @map("duration_minutes")

  status LessonPlanStatus @default(DRAFT)

  // Generated content. All nullable: a row exists from the moment generation
  // is requested, so a failed generation leaves an inspectable record rather
  // than vanishing.
  //
  // Section set follows the standard Nigerian lesson note (prompt v2,
  // 2026-08-17). The generated order is: behaviouralObjectives,
  // instructionalMaterials, previousKnowledge, referenceMaterials,
  // mainContent (Presentation, as numbered Steps), assessment (Evaluation),
  // homework (Assignment), conclusion. That order lives in
  // LESSON_PLAN_SECTION_ORDER in packages/ai, derived from the output schema;
  // this table is storage and deliberately does not re-encode it.
  //
  // `mainContent`/`assessment`/`homework` carry the Presentation/Evaluation/
  // Assignment sections under their original column names — generic enough to
  // stay accurate, and reusing them kept the v2 restructure free of a data
  // migration or column rename.
  behaviouralObjectives  String? @map("behavioural_objectives")
  instructionalMaterials String? @map("instructional_materials")
  previousKnowledge      String? @map("previous_knowledge")
  referenceMaterials     String? @map("reference_materials")
  mainContent            String? @map("main_content")
  assessment             String?
  homework               String?
  conclusion             String?
  quiz                   String?

  // LEGACY, pre-v2 (generic international format). No longer generated or
  // edited; retained so lesson notes written before 2026-08-17 stay readable
  // rather than losing content to the restructure. `introduction` was replaced
  // by previousKnowledge + behaviouralObjectives; `activities` was folded into
  // the Presentation steps, where the Nigerian format puts pupil activity.
  introduction String?
  activities   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cascade matches ClassSubject's convention directly above: deleting a
  // subject or class level already cascades class_subjects, and a lesson plan
  // scoped to a level/subject that no longer exists is not recoverable
  // content — it has no valid curriculum context to be read in.
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, createdBy])
  @@index([schoolId, classLevelId, subjectId])
  @@map("lesson_plans")
}

// ---------- Phase 2 / Slice 1 — Grading configuration ----------
//
// Three per-school config tables, all seeded with sensible WAEC-style defaults
// at school creation (signupOwner, same tx as the class-level seed) and fully
// editable thereafter. They carry their own school_id → flat direct-column RLS,
// the same cheap pattern as every Phase 1 table. See docs/modules/phase-2.md
// (Data model → Grading configuration) for the locked design.
//
// Exactly one scheme per school (the @@unique on school_id enforces it). Most
// Nigerian schools run a single CA1+CA2+Exam scheme across every subject;
// per-level / per-subject schemes are explicitly deferred (phase-2.md "What's
// deferred"). Defaults: CA1=20, CA2=20, Exam=60 (Σ=100) — see
// packages/db/src/seeds/grading.ts.
model GradingScheme {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String // "WAEC-style (default)"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  components GradingComponent[]

  @@unique([schoolId]) // one scheme per school
  @@map("grading_schemes")
}

// N rows per scheme (CA1, CA2, Project, Exam, Practical…). weight is an integer
// percent; the set of components for a school MUST sum to exactly 100. That
// invariant is enforced ATOMICALLY OVER THE WHOLE SET at the service layer
// (and the bulk-PUT Zod refine), NOT by a DB constraint — same call as Phase 1
// made for the enrollment academicYearId-consistency invariant. See
// grading.service.ts and docs/modules/phase-2.md "Hard rules → Weights sum to 100".
//
// The `scores AssessmentScore[]` back-relation landed in Phase 2 / Slice 2
// (alongside the AssessmentScore table). onDelete: Restrict on the score side
// blocks deleting a component that still has scores — a guard against orphaning
// entered marks (the freeze invariant in grading.service.ts is the friendlier,
// earlier gate; this FK is the DB backstop).
model GradingComponent {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  schemeId   String   @map("scheme_id")
  key        String // "ca1","ca2","project","exam","practical" — stable per school
  label      String // "First CA", "Project"
  weight     Int // integer percent; Σ weight per scheme = 100
  orderIndex Int      @map("order_index") // display order, left→right in the gradebook grid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  scheme GradingScheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  scores AssessmentScore[]

  @@unique([schoolId, schemeId, key])
  @@index([schoolId])
  @@map("grading_components")
}

// Per-school letter ↔ score-range map. WAEC scale pre-populated at school
// creation; fully editable. Ranges are inclusive on both ends and must tile
// 0..100 without gaps or overlaps — a service-layer invariant (+ bulk-PUT Zod
// refine), not a DB constraint. Default bands A1..F9 — see
// packages/db/src/seeds/grading.ts.
model GradeBoundary {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  letter     String // "A1","B2","B3","C4","C5","C6","D7","E8","F9"
  minScore   Int      @map("min_score") // inclusive, 0..100
  maxScore   Int      @map("max_score") // inclusive, 0..100
  remark     String? // "Excellent","Very Good",...
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, letter])
  @@index([schoolId])
  @@map("grade_boundaries")
}

// ---------- Phase 2 / Slice 2 — Assessment + AssessmentScore ----------
//
// The academic record's source of truth (AssessmentScore) and its denormalized
// per-(student × subject × term) summary (Assessment). See docs/modules/
// phase-2.md (Data model → Assessment) for the locked design. Both carry their
// own school_id → flat direct-column RLS, like every Phase 1/2 table.
//
// AssessmentScore is the raw mark a teacher types. score ∈ [0, component.weight]
// (STRICT — validated at the DTO and re-validated against the LIVE component row
// in the service; the component's weight is the ceiling). The summary below is
// DERIVED from these rows and materialized in the SAME tx as the score write
// (phase-2.md Hard rules "Grades are computed server-side"). There is no FK
// between the two tables — they are joined by the composite
// (student, subject, term); the score's only enforced relation is to the
// grading component (we need its live weight to validate).
model AssessmentScore {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  studentId   String   @map("student_id")
  subjectId   String   @map("subject_id")
  termId      String   @map("term_id")
  componentId String   @map("component_id")
  score       Int // 0..component.weight (strict; already-weighted units)
  enteredBy   String   @map("entered_by") // users.id (plain FK; mirrors ImportJob.createdBy — captures admin overrides)
  enteredAt   DateTime @default(now()) @map("entered_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  component GradingComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([schoolId, studentId, subjectId, termId, componentId])
  @@index([schoolId])
  @@index([schoolId, termId, subjectId])
  @@map("assessment_scores")
}

// Denormalized summary: one row per (student × subject × term). Materialized on
// score entry (and re-materialized on the slice-4 aggregation pass) — NOT
// live-rendered — so the gradebook and report card read one row per cell.
//   totalScore      = EXACT Σ (AssessmentScore.score) over the entered
//                     components, 0..100 (no averaging/rounding/extrapolation —
//                     the load-bearing invariant slice 4 ranks against)
//   letterGrade     = resolved from GradeBoundary at compute time (nullable: a
//                     pathological boundary gap would leave it null)
//   classArmId      = denormalized from the student's Enrollment for the term
//                     (score entry rejects a student with no enrollment)
//   subjectPosition / classPosition  = LEFT NULL by slice 2; slice 4 computes
//                     them in the explicit aggregation pass (positions depend on
//                     every other student's total, so they are not a per-write
//                     side effect).
//   subjectSignedOffAt/By  = the subject teacher's per-(student × subject)
//                     sign-off. In slice 2 a score POST/PATCH CLEARS this (the
//                     implicit unlock); slice 6 owns the arm-state workflow gate.
model Assessment {
  id                  String    @id @default(uuid())
  schoolId            String    @map("school_id")
  studentId           String    @map("student_id")
  subjectId           String    @map("subject_id")
  termId              String    @map("term_id")
  academicYearId      String    @map("academic_year_id") // denormalized from term
  classArmId          String    @map("class_arm_id") // denormalized from enrollment for position scans
  totalScore          Int       @map("total_score") // 0..100
  letterGrade         String?   @map("letter_grade")
  remark              String?
  subjectPosition     Int?      @map("subject_position")
  classPosition       Int?      @map("class_position")
  subjectComment      String?   @map("subject_comment") // per-subject; AI-hook-ready (Phase 5), plain text
  subjectSignedOffAt  DateTime? @map("subject_signed_off_at")
  subjectSignedOffBy  String?   @map("subject_signed_off_by") // users.id
  computedAt          DateTime  @map("computed_at") // MATERIALIZATION stamp (set on score entry)
  // POSITIONS stamp (Phase 2 / Slice 4) — set by the aggregation pass when it
  // writes subjectPosition/classPosition. Distinct from computedAt (which is the
  // score-materialization moment); the status endpoint sources max() of this.
  positionsComputedAt DateTime? @map("positions_computed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, studentId, subjectId, termId])
  @@index([schoolId])
  @@index([schoolId, termId, subjectId, classArmId]) // position scans
  @@index([schoolId, classArmId, termId])
  @@map("assessments")
}

// ---------- Phase 2 / Slice 5 — Report card ----------
//
// Materialized artifact, NOT live-rendered. One row per (student × term). The
// build pass (POST /report-cards/arm/build) runs the slice-4 full aggregation
// in-tx, then snapshots the term's rollup onto this row so the PDF reads a
// FROZEN rollup (not a live recompute). Carries the workflow state (slice 6
// drives the state machine; slice 5 only ever creates DRAFT), the three
// free-text comment grains, and the R2 pointer to the rendered PDF (slice 5 cp2
// renders; pdfStatus tracks it).
//
// overallAverage is an Int in hundredths (7350 = 73.50%) — the money/kobo rule
// applied to averages, no Float in grade math. overallPosition mirrors the
// student's Assessment.classPosition (denormalized here for the PDF footer).
// principalNote is per-arm-term, written once and denormalized identically onto
// every card in the arm (slice 6). Carries its own school_id → flat
// direct-column RLS, like every Phase 1/2 table.
model ReportCard {
  id                  String              @id @default(uuid())
  schoolId            String              @map("school_id")
  studentId           String              @map("student_id")
  termId              String              @map("term_id")
  academicYearId      String              @map("academic_year_id")
  classArmId          String              @map("class_arm_id")
  status              ReportCardStatus    @default(DRAFT)
  overallTotal        Int?                @map("overall_total") // Σ subject totals
  overallAverage      Int?                @map("overall_average") // avg × 100 (hundredths), no Float
  overallPosition     Int?                @map("overall_position") // = student's Assessment.classPosition
  subjectsCount       Int?                @map("subjects_count")
  formTeacherComment  String?             @map("form_teacher_comment") // per student-term; AI-hook-ready (Phase 5)
  principalNote       String?             @map("principal_note") // per arm-term; AI-hook-ready (Phase 5)
  formReviewedAt      DateTime?           @map("form_reviewed_at")
  formReviewedBy      String?             @map("form_reviewed_by") // users.id
  principalApprovedAt DateTime?           @map("principal_approved_at")
  principalApprovedBy String?             @map("principal_approved_by") // users.id
  releasedAt          DateTime?           @map("released_at")
  pdfStatus           ReportCardPdfStatus @default(PENDING) @map("pdf_status")
  artifactUrl         String?             @map("artifact_url") // R2: schools/<id>/report-cards/<termId>/<studentId>.pdf
  generatedAt         DateTime?           @map("generated_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([schoolId, studentId, termId])
  @@index([schoolId])
  @@index([schoolId, classArmId, termId, status])
  @@map("report_cards")
}

enum ReportCardStatus {
  DRAFT // created; scores may still be changing
  SUBJECT_REVIEWED // every subject for the arm signed off by its subject teacher
  FORM_REVIEWED // form teacher reviewed the arm + wrote form comments
  PRINCIPAL_APPROVED // principal approved the arm
  RELEASED // parent-visible; PDF materialized
}

enum ReportCardPdfStatus {
  PENDING // not yet enqueued / awaiting render
  GENERATING // BullMQ job running Puppeteer
  GENERATED // artifactUrl populated
  FAILED // render failed; retryable
}

// ---------- Attendance (Phase 2 / Slice 7 — daily, universal) ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Daily attendance. UNIVERSAL — every school, no opt-in. One row per
// (student × date). Re-marking updates the existing row (upsert on the unique
// key), never inserts a duplicate. Flat plain-FK convention (no Prisma
// relations): studentId / classArmId / termId / markedBy are plain TEXT
// referencing the relevant table — same choice as the assessment tables.
model AttendanceRecord {
  id         String           @id @default(uuid())
  schoolId   String           @map("school_id")
  studentId  String           @map("student_id")
  classArmId String           @map("class_arm_id") // arm context at marking time
  termId     String           @map("term_id") // term containing `date`
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedBy   String           @map("marked_by") // users.id
  markedAt   DateTime         @default(now()) @map("marked_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([schoolId, studentId, date]) // one record per student per date
  @@index([schoolId])
  @@index([schoolId, classArmId, date]) // register query
  @@index([schoolId, termId]) // summary query
  @@map("attendance_records")
}

// ---------- Phase 3 / Slice 4 — Fee catalog ----------
//
// FeeCategory: school-defined taxonomy (Tuition, Hostel, Sports, PTA Levy…).
// FeeItem: a single fee with optional scope; NULL scope field = "applies to all".
// Invoice generation (slice 6) matches a FeeItem when every non-null scope field
// equals the student's value. Scope rule: classArmId must not be set without
// classLevelId — enforced in the service layer (Zod refine + merge-check).
//
// Only the FeeItem→FeeCategory relation is enforced; the four scope FKs
// (classLevelId, classArmId, termId, academicYearId) follow the project's
// plain-FK convention: stored as TEXT?, existence validated in the service via
// withTenant, not enforced at the DB layer (keeps the schema lean, avoids
// cross-module FK fragility). See CLAUDE.md "Coding patterns → Plain-FK".

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  feeItems FeeItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_categories")
}

model FeeItem {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  categoryId     String   @map("category_id")
  name           String
  amount         Int // kobo — never Float (CLAUDE.md money hard rule)
  classLevelId   String?  @map("class_level_id") // null = all levels
  classArmId     String?  @map("class_arm_id") // null = all arms; requires classLevelId when set
  termId         String?  @map("term_id") // null = all terms
  academicYearId String?  @map("academic_year_id") // null = all years
  active         Boolean  @default(true)
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  // Non-unique scan index for invoice generation (slice 6): matches student's
  // (level, term, year) against fee items. Non-unique because a school can have
  // many items with the same scope combination (e.g. two hostel fees for JSS1 T1).
  @@index([schoolId, classLevelId, termId, academicYearId])
  @@map("fee_items")
}

// ---------- Phase 3 / Slice 5 — Discount rules ----------
//
// A discount rule is a manual per-student assignment created by a
// bursar/owner/admin. No rule engine, no auto-triggering, no eligibility
// conditions. Each rule targets exactly one student and either one FeeItem
// (feeItemId set) or one FeeCategory (feeCategoryId set) — never both, never
// neither (Zod refine in DTO + service re-check for defence-in-depth).
//
// Duration:
//   TERM      — applies for a single term; termId required
//   SESSION   — applies for a full academic year; academicYearId required
//   LIFETIME  — no date bound; no term/year fields needed
//
// Discount type:
//   PERCENTAGE   → value is basis points (Int, 1–9999; 1000 = 10%, 9999 = 99.99%)
//   FIXED_AMOUNT → value is kobo (Int, positive)
//   FULL_WAIVER  → value is NULL (entire fee waived)
//
// Stacking is allowed. Total cannot go below zero — enforced at invoice
// generation (slice 6), not here. All FK columns (studentId, feeItemId,
// feeCategoryId, termId, academicYearId) follow the plain-FK convention:
// validated in the service via withTenant, not enforced at the DB layer.

enum DiscountDuration {
  TERM
  SESSION
  LIFETIME
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FULL_WAIVER
}

model DiscountRule {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  studentId      String           @map("student_id") // plain-FK — validated in service
  name           String
  // Exactly one of feeItemId / feeCategoryId must be set (Zod refine + service re-check)
  feeItemId      String?          @map("fee_item_id")
  feeCategoryId  String?          @map("fee_category_id")
  duration       DiscountDuration
  termId         String?          @map("term_id") // required when duration = TERM
  academicYearId String?          @map("academic_year_id") // required when duration = SESSION
  discountType   DiscountType     @map("discount_type")
  // basis points 1–9999 (PERCENTAGE) | kobo (FIXED_AMOUNT) | NULL (FULL_WAIVER)
  value          Int?
  active         Boolean          @default(true)
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("discount_rules")
}

// ---------- Phase 3 / Slice 6 — Invoices (snapshot-on-issue) ----------
//
// SNAPSHOT-ON-ISSUE: the `items` JSONB column freezes the fee + discount state
// at the moment the invoice is issued. FeeItem amounts and DiscountRule values
// can be edited freely afterwards; issued invoices are unaffected because they
// carry the frozen snapshot. (Mirrors the released-report-card snapshot pattern.)
//
// The @@unique([schoolId, studentId, termId]) constraint enforces one invoice per
// student per term. CANCELLED invoices hold the slot — re-generation after cancel
// is not supported (void + create a new record is the intended workflow).
//
// `totalPaid` starts at 0 and is updated by the payment service (slice 7).

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model Invoice {
  id             String        @id @default(uuid())
  schoolId       String        @map("school_id")
  studentId      String        @map("student_id") // plain-FK — validated in service
  termId         String        @map("term_id") // plain-FK
  academicYearId String        @map("academic_year_id") // denormalised from term at issue time
  // Immutable issuance-time arm snapshot. Deliberately a plain FK: deleting or
  // renaming an academic arm must not rewrite historical finance attribution.
  classArmId     String?       @map("class_arm_id")
  status         InvoiceStatus @default(ISSUED)
  // Frozen snapshot of fee line items and applied discounts at issue time.
  // Shape: [{ feeItemId, categoryName, feeName, amount, discountsApplied: [{ ruleId, ruleName, discountAmount }], netAmount }]
  items          Json
  totalAmount    Int           @map("total_amount") // Σ item.amount (kobo)
  totalDiscount  Int           @map("total_discount") // Σ capped item discount (kobo)
  totalDue       Int           @map("total_due") // totalAmount − totalDiscount (kobo)
  totalPaid      Int           @default(0) @map("total_paid") // updated by slice 7 payment service
  dueDate        DateTime?     @map("due_date") @db.Date
  issuedAt       DateTime?     @map("issued_at")
  issuedBy       String?       @map("issued_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  payments       Payment[]
  paymentPlans   PaymentPlan[]
  paymentLinks   PaymentLink[]

  @@unique([schoolId, studentId, termId])
  @@index([schoolId, status])
  @@index([schoolId, termId, classArmId])
  @@map("invoices")
}

enum PaymentLinkStatus {
  CREATING
  LIVE
  PAID
  ARCHIVE_PENDING
  ARCHIVED
  CREATE_FAILED
}

model PaymentLink {
  id                   String            @id @default(uuid())
  schoolId             String            @map("school_id")
  invoiceId            String            @map("invoice_id")
  requestId            BigInt?           @map("request_id")
  requestCode          String?           @unique @map("request_code")
  hostedUrl            String?           @map("hosted_url")
  paystackCustomerCode String?           @map("paystack_customer_code")
  amount               Int
  currency             String            @default("NGN")
  status               PaymentLinkStatus @default(CREATING)
  createdBy            String            @map("created_by")
  failureCode          String?           @map("failure_code")
  retryCount           Int               @default(0) @map("retry_count")
  lastAttemptAt        DateTime           @default(now()) @map("last_attempt_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  archivedAt           DateTime?          @map("archived_at")
  paidAt               DateTime?          @map("paid_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, invoiceId, status])
  @@map("payment_links")
}

// ---------- Phase 3 / Slice 7 — Payments (manual recording + receipts) ----------
//
// Manual payments (CASH, POS, BANK_TRANSFER) are created with status = SUCCESS;
// PENDING is reserved for the Paystack async path (slice 8).
//
// totalPaid on Invoice is recomputed via SUM(amount) WHERE status = 'SUCCESS'
// after each payment write — idempotent, safe for future reversals (slice 11).
//
// @@unique([schoolId, paystackReference]) is implemented as a partial unique index
// in the migration (WHERE paystack_reference IS NOT NULL) so manual rows (null)
// coexist without violating the constraint. Prisma doesn't know about the WHERE
// clause — it sees the unique as declared here, which is sufficient for the client.

enum PaymentMethod {
  PAYSTACK
  CASH
  POS
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model Payment {
  id                String        @id @default(uuid())
  schoolId          String        @map("school_id")
  invoiceId         String        @map("invoice_id")
  studentId         String        @map("student_id") // denormalised from invoice at record time
  amount            Int // kobo — always > 0
  method            PaymentMethod
  status            PaymentStatus @default(SUCCESS) // manual = SUCCESS; Paystack = PENDING (slice 8)
  paystackReference String?       @map("paystack_reference") // null for manual; slice 8 sets this
  paystackData      Json?         @map("paystack_data")
  reference         String? // bank transfer ref, POS txn ID, cheque no.
  receiptNumber     String?       @map("receipt_number") // "RCP-<id-first-8-upper>"
  receiptUrl        String?       @map("receipt_url") // R2 canonical path; signed on demand
  recordedBy        String?       @map("recorded_by") // userId; null for Paystack webhook (slice 8)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([schoolId, paystackReference])
  @@index([schoolId, invoiceId])
  @@index([schoolId, studentId])
  @@map("payments")
}

// ---------- Phase 3 / Slice 11 — Refunds ----------
//
// A Refund represents money returned to a parent (Paystack path) or an
// administrative reversal of a manual payment (no money movement). Creating a
// Refund always marks the linked Payment as REVERSED and recomputes the invoice
// totalPaid + status. Full reversals only in slice 11 (amount === payment.amount).
//
// status: PROCESSED for manual payments (immediate); PROCESSED or FAILED for
// Paystack payments (result of the Paystack refund API call). REQUESTED is
// reserved for a future async refund queue.
//
// processedBy: the userId of the admin/owner who initiated the refund.

enum RefundStatus {
  REQUESTED
  PROCESSED
  FAILED
}

model Refund {
  id                String       @id @default(uuid())
  schoolId          String       @map("school_id")
  paymentId         String       @map("payment_id")
  amount            Int // kobo — equals payment.amount (full reversal only)
  reason            String
  status            RefundStatus
  paystackRefundRef String?      @map("paystack_refund_ref") // Paystack refund ID; null for manual reversals
  processedBy       String       @map("processed_by") // userId of the admin/owner
  createdAt         DateTime     @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([schoolId, paymentId])
  @@map("refunds")
}

// ---------- Phase 3 / Slice 9 — Installment plans ----------
//
// A PaymentPlan is a named schedule of expected payment dates + amounts.
// It does NOT move money — payments still flow through recordManual / Paystack.
// Constraint: Σ installment.amount === invoice.totalDue (enforced in service).
// One plan per invoice; only allowed when invoice.status ∈ {ISSUED, PARTIALLY_PAID}.
//
// After every successful payment, PaymentPlanService.recomputeInstallmentsPaid()
// walks installments ordered by dueDate and marks paid = true for every installment
// whose cumulative amount is covered by invoice.totalPaid. Allocation is purely
// threshold-based — no payment-to-installment link is stored.

model PaymentPlan {
  id           String                   @id @default(uuid())
  schoolId     String                   @map("school_id")
  invoiceId    String                   @map("invoice_id")
  name         String
  createdBy    String                   @map("created_by")
  createdAt    DateTime                 @default(now()) @map("created_at")
  invoice      Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  installments PaymentPlanInstallment[]

  @@unique([schoolId, invoiceId])
  @@index([schoolId, invoiceId])
  @@map("payment_plans")
}

model PaymentPlanInstallment {
  id       String      @id @default(uuid())
  schoolId String      @map("school_id")
  planId   String      @map("plan_id")
  amount   Int // kobo — always > 0
  dueDate  DateTime    @map("due_date") @db.Date
  paid     Boolean     @default(false)
  plan     PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([schoolId, planId])
  @@map("payment_plan_installments")
}

// ---------- Expense tracking (Phase 3 / Slice 13) ----------
//
// ExpenseCategory mirrors FeeCategory exactly (school-defined taxonomy,
// name unique per school, soft-deactivate via `active`).
//
// Expense.categoryId is a PLAIN FK — no enforced Prisma relation, no DB-level
// FOREIGN KEY constraint. Same convention as FeeItem's scope columns
// (classLevelId/classArmId/termId/academicYearId), NOT the FeeItem.category
// exception (which DOES get an enforced relation with onDelete: Restrict).
// Consequences, load-bearing for the service layer:
//   - ExpenseCategoryService.delete cannot use a Prisma `_count` relation
//     shorthand (there's no relation to count through) — it runs an explicit
//     `db.expense.count({ where: { categoryId } })` guard instead.
//   - ExpensesService.create/update must validate categoryId exists AND
//     belongs to the caller's school before writing (no DB FK to catch a
//     dangling reference).
//   - The web UI resolves categoryId -> name client-side against an
//     already-fetched category list, same pattern as teacher-assignments-
//     section.tsx's armName()/subjectName() helpers — no server-side include.
//
// No snapshot/freeze semantics (unlike Invoice/Payment): an Expense doesn't
// feed any derived, stored total elsewhere — the finance dashboard (slice 14)
// sums expenses at read time. Amount/date/description/category are freely
// editable after creation.
model ExpenseCategory {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  categoryId  String   @map("category_id") // plain FK -> expense_categories.id — see header comment
  amount      Int // kobo — never Float (CLAUDE.md money hard rule)
  description String?
  incurredAt  DateTime @map("incurred_at") @db.Date
  receiptUrl  String?  @map("receipt_url") // R2 canonical path — signed on demand; see storage.types.ts "expense-receipt"
  recordedBy  String   @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([schoolId, incurredAt])
  @@index([schoolId, categoryId])
  @@map("expenses")
}

// ---------- Payroll (Phase 3 / Slice 12 CP3+CP4) ----------------------------
//
// CP3 (this migration): DRAFT -> APPROVED, no money movement. PAID is set by
// CP4 once Paystack transfers land — paystackTransferCode stays null until
// then. FAILED covers a CP4 transfer rejection; CP3 never produces it.
// PROCESSING is set synchronously by CP4's transfer() right before calling
// Paystack, and left in place until the transfer.success/failed/reversed
// webhook resolves it to PAID or FAILED — there is no PAID/FAILED transition
// that doesn't pass through PROCESSING first (see PayrollService.transfer).
//
// grossSalary/deductions are entered fresh per period (no reusable "salary
// structure" table — see the plan-first D2: build one only if schools prove
// they want a prefill shortcut). deductions is a flat line-item list
// ([{ name, amount }] kobo), NOT a Nigerian PAYE tax-bracket engine (D3) —
// the bursar computes/enters PAYE externally as one of the line items.
// netSalary is computed server-side (grossSalary - sum(deductions)) and
// stored, same "compute once, store the result" discipline as Invoice's
// totalDue snapshot.
//
// userId is a plain FK (no relation) — same convention as Expense.categoryId
// and FeeItem's scope columns; the service validates existence + same-school
// before writing.
enum PayrollStatus {
  DRAFT
  APPROVED
  PROCESSING
  PAID
  FAILED
}

model PayrollItem {
  id                   String        @id @default(uuid())
  schoolId             String        @map("school_id")
  userId               String        @map("user_id") // plain FK -> users.id — the staff member being paid
  period               String // e.g. "2026-07" — free-text, not a Term/AcademicYear FK (payroll runs monthly, terms don't)
  grossSalary          Int           @map("gross_salary") // kobo — never Float (CLAUDE.md money hard rule)
  deductions           Json // [{ name: string, amount: Int }] kobo — flat line items, not a tax engine (see header)
  netSalary            Int           @map("net_salary") // computed: grossSalary - sum(deductions), stored
  status               PayrollStatus @default(DRAFT)
  payslipUrl           String?       @map("payslip_url") // R2 canonical path — signed on demand; see storage.types.ts "payroll-payslip"
  approvedBy           String?       @map("approved_by") // userId of the admin/owner/bursar who approved
  approvedAt           DateTime?     @map("approved_at")
  paystackTransferCode String?       @map("paystack_transfer_code") // null until CP4
  createdBy            String        @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@unique([schoolId, userId, period]) // one payroll item per staff member per period
  @@index([schoolId, period])
  @@index([schoolId, userId])
  @@map("payroll_items")
}

// Current bank details for a staff member — NOT a history table. One row per
// (schoolId, userId); changing banks updates the row in place, same mutable-
// fields convention as TeacherProfile. Reused across every monthly payroll
// run, which is why this isn't a column on PayrollItem (would mean
// re-entering bank details every period) or on User (would push a Phase-3
// finance concern onto a Phase-0 foundational table shared by every future
// user type). userId is a plain FK (no relation) — same convention as
// Expense.categoryId and PayrollItem.userId; the service validates
// existence + same-school before writing.
//
// accountName is Paystack's OWN resolved name from the /bank/resolve call,
// never a user-typed value — the operator sees it and confirms before
// saving (Payroll CP4 plan-first D1's "verify" UX step), and the server
// independently re-resolves and compares at create time rather than
// trusting the client's echoed value.
//
// paystackRecipientCode is created EAGERLY at save time (plan-first D2), not
// lazily at first transfer — a bad account number surfaces during this
// low-stakes "add bank details" step, not during a time-pressured payroll
// run. `active` soft-disables an account (staff left, account compromised)
// without losing the history of what was on file.
model StaffBankAccount {
  id                    String   @id @default(uuid())
  schoolId              String   @map("school_id")
  userId                String   @map("user_id") // plain FK -> users.id — the staff member
  bankCode              String   @map("bank_code")
  accountNumber         String   @map("account_number")
  accountName           String   @map("account_name") // Paystack-resolved, never user-typed
  paystackRecipientCode String   @map("paystack_recipient_code")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, userId]) // one current bank account per staff member per school
  @@map("staff_bank_accounts")
}

// ---------- Subject-period attendance (Phase 2 / Slice 8 — opt-in) ----------

// Subject-period attendance. SEPARATE table from daily — period-level semantics,
// per-subject query patterns, and OPT-IN per school via
// School.subjectAttendanceEnabled (the endpoints 404 until a school enables it).
// Senior classes that run a period timetable use it; primary classes don't. One
// row per (student × subject × date × period). Reuses the AttendanceStatus enum.
// Flat plain-FK convention (no Prisma relations) — same as the daily table.
model SubjectAttendanceRecord {
  id         String           @id @default(uuid())
  schoolId   String           @map("school_id")
  studentId  String           @map("student_id")
  classArmId String           @map("class_arm_id") // arm context at marking time
  subjectId  String           @map("subject_id")
  termId     String           @map("term_id") // term containing `date`
  date       DateTime         @db.Date
  period     Int // period number within the day (≥1, no upper bound)
  status     AttendanceStatus
  note       String?
  markedBy   String           @map("marked_by") // users.id
  markedAt   DateTime         @default(now()) @map("marked_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([schoolId, studentId, subjectId, date, period]) // one record per student per subject per period per date
  @@index([schoolId])
  // Explicit index names: the auto-generated names for these two would both
  // truncate to the same 63-char Postgres identifier and collide.
  @@index([schoolId, classArmId, subjectId, date], map: "subject_attendance_arm_subject_date_idx") // register query
  @@index([schoolId, classArmId, subjectId, termId], map: "subject_attendance_arm_subject_term_idx") // summary query (arm-keyed, mirrors slice 7's term index)
  @@map("subject_attendance_records")
}

// ---------- Phase 5 / Slice 5 — Weekly parent progress summary ----------
//
// One row per (student, week). The row IS the delivery record: the portal
// reads it, the email send stamps it, and a re-run of the sweep finds it and
// skips. There is no separate outbox table — one guardian-facing artifact per
// child per week does not need one, and the @@unique below is what makes the
// weekly cron idempotent (a retried or double-scheduled sweep cannot bill the
// school twice for the same child's week).
//
// NO APPROVAL GATE, BY DECISION (phase-5.md D16) — and this table is where
// that decision is most visible, because it is the ONE piece of AI output in
// the product that has no accepted/suggested split. Slices 3 and 4 write a
// suggestion to ai_interaction_logs and require a separate permissioned write
// to reach a student's record; this row is written once and is immediately
// readable by the parent. The control is School.parentSummaryEnabled
// (default FALSE), not a human reviewer. If that ever feels too thin against
// real output, the migration path is additive: a `releasedAt` column, null
// until a form teacher releases the week, with the portal filtering on it.
//
// WHY A TABLE AND NOT ai_interaction_logs (which slices 3-4 reuse): those hold
// SUGGESTIONS a teacher may never accept — loose payload, no uniqueness, no
// delivery semantics. This is a delivered artifact a parent can re-read weeks
// later, needs a stable per-week identity to be idempotent, and is queried by
// the portal on a hot path (guardian opens a child's page). A typed table with
// a real unique constraint is the right shape; a JSON payload keyed by a
// loose sessionRef is not.
//
// weekStart is @db.Date and always a MONDAY (UTC), per CLAUDE.md's DATE
// convention — a summary covers a calendar week, not a moment, and storing a
// timestamp would reintroduce exactly the "midnight in which zone?" question
// the convention exists to close.
model ParentSummary {
  id        String @id @default(uuid())
  schoolId  String @map("school_id")
  studentId String @map("student_id")

  // Monday of the covered week, UTC. The week covered is [weekStart,
  // weekStart + 7 days).
  weekStart DateTime @map("week_start") @db.Date

  // The generated note. NOT nullable, unlike lesson_plans' content columns:
  // there is no user-visible draft state here, so a row only exists once
  // there is something to show. A failed generation writes no row and the
  // next sweep retries the week.
  summary String

  // Which prompt revision wrote it. Same reasoning as ai_generations'
  // promptVersion — a quality complaint about a specific week's note must be
  // traceable to the prompt that produced it, and prompt versions bump often.
  promptVersion String @map("prompt_version")

  // Email delivery stamp. Null = generated but not emailed (either the
  // school has email notifications off, no guardian has an email address, or
  // the send failed — all three are ordinary states, not errors). The portal
  // does not care: it reads the row regardless. This column exists so a
  // re-run does not re-send, and so "did the parent actually get it?" is
  // answerable.
  emailedAt DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Cascade on the student: a deleted student's weekly notes are not
  // recoverable content and have no reader once the child is gone. Contrast
  // with ai_generations, which deliberately survives content deletion because
  // it is the record that money was spent.
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, weekStart])
  @@index([schoolId])
  // The portal's read: one child's notes, newest first.
  @@index([schoolId, studentId, weekStart])
  @@map("parent_summaries")
}

// ---------- Paystack assisted setup (2026-08-15) ----------------------------
//
// See docs/modules/paystack-assisted-setup.md for the full plan-first.
//
// Why this table exists: School.paystackSubaccountCode (2026-07-31) gave a
// school somewhere to PUT a subaccount code, but no way to OBTAIN one.
// Paystack subaccounts belong to the integration that created them, and the
// API holds a single platform-wide PAYSTACK_SECRET_KEY (phase-4.md §8 D4) —
// so a code a school creates in its own dashboard is invisible to our
// GET /subaccount/:code check and can never be saved. Setup is therefore
// assisted: the school submits its banking details here, the platform
// operator creates the subaccount on SchoolKit's integration, and returns
// the ACCT_ code for the school to paste into Settings -> Payments.
//
// D1: these fields are DATA-ONLY. The notification email to
// PAYSTACK_SETUP_EMAIL carries school name + request id + a link, never any
// field below. The platform-admin dashboard is the real review surface.
//
// D2: accountNumber is plaintext, matching StaffBankAccount.accountNumber
// (Phase 3 / Slice 12 payroll) which already stores staff members' PERSONAL
// account numbers in the clear. BVN is encrypted because it is a national
// identifier; a business account number plus bank name enables paying money
// IN, not taking it out. Encrypting here while payroll stays plaintext would
// be inconsistent. Logs redact it and audit metadata stores last 4 only.
// If pgcrypto is ever wanted, it applies to BOTH tables in one PR.
//
// A request has a lifecycle and can legitimately recur (typo, bank change,
// re-submission after rejection), which is why this is its own table rather
// than flat columns on School — same reasoning as NotificationPreference
// (phase-4.md §8 D3). No school_id FK, same convention as
// grading_schemes/guardians/notification_preferences.

enum PaystackSetupStatus {
  PENDING
  FULFILLED
  REJECTED
}

model PaystackSetupRequest {
  id       String @id @default(uuid())
  schoolId String @map("school_id")

  // What the school typed. businessName is what parents see on the Paystack
  // checkout page and on settlement statements — prefilled from School.name
  // in the form, but editable, because a school's trading name and its
  // registered banking name are not always the same string.
  businessName  String @map("business_name")
  bankName      String @map("bank_name")
  // NUBAN — 10 digits, validated at the DTO. Paystack independently resolves
  // this against the bank at subaccount-creation time and fails on mismatch,
  // which is the real check; this column is what the operator keys in.
  accountNumber String @map("account_number")
  accountName   String @map("account_name")

  contactName  String @map("contact_name")
  contactEmail String @map("contact_email")
  contactPhone String @map("contact_phone")

  status PaystackSetupStatus @default(PENDING)

  // Set at fulfilment: WHICH code was issued against WHICH request. This is
  // the audit trail of how School.paystackSubaccountCode came to hold what it
  // holds — that column stays the operational value the payment path reads.
  // Nothing reads this one to make a decision.
  subaccountCode String? @map("subaccount_code")

  // Operator's free text — why a request was rejected, or anything worth
  // recording about a fulfilment. Never parsed.
  notes String?

  submittedBy String    @map("submitted_by") // userId — owner/admin who submitted
  submittedAt DateTime  @default(now()) @map("submitted_at")
  // Null until the operator acts. fulfilledBy is a platform-admin userId,
  // which is deliberately NOT in this school's users table.
  fulfilledBy String?   @map("fulfilled_by")
  fulfilledAt DateTime? @map("fulfilled_at")

  // The one query the school side makes ("my latest request") and the one the
  // operator makes ("everything still pending") both key off this pair.
  @@index([schoolId, status])
  @@map("paystack_setup_requests")
}
