{
  "name": "school-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@school-kit/api",
    "dev:web": "turbo run dev --filter=@school-kit/web",
    "dev:portal": "turbo run dev --filter=@school-kit/portal",
    "dev:mobile": "turbo run dev --filter=@school-kit/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @school-kit/db migrate",
    "db:reset": "pnpm --filter @school-kit/db migrate:reset",
    "db:seed": "pnpm --filter @school-kit/db seed",
    "db:seed:prod": "pnpm --filter @school-kit/db seed:prod",
    "dev:seed": "pnpm --filter @school-kit/db dev:seed",
    "db:studio": "pnpm --filter @school-kit/db studio",
    "db:list-smoke": "pnpm --filter @school-kit/db list-smoke",
    "db:prune-smoke": "pnpm --filter @school-kit/db prune-smoke",
    "db:backfill-school-defaults": "pnpm --filter @school-kit/db backfill-school-defaults",
    "db:disable-ai-per-school": "pnpm --filter @school-kit/db disable-ai-per-school",
    "db:verify-disable-ai-audit": "pnpm --filter @school-kit/db verify-disable-ai-audit",
    "ai:eval": "pnpm --filter @school-kit/ai eval",
    "clean": "turbo run clean && rm -rf node_modules",
    "kill-ports": "npx kill-port 3001 3002 4000",
    "db:census-academic-calendar": "pnpm --filter @school-kit/db census-academic-calendar",
    "db:census-paystack-splits": "pnpm --filter @school-kit/db census-paystack-splits",
    "api:backfill-paystack-splits": "pnpm --filter @school-kit/api backfill-paystack-splits"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
